---
title: Only the gateway opens the row
---
flowchart TB

  subgraph AG[Agent]
    direction TB
    user["User<br>subject token"]
    agentN["Agent<br>no upstream token"]
    user --> agentN
  end

  subgraph EG[Egress]
    gw["Gateway<br>opens the row"]
  end

  subgraph CP[Control plane]
    direction TB
    ctrl["Controller<br>ciphertext only"]
    store["Token store<br>access-token row"]
    residual["residual: ciphertext"]
    ctrl --- store
    store --- residual
  end

  subgraph AU[Authorizer]
    brk["Broker<br>returns a key"]
  end

  subgraph KM[Key management]
    kms["KMS / OpenBao<br>wrapping key"]
  end

  subgraph RD[Refresher domain]
    ref["Refresher<br>refresh tokens"]
  end

  subgraph UP[Upstream]
    up["Upstream API<br>receives the token"]
  end

  subgraph ID[Identity]
    idp["Identity provider<br>verifies the user"]
  end

  agentN -->|"1. request"| gw
  gw -->|"2. ciphertext"| ctrl
  ctrl --- store
  gw -->|"3. wrapped key"| brk
  brk -->|"4. decrypt"| kms
  kms -.->|"data key"| brk
  brk -->|"5. data key"| gw
  gw -->|"6. access token"| up
  idp -.->|"JWKS"| brk
  ref -.->|"new row"| store

  class gw,up plaintext
  class ctrl,store,ref cipher
  class residual note

  classDef plaintext fill:#fff1f3,stroke:#ff8fa3,color:#121a24
  classDef cipher fill:#f0f4f8,stroke:#9fb0be,color:#121a24
  classDef note fill:#eceff2,stroke:#c5d0d8,color:#5b6878
  classDef risk fill:#fff1f3,stroke:#ff8fa3,color:#c92a4f

