---
title: The broker approves one row
---
flowchart TB

  subgraph AG[Agent]
    direction TB
    user["User<br>subject token"]
    agentN["Agent<br>no upstream token"]
    user --> agentN
  end

  subgraph EG[Egress]
    gw["Gateway<br>freshness proof"]
  end

  subgraph CP[Control plane]
    direction TB
    ctrl["Controller<br>proposes decrypt"]
    store["Token store<br>one named row"]
    ctrl --- store
  end

  subgraph KC[Key custodian]
    direction TB
    bao["OpenBao<br>holds the request"]
    cue["no standing decrypt"]
    bao --- cue
  end

  subgraph AU[Authorizer]
    brk["Broker<br>one-row approve"]
  end

  subgraph UP[Upstream]
    up["Upstream API<br>receives the token"]
  end

  subgraph ID[Identity]
    idp["Identity provider<br>verifies the user"]
  end

  agentN -->|"1. request"| gw
  gw -->|"2. exchange"| ctrl
  ctrl -->|"3. decrypt request"| bao
  bao -->|"4. held request"| brk
  brk -->|"5. approve"| bao
  bao -->|"data key"| ctrl
  ctrl -->|"6. access token"| gw
  gw -->|"7. access token"| up
  idp -.->|"JWKS"| brk

  class up plaintext
  class store cipher
  class cue note

  classDef plaintext fill:#fff1f3,stroke:#ff8fa3,color:#121a24
  classDef cipher fill:#f0f4f8,stroke:#9fb0be,color:#121a24
  classDef note fill:#eceff2,stroke:#c5d0d8,color:#5b6878
  classDef risk fill:#fff1f3,stroke:#ff8fa3,color:#c92a4f

