---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';
import { Marked } from 'marked';
import { markedHighlight } from 'marked-highlight';
import hljs from 'highlight.js';
import { readingMinutes } from '../../../data/blog';
import { getRelatedPosts } from '../../../data/home';
import RelatedPosts from '../../../components/RelatedPosts.astro';

import data from '../../../data/es.json';

const marked = new Marked(
  markedHighlight({
    langPrefix: 'hljs language-',
    highlight(code, lang) {
      const language = hljs.getLanguage(lang) ? lang : 'plaintext';
      return hljs.highlight(code, { language }).value;
    },
  })
);

export function getStaticPaths() {
  const blogDir = path.join(process.cwd(), 'src', 'content', 'blog', 'es');
  if (!fs.existsSync(blogDir)) return [];
  const files = fs.readdirSync(blogDir).filter((f: string) => f.endsWith('.md'));
  return files.map((file: string) => ({
    params: { slug: file.replace('.md', '') },
  }));
}

const { slug } = Astro.params;
const filePath = path.join(process.cwd(), 'src', 'content', 'blog', 'es', `${slug}.md`);
const content = fs.readFileSync(filePath, 'utf-8');

const frontmatterMatch = content.match(/^---\n([\s\S]*?)\n---/);
const frontmatter = frontmatterMatch?.[1] || '';
const title = frontmatter.match(/title:\s*"(.+)"/)?.[1] || '';
const date = frontmatter.match(/date:\s*"(.+)"/)?.[1] || '';
const description = frontmatter.match(/description:\s*"(.+)"/)?.[1] || title;
const image = frontmatter.match(/image:\s*"(.+)"/)?.[1];
const translation = frontmatter.match(/translation:\s*"(.+)"/)?.[1];
const alternate = translation ? `/en/blog/${translation}/` : undefined;

const markdownBody = content.replace(/^---\n[\s\S]*?\n---\n/, '');

const slugify = (s: string) =>
  s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');

const headingIds = new Map<string, number>();
const headings: { id: string; text: string; depth: number }[] = [];
let htmlContent = await marked.parse(markdownBody);
htmlContent = htmlContent.replace(/<img /g, '<img loading="lazy" decoding="async" ');
htmlContent = htmlContent.replace(/<h([23])>([\s\S]*?)<\/h\1>/g, (_, level, inner) => {
  const text = inner
    .replace(/<[^>]*>/g, '')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
  const base = slugify(text) || 'section';
  const count = headingIds.get(base) ?? 0;
  headingIds.set(base, count + 1);
  const id = count ? `${base}-${count + 1}` : base;
  headings.push({ id, text, depth: Number(level) });
  return `<h${level} id="${id}">${inner}</h${level}>`;
});
const minutes = readingMinutes(markdownBody);

const lang = 'es';
const relatedPosts = getRelatedPosts(lang, slug ?? '');
---

<Layout
  title={`${title} - Leon Elliott Fuller`}
  description={description}
  lang={lang}
  image={image}
  type="article"
  alternate={alternate}
>
  <Nav nav={data.nav} lang={lang} />
  <main class="blog-article-shell">
    <article class="blog-article">
      <a href={`/${lang}/#blog`} class="blog-back">← Volver al blog</a>
      <header class:list={['blog-article-header', image && 'blog-article-header-with-cover']}>
        <div class="blog-header-copy">
          <h1>{title}</h1>
          <p class="blog-deck">{description}</p>
          <div class="blog-article-meta">
            <time datetime={date}
              >{
                new Intl.DateTimeFormat('es-ES', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                  timeZone: 'UTC',
                }).format(new Date(`${date}T00:00:00Z`))
              }</time
            >
            <span aria-hidden="true">·</span><span>{minutes} min de lectura</span>
            <button
              type="button"
              class="blog-copy-link"
              data-copy-link
              data-copy-label="Copiar enlace"
              data-copied-label="Enlace copiado"
              data-failed-label="No se pudo copiar; selecciona la dirección en el navegador"
              >Copiar enlace</button
            >
            <span class="blog-copy-status" role="status" aria-live="polite"></span>
          </div>
        </div>
        {
          image && (
            <img
              class="blog-hero-image"
              src={image}
              alt=""
              width="1200"
              height="630"
              fetchpriority="high"
            />
          )
        }
      </header>
      <div class="blog-reading-layout">
        <div class="prose-blog"><Fragment set:html={htmlContent} /></div>
        {
          headings.length > 0 && (
            <aside class="blog-toc" aria-label="En esta página">
              <details open class="blog-toc-details">
                <summary>En esta página</summary>
                <nav aria-label="En esta página">
                  <ol>
                    {headings.map((heading) => (
                      <li class:list={[heading.depth === 3 && 'blog-toc-sub']}>
                        <a href={`#${heading.id}`}>{heading.text}</a>
                      </li>
                    ))}
                  </ol>
                </nav>
              </details>
            </aside>
          )
        }
      </div>
      <RelatedPosts posts={relatedPosts} lang={lang} />
    </article>
  </main>
  <script is:inline>
    const mobileContents = document.querySelector('.blog-toc-details');
    if (mobileContents) {
      const smallScreen = window.matchMedia('(max-width: 900px)');
      mobileContents.open = !smallScreen.matches;
      smallScreen.addEventListener('change', (event) => {
        mobileContents.open = !event.matches;
      });
    }
    const share = document.querySelector('[data-copy-link]');
    share?.addEventListener('click', async () => {
      const status = document.querySelector('.blog-copy-status');
      try {
        await navigator.clipboard.writeText(window.location.href);
        share.textContent = share.dataset.copiedLabel;
        status.textContent = share.dataset.copiedLabel;
        setTimeout(() => {
          share.textContent = share.dataset.copyLabel;
          status.textContent = '';
        }, 2200);
      } catch {
        status.textContent = share.dataset.failedLabel;
      }
    });
    const sectionLinks = [...document.querySelectorAll('.blog-toc a')];
    if ('IntersectionObserver' in window && sectionLinks.length) {
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          const current = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (!current) return;
          sectionLinks.forEach((link) => {
            if (link.getAttribute('href') === `#${current.target.id}`)
              link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        },
        { rootMargin: '-100px 0px -65% 0px', threshold: 0 }
      );
      sectionLinks.forEach((link) => {
        const section = document.getElementById(link.getAttribute('href').slice(1));
        if (section) sectionObserver.observe(section);
      });
    }
  </script>
  <Footer footer={data.footer} contact={data.contact} nav={data.nav} lang={lang} />
  <button id="back-to-top" class="back-to-top" aria-label="Volver arriba">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
      ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 15l7-7 7 7"
      ></path></svg
    >
  </button>
  <script is:inline>
    // Lightbox for linked images inside the post body
    document.querySelectorAll('.prose-blog a').forEach((a) => {
      const img = a.querySelector('img');
      if (!img) return;
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const overlay = document.createElement('div');
        overlay.style.cssText =
          'position:fixed;inset:0;z-index:100;background:rgba(10,12,16,.88);display:flex;align-items:center;justify-content:center;padding:2rem;cursor:zoom-out;';
        const big = document.createElement('img');
        big.src = a.href;
        big.alt = img.alt || '';
        big.style.cssText =
          'max-width:100%;max-height:100%;border-radius:12px;background:#fff;padding:12px;object-fit:contain;';
        overlay.appendChild(big);
        const close = () => {
          overlay.remove();
          document.removeEventListener('keydown', onKey);
        };
        const onKey = (ev) => {
          if (ev.key === 'Escape') close();
        };
        overlay.addEventListener('click', close);
        document.addEventListener('keydown', onKey);
        document.body.appendChild(overlay);
      });
    });

    // Code blocks: language label + copy
    const copyIcon =
      '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3"/></svg>';
    const checkIcon =
      '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>';
    document.querySelectorAll('.prose-blog pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      pre.parentNode.insertBefore(wrap, pre);

      const header = document.createElement('div');
      header.className = 'code-block-header';

      const codeEl = pre.querySelector('code');
      const langMatch = codeEl?.className.match(/language-([\w-]+)/);
      const lang = langMatch ? langMatch[1] : 'text';

      const langLabel = document.createElement('span');
      langLabel.className = 'code-block-lang';
      langLabel.textContent = lang;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.setAttribute('aria-label', 'Copiar código');
      btn.innerHTML = `${copyIcon}<span>Copiar</span>`;

      const getCodeText = () => {
        const source = codeEl || pre;
        return source.textContent.replace(/\n$/, '');
      };

      btn.addEventListener('click', async () => {
        const text = getCodeText();
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const range = document.createRange();
          range.selectNodeContents(codeEl || pre);
          const selection = window.getSelection();
          selection.removeAllRanges();
          selection.addRange(range);
          return;
        }
        btn.classList.add('copied');
        btn.innerHTML = `${checkIcon}<span>Copiado</span>`;
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = `${copyIcon}<span>Copiar</span>`;
        }, 1500);
      });

      header.appendChild(langLabel);
      header.appendChild(btn);
      wrap.appendChild(header);
      wrap.appendChild(pre);
    });

    // Back to top
    const toTop = document.getElementById('back-to-top');
    window.addEventListener(
      'scroll',
      () => toTop.classList.toggle('visible', window.scrollY > 600),
      { passive: true }
    );
    toTop.addEventListener('click', () =>
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      })
    );
  </script>
</Layout>
