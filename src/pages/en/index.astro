---
import Layout from '../../layouts/Layout.astro';
import Home from '../../components/Home.astro';
import { getPosts } from '../../data/home';

import data from '../../data/en.json';

const lang = 'en';
---

<Layout title={data.meta.title} description={data.meta.description} lang={lang}>
  <Home data={data} posts={getPosts(lang)} lang={lang} />
</Layout>
