---
import Layout from '../../layouts/Layout.astro';
import SiteControls from '../../components/SiteControls.astro';
import SiteIcon from '../../components/SiteIcon.astro';
const options = [
  {
    id: 'warm',
    number: '01',
    name: 'Warm & understated',
    description:
      'The original sand palette. A compact header, quiet typography, and a simple, organised footer.',
  },
  {
    id: 'playful',
    number: '02',
    name: 'Playful & grounded',
    description:
      'Apricot, mustard, and expressive type. A friendly personality with straight edges and no waves.',
  },
  {
    id: 'mono',
    number: '03',
    name: 'Editorial & monochrome',
    description:
      'A strong wordmark, fine rules, and a dark footer. The most stripped-back direction.',
  },
];
---

<Layout
  title="Portfolio design directions"
  description="Compare three header and footer styles, full-screen sections, and interaction sounds."
  lang="en"
  noindex
>
  <div class="design-comparison">
    <header class="comparison-top">
      <a href="/en/">Leon Fuller / Design studio</a><div class="site-chrome">
        <SiteControls lang="en" />
      </div>
    </header>
    <main>
      <section class="comparison-intro">
        <p class="comparison-eyebrow">Three directions. Same portfolio.</p><h1>
          Find the right feel.
        </h1><p>
          Compare the headers and footers below, then open a full portfolio preview. Every direction
          includes the flag switch, sound controls, and a header that blends in as you scroll.
        </p>
      </section>
      <section class="comparison-settings" aria-label="Preview controls">
        <div>
          <h2>Page layout</h2><div
            class="comparison-layout"
            role="group"
            aria-label="Choose preview layout"
          >
            <button type="button" data-layout-choice="fullscreen" aria-pressed="true"
              >Full-screen sections</button
            ><button type="button" data-layout-choice="photo" aria-pressed="false"
              >Current photo layout</button
            >
          </div><p data-layout-description>
            No background image. Each section fills the viewport; longer sections flow naturally.
          </p>
        </div>
        <div>
          <h2>Try the sounds</h2><div class="comparison-sounds">
            <button type="button" data-sound-preview="hover"
              ><SiteIcon name="sound" />Buttons</button
            ><button type="button" data-sound-preview="link"
              ><SiteIcon name="external" />Links</button
            >
            <button type="button" data-sound-preview="skill"><SiteIcon name="sound" />Skills</button
            ><button type="button" data-sound-preview="certificate"
              ><SiteIcon name="sound" />Certificates</button
            >
          </div><p>
            Click to listen. Links have a light two-note sound, skills a pluck, and certificates a
            soft chime.
          </p><p
            class="comparison-sound-status"
            role="status"
            aria-live="polite"
            data-sound-demo-status
          >
          </p>
        </div>
      </section>
      <nav class="comparison-jump" aria-label="Design directions">
        {
          options.map((option) => (
            <a href={`#${option.id}`}>
              {option.number}
              <span>{option.name}</span>
              <SiteIcon name="arrow" />
            </a>
          ))
        }
      </nav>
      <div class="comparison-options">
        {
          options.map((option) => (
            <section
              class="comparison-option"
              id={option.id}
              aria-labelledby={`${option.id}-title`}
            >
              <>
                <header>
                  <>
                    <div>
                      <>
                        <p class="comparison-eyebrow">Direction {option.number}</p>
                        <h2 id={`${option.id}-title`}>{option.name}</h2>
                        <p>{option.description}</p>
                      </>
                    </div>
                    <a
                      href={`/en/?style=${option.id}&layout=fullscreen`}
                      target="_blank"
                      rel="noopener"
                      data-full-preview={option.id}
                    >
                      Open full portfolio
                      <SiteIcon name="external" />
                    </a>
                  </>
                </header>
                <iframe
                  src={`/design-preview/${option.id}/?layout=fullscreen`}
                  title={`${option.name} interactive header and footer`}
                  loading="lazy"
                  data-preview-frame={option.id}
                />
              </>
            </section>
          ))
        }
      </div>
      <p class="comparison-note">
        These are working previews. Try the menus, flags, sound and theme controls. No style has
        been selected for the main site yet.
      </p>
    </main>
  </div>
  <script>
    const choices = document.querySelectorAll<HTMLButtonElement>('[data-layout-choice]');
    choices.forEach((button) =>
      button.addEventListener('click', () => {
        const fullscreen = button.dataset.layoutChoice === 'fullscreen';
        choices.forEach((choice) => choice.setAttribute('aria-pressed', String(choice === button)));
        document.querySelectorAll<HTMLAnchorElement>('[data-full-preview]').forEach((link) => {
          link.href = `/en/?style=${link.dataset.fullPreview}${fullscreen ? '&layout=fullscreen' : ''}`;
        });
        document.querySelectorAll<HTMLIFrameElement>('[data-preview-frame]').forEach((frame) => {
          frame.src = `/design-preview/${frame.dataset.previewFrame}/?layout=${fullscreen ? 'fullscreen' : 'photo'}`;
        });
        const description = document.querySelector('[data-layout-description]');
        if (description)
          description.textContent = fullscreen
            ? 'No background image. Each section fills the viewport; longer sections flow naturally.'
            : 'The existing photo backdrop and floating content panels.';
      })
    );
    document.querySelectorAll<HTMLButtonElement>('[data-sound-preview]').forEach((button) =>
      button.addEventListener('click', () => {
        const status = document.querySelector('[data-sound-demo-status]');
        if (status)
          status.textContent =
            document.documentElement.dataset.sound === 'off'
              ? 'Sounds are muted. Use the speaker icon above to enable them.'
              : `${button.textContent?.trim()} sound`;
      })
    );
    // Each frame reports its real height as controls and responsive layouts change.
    window.addEventListener('message', (event) => {
      if (event.origin !== location.origin || event.data?.type !== 'chrome-preview-size') return;
      const frame = [...document.querySelectorAll<HTMLIFrameElement>('[data-preview-frame]')].find(
        (frame) => frame.contentWindow === event.source
      );
      if (frame && typeof event.data.height === 'number')
        frame.style.height = `${Math.max(420, Math.min(1200, event.data.height + 2))}px`;
    });
  </script>
</Layout>
<style is:global>
  .design-comparison {
    --compare-bg: #f8f7f4;
    --compare-surface: #fff;
    --compare-text: #292826;
    --compare-muted: #706d67;
    --compare-border: #dfdcd5;
    color: var(--compare-text);
    background: var(--compare-bg);
    min-height: 100vh;
  }
  .dark .design-comparison {
    --compare-bg: #191919;
    --compare-surface: #222;
    --compare-text: #eeeae1;
    --compare-muted: #aaa49b;
    --compare-border: #3d3a36;
  }
  .comparison-top,
  .design-comparison main {
    width: min(1280px, calc(100% - 64px));
    margin-inline: auto;
  }
  .comparison-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 20px;
    border-bottom: 1px solid var(--compare-border);
  }
  .comparison-top > a {
    font-size: 14px;
    font-weight: 700;
  }
  .comparison-top .site-chrome {
    --chrome-text: var(--compare-text);
    --chrome-muted: var(--compare-muted);
    --chrome-brand: var(--compare-text);
    --chrome-hover: var(--compare-border);
  }
  .comparison-intro {
    padding: 56px 0 32px;
    max-width: 760px;
  }
  .comparison-eyebrow {
    font-size: 12px;
    color: var(--compare-muted);
    margin-bottom: 8px;
  }
  .comparison-intro h1 {
    font-size: 44px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -1.5px;
    margin-bottom: 16px;
  }
  .comparison-intro > p:last-child {
    font-size: 15px;
    color: var(--compare-muted);
    line-height: 1.8;
  }
  .comparison-settings {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 24px 0;
    border-block: 1px solid var(--compare-border);
  }
  .comparison-settings h2 {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .comparison-settings p {
    color: var(--compare-muted);
    font-size: 12px;
    margin-top: 10px;
    line-height: 1.6;
  }
  .comparison-settings .comparison-sound-status {
    min-height: 18px;
  }
  .comparison-layout,
  .comparison-sounds {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .comparison-layout button,
  .comparison-sounds button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    min-height: 36px;
    font-size: 12px;
    border: 1px solid var(--compare-border);
    border-radius: 6px;
    background: var(--compare-surface);
    cursor: pointer;
  }
  .comparison-layout button[aria-pressed='true'] {
    background: var(--compare-text);
    border-color: var(--compare-text);
    color: var(--compare-bg);
  }
  .comparison-sounds button:hover {
    border-color: var(--compare-text);
  }
  .comparison-sounds .site-icon {
    width: 14px;
    height: 14px;
  }
  .comparison-jump {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    padding-block: 24px;
    font-size: 12px;
  }
  .comparison-jump a {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--compare-muted);
  }
  .comparison-jump a span {
    color: var(--compare-text);
  }
  .comparison-jump .site-icon {
    width: 13px;
    height: 13px;
  }
  .comparison-options {
    display: grid;
    gap: 48px;
    padding-top: 16px;
  }
  .comparison-option {
    scroll-margin-top: 24px;
  }
  .comparison-option > header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-bottom: 20px;
  }
  .comparison-option h2 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.6px;
  }
  .comparison-option > header > div > p:last-child {
    font-size: 13px;
    color: var(--compare-muted);
    margin-top: 8px;
    line-height: 1.6;
  }
  .comparison-option > header > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--compare-border);
    border-radius: 6px;
    background: var(--compare-surface);
    padding: 10px 14px;
    font-size: 12px;
    white-space: nowrap;
  }
  .comparison-option > header > a:hover {
    border-color: var(--compare-text);
  }
  .comparison-option > header > a .site-icon {
    width: 14px;
    height: 14px;
  }
  .comparison-option iframe {
    display: block;
    width: 100%;
    height: 600px;
    border: 1px solid var(--compare-border);
    border-radius: 8px;
    background: #fff;
  }
  .comparison-note {
    color: var(--compare-muted);
    font-size: 12px;
    padding: 32px 0 48px;
  }
  .design-comparison :is(a, button):focus-visible {
    outline: 2px solid var(--compare-text);
    outline-offset: 4px;
  }
  @media (max-width: 700px) {
    .comparison-top,
    .design-comparison main {
      width: calc(100% - 32px);
    }
    .comparison-intro {
      padding-top: 32px;
    }
    .comparison-intro h1 {
      font-size: 34px;
    }
    .comparison-settings {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .comparison-option > header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .comparison-option h2 {
      font-size: 23px;
    }
    .comparison-jump {
      gap: 12px 20px;
    }
  }
</style>
