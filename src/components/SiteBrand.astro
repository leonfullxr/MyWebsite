---
interface Props {
  lang: string;
  home?: boolean;
}
const { lang, home = false } = Astro.props;
---

<a
  class="site-brand"
  href={home ? '#top' : `/${lang}/`}
  aria-label="Leon Elliott Fuller"
  data-ui-sound
>
  <span class="site-avatar" aria-hidden="true"
    ><img src="/images/mascot/head.webp" alt="" width="40" height="40" /></span
  >
  <span class="site-wordmark" aria-hidden="true"
    ><span class="kw">return</span> leon<span class="semi">;</span></span
  >
</a>
