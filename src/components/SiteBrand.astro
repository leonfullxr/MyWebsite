---
interface Props {
  lang: string;
  home?: boolean;
}
const { lang, home = false } = Astro.props;
---

<a
  class="site-brand"
  href={home ? '#' : `/${lang}/`}
  aria-label="Leon Elliott Fuller"
  data-ui-sound
>
  <span aria-hidden="true">Leon</span><span class="site-brand-initial" aria-hidden="true">E.</span
  ><span aria-hidden="true">Fuller</span>
</a>
