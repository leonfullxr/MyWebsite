---
interface Props {
  language: string;
}
const { language } = Astro.props;
---

<svg class="site-flag" viewBox="0 0 20 20" aria-hidden="true">
  {
    language === 'es' ? (
      <>
        <path fill="#AA151B" d="M0 0h20v20H0z" />
        <path fill="#F1BF00" d="M0 5h20v10H0z" />
        <path fill="#AA151B" d="M4.5 8h3v3a1.5 1.5 0 0 1-3 0z" />
      </>
    ) : (
      <>
        <path fill="#012169" d="M0 0h20v20H0z" />
        <path stroke="#fff" stroke-width="4" d="m-4 0 28 20M24 0-4 20" />
        <path stroke="#C8102E" stroke-width="1.5" d="m-4 0 28 20M24 0-4 20" />
        <path stroke="#fff" stroke-width="6" d="M10 0v20M0 10h20" />
        <path stroke="#C8102E" stroke-width="3.5" d="M10 0v20M0 10h20" />
      </>
    )
  }
</svg>
