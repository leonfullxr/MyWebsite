---
import SiteControls from './SiteControls.astro';
import SiteIcon from './SiteIcon.astro';
interface Props {
  footer: { copyright: string };
  contact: { email: string; github: string; linkedin: string };
  lang?: string;
  home?: boolean;
  nav?: {
    about: string;
    cv: string;
    skills?: string;
    projects: string;
    thesis: string;
    blog: string;
  };
}
const { footer, contact, lang = 'en', home = false, nav } = Astro.props;
const es = lang === 'es';
const year = new Date().getFullYear();
const anchor = (id: string) => (home ? `#${id}` : `/${lang}/#${id}`);
const labels = nav ?? {
  about: es ? 'Sobre mí' : 'About',
  cv: es ? 'Experiencia' : 'Experience',
  skills: es ? 'Habilidades' : 'Skills',
  projects: es ? 'Proyectos' : 'Projects',
  thesis: es ? 'TFG' : 'Thesis',
  blog: 'Blog',
};
const t = es
  ? {
      cta: 'Construyamos algo.',
      navigate: 'Navega',
      now: 'Ahora mismo',
      nowItems: [
        'Ingeniero de seguridad en Wazuh',
        'Vivo en Granada, España',
        'Corriendo ultras por diversión',
      ],
      top: 'Volver arriba',
      built: 'Hecho con Astro',
    }
  : {
      cta: "Let's build something.",
      navigate: 'Navigate',
      now: 'Right now',
      nowItems: ['Security engineer at Wazuh', 'Based in Granada, Spain', 'Running ultras for fun'],
      top: 'Back to top',
      built: 'Built with Astro',
    };
---

<footer class="site-chrome site-footer">
  <div class="site-footer-scene">
    <div class="site-footer-art-wrap">
      <picture>
        <source media="(max-width: 900px)" srcset="/images/scenes/glow-ridge-1280.webp" />
        <img
          class="site-footer-art"
          src="/images/scenes/glow-ridge.webp"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </picture>
      <button type="button" class="site-footer-perch" data-perch aria-label={t.top} data-ui-sound>
        <img class="perch-rest" src="/images/mascot/reclining.webp" alt="" loading="lazy" />
        <img class="perch-jump" src="/images/mascot/jumping.webp" alt="" loading="lazy" />
      </button>
    </div>
    <div class="site-footer-head" data-reveal-footer>
      <p class="site-footer-cta">{t.cta}</p>
      <a class="site-footer-mail" href={`mailto:${contact.email}`} data-ui-sound>{contact.email}</a>
    </div>
  </div>
  <div class="site-footer-inner">
    <div class="site-footer-cols">
      <nav aria-label={t.navigate}>
        <h2>{t.navigate}</h2>
        <a href={anchor('about')} data-ui-sound>{labels.about}</a>
        <a href={anchor('cv')} data-ui-sound>{labels.cv}</a>
        <a href={anchor('projects')} data-ui-sound>{labels.projects}</a>
        <a href={`/${lang}/thesis`} data-ui-sound>{labels.thesis}</a>
        <a href={anchor('blog')} data-ui-sound>{labels.blog}</a>
      </nav>
      <div>
        <h2>{t.now}</h2>
        {t.nowItems.map((item) => <p>{item}</p>)}
      </div>
      <a href="#top" class="site-back-top" data-back-top data-ui-sound>
        {t.top}<SiteIcon name="up" />
      </a>
    </div>
    <div class="site-footer-bottom">
      <p>© {year} {footer.copyright} · {t.built}</p>
      <SiteControls lang={lang} compact>
        <Fragment slot="links">
          <a
            class="site-icon-button"
            href={contact.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={es ? 'Visitar GitHub' : 'Visit GitHub'}
            title="GitHub"
            data-ui-sound><SiteIcon name="github" /></a
          >
          <a
            class="site-icon-button"
            href={contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={es ? 'Visitar LinkedIn' : 'Visit LinkedIn'}
            title="LinkedIn"
            data-ui-sound><SiteIcon name="linkedin" /></a
          >
          <a
            class="site-icon-button site-rss"
            href={`/${lang}/blog/rss.xml`}
            aria-label={es ? 'Suscribirse por RSS' : 'Subscribe via RSS'}
            title="RSS"
            data-ui-sound><SiteIcon name="rss" /></a
          >
        </Fragment>
      </SiteControls>
      <span class="site-wordmark" aria-hidden="true"
        ><span class="kw">return</span> leon<span class="semi">;</span></span
      >
    </div>
  </div>
</footer>
<script>
  // Back to top: the mascot on the summit hops before the page scrolls up.
  const perch = document.querySelector<HTMLElement>('[data-perch]');
  const hop = () => {
    if (!perch) return;
    perch.classList.remove('is-hopping');
    void perch.offsetWidth;
    perch.classList.add('is-hopping');
    window.setTimeout(() => perch.classList.remove('is-hopping'), 900);
  };
  const toTop = (event: Event) => {
    event.preventDefault();
    hop();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.setTimeout(
      () => window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' }),
      reduce ? 0 : 380
    );
  };
  perch?.addEventListener('click', toTop);
  document.querySelector('[data-back-top]')?.addEventListener('click', toTop);
  const head = document.querySelector('[data-reveal-footer]');
  if (head && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          head.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.3 }
    );
    io.observe(head);
  } else head?.classList.add('is-in');
</script>
