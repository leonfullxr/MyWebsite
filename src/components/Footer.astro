---
import SiteBrand from './SiteBrand.astro';
import SiteControls from './SiteControls.astro';
import SiteIcon from './SiteIcon.astro';
import { icons } from '../data/home';
interface Props {
  footer: { copyright: string };
  contact: { email: string; github: string; linkedin: string };
  lang?: string;
  home?: boolean;
  nav?: {
    about: string;
    cv: string;
    skills?: string;
    projects: string;
    thesis: string;
    blog: string;
  };
}
const { footer, contact, lang = 'en', home = false, nav } = Astro.props;
const es = lang === 'es';
const year = new Date().getFullYear();
const anchor = (id: string) => (home ? `#${id}` : `/${lang}/#${id}`);
const labels = nav ?? {
  about: es ? 'Sobre mí' : 'About',
  cv: es ? 'Experiencia' : 'Experience',
  projects: es ? 'Proyectos' : 'Projects',
  thesis: es ? 'TFG' : 'Thesis',
  blog: 'Blog',
};
---

<footer class="site-chrome site-footer">
  <svg class="site-footer-wave" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true"
    ><path
      class="footer-wave-back"
      d="M0 56C140 92 210 7 340 35S580 112 720 65 960 2 1110 40 1300 90 1440 26V140H0Z"></path><path
      class="footer-wave-front"
      d="M0 94C170 135 240 43 390 76S600 132 790 94 1010 57 1170 101 1350 82 1440 65V140H0Z"
    ></path></svg
  >
  <div class="site-footer-inner">
    <div class="site-footer-main">
      <div class="site-footer-intro">
        <SiteBrand lang={lang} home={home} />
        <p class="site-footer-farewell">
          {es ? 'Gracias por pasarte.' : 'Thanks for stopping by.'}<span aria-hidden="true">✳</span>
        </p>
      </div>
      <nav class="site-footer-links" aria-label={es ? 'Explora' : 'Explore'}>
        <h2>{es ? 'Explora' : 'Explore'}</h2><a href={anchor('about')} data-ui-sound
          >{labels.about}</a
        ><a href={anchor('cv')} data-ui-sound>{labels.cv}</a><a
          href={anchor('skills')}
          data-ui-sound>{es ? 'Habilidades' : 'Skills'}</a
        >
      </nav>
      <nav class="site-footer-links" aria-label={es ? 'Lo que hago' : 'Things I make'}>
        <h2>{es ? 'Lo que hago' : 'Things I make'}</h2><a href={anchor('projects')} data-ui-sound
          >{labels.projects}</a
        ><a href={`/${lang}/thesis`} data-ui-sound>{labels.thesis}<SiteIcon name="external" /></a><a
          href={anchor('blog')}
          data-ui-sound>{labels.blog}</a
        >
      </nav>
    </div>
    <div class="site-footer-bottom">
      <p>© {year} {footer.copyright}</p>
      <div class="site-footer-actions">
        <div
          class="site-footer-socials"
          aria-label={es ? 'Perfiles y contacto' : 'Profiles and contact'}
        >
          <a
            class="site-footer-social-link site-icon-button"
            href={contact.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            title="GitHub"
            data-ui-sound
            ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path d={icons.github}></path></svg
            ></a
          >
          <a
            class="site-footer-social-link site-icon-button"
            href={contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
            data-ui-sound
            ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path d={icons.linkedin}></path></svg
            ></a
          >
          <a
            class="site-footer-social-link site-icon-button"
            href={`mailto:${contact.email}`}
            aria-label={`${es ? 'Correo electrónico' : 'Email'}: ${contact.email}`}
            title={contact.email}
            data-ui-sound><SiteIcon name="mail" /></a
          >
        </div>
        <SiteControls lang={lang} />
      </div>
      <a href="#top" class="site-back-top" data-ui-sound
        >{es ? 'Volver arriba' : 'Back to top'}<SiteIcon name="up" /></a
      >
    </div>
  </div>
</footer>
