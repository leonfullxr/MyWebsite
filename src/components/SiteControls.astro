---
import SiteIcon from './SiteIcon.astro';
import SiteFlag from './SiteFlag.astro';
interface Props {
  lang: string;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const es = lang === 'es';
// Pages that exist in both languages keep you on the same page when you switch.
const page = Astro.url.pathname.replace(/^\/(en|es)\/?/, '').replace(/\/$/, '');
const same = ['about', 'legal', 'thesis'].includes(page) ? page : '';
---

<div class="site-controls">
  <slot name="links" />
  {
    !compact && (
      <button
        type="button"
        class="site-icon-button"
        data-sound-toggle
        aria-pressed="false"
        aria-label={es ? 'Silenciar sonidos' : 'Mute sounds'}
        title={es ? 'Silenciar sonidos' : 'Mute sounds'}
      >
        <SiteIcon name="sound" class="sound-on" />
        <SiteIcon name="muted" class="sound-off" />
      </button>
    )
  }
  <button
    type="button"
    class="site-icon-button site-theme"
    data-theme-toggle
    data-ui-sound
    aria-label={es ? 'Cambiar tema' : 'Toggle theme'}
    title={es ? 'Cambiar tema' : 'Toggle theme'}
  >
    <SiteIcon name="moon" class="theme-moon" /><SiteIcon name="sun" class="theme-sun" />
  </button>
  {
    !compact && (
      <a
        class="site-icon-button site-rss"
        href={`/${lang}/blog/rss.xml`}
        aria-label={es ? 'Suscribirse por RSS' : 'Subscribe via RSS'}
        title="RSS"
        data-ui-sound
      >
        <SiteIcon name="rss" />
      </a>
    )
  }
  <div class="site-language" role="group" aria-label={es ? 'Idioma' : 'Language'}>
    <a
      href={`/en/${same}`}
      lang="en"
      hreflang="en"
      aria-current={es ? undefined : 'true'}
      aria-label="English"
      title="English"
      data-ui-sound><SiteFlag language="en" /></a
    ><a
      href={`/es/${same}`}
      lang="es"
      hreflang="es"
      aria-current={es ? 'true' : undefined}
      aria-label="Español"
      title="Español"
      data-ui-sound><SiteFlag language="es" /></a
    >
  </div>
</div>
<script>
  import '../scripts/site-controls';
</script>
