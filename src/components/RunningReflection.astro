---
import reflection from '../data/running-reflection.json';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const content = reflection[lang === 'es' ? 'es' : 'en'];
---

<section class="running-reflection" id="why-i-run" aria-labelledby="running-reflection-title">
  <div class="reflection-inner">
    <header class="reflection-header">
      <p class="reflection-label">{content.label}</p>
      <h2 id="running-reflection-title">{content.title}</h2>
    </header>
    <div class="reflection-content">
      <p class="reflection-lead">{content.lead}</p>
      {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p class="reflection-sources">
        {content.sourceLabel}{' '}
        {
          content.sources.map((source, index) => (
            <>
              {index > 0 && (lang === 'es' ? ' y ' : ' and ')}
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.title}
              </a>
            </>
          ))
        }.
      </p>
    </div>
  </div>
</section>

<style>
  .running-reflection {
    margin-top: 5rem;
    padding: 3rem 1.25rem 0;
    border-top: 1px solid color-mix(in srgb, var(--muted) 28%, transparent);
    color: var(--soft-text);
  }

  .reflection-inner {
    width: min(100%, 56rem);
    margin-inline: auto;
    font-size: 1.05rem;
  }

  .reflection-header,
  .reflection-content {
    width: min(100%, 65ch);
    margin-inline: auto;
  }

  .reflection-label {
    margin: 0 0 0.6rem;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 900;
  }

  h2 {
    margin: 0;
    color: var(--soft-text);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    line-height: 1.12;
    text-wrap: balance;
  }

  .reflection-content {
    margin-top: 1.75rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .reflection-content p {
    margin: 0 0 1.2em;
  }

  .reflection-content .reflection-lead {
    color: var(--soft-text);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .reflection-content .reflection-sources {
    margin-top: 2rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .reflection-sources a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .reflection-sources a:focus-visible {
    border-radius: 2px;
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
