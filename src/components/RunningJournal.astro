---
import reflection from '../data/running-reflection.json';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const content = reflection[lang === 'es' ? 'es' : 'en'];
---

<article class="tile t-journal" id="journal-preview">
  <div>
    <h3>{content.title}</h3>
    <p>{content.lead}</p>
    <a href="#why-i-run">{content.journalLink}&nbsp;→</a>
  </div>
  <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <path
      d="M20 92 C-5 35 65 5 93 34 C125 66 75 121 42 84 C15 54 70 33 83 61 C95 87 56 95 57 72"
      stroke="currentColor"
      stroke-width="2"
      stroke-dasharray="4 6"></path>
    <circle cx="20" cy="92" r="5" fill="currentColor"></circle>
    <path d="M57 72V50l16 6-16 6" stroke="currentColor" stroke-width="2"></path>
  </svg>
</article>

<style>
  .t-journal {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7rem;
    gap: 1.5rem;
    text-align: left;
    align-items: center;
    padding: 2rem;
    margin-block: 0.75rem;
    background: var(--color-sand-100);
    border: 1px solid var(--color-sand-300);
    border-left: 0.35rem solid var(--color-lava-500);
    border-radius: 0.4rem 1.5rem 1.5rem 0.4rem;
    box-shadow: none;
  }
  .t-journal h3 {
    font-size: clamp(1.65rem, 4vw, 2.2rem);
    margin-bottom: 0.8rem;
    letter-spacing: -0.025em;
  }
  p {
    color: var(--soft-text);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 60ch;
  }
  a {
    display: inline-block;
    margin-top: 1rem;
    color: var(--accent);
    font-weight: 900;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  svg {
    width: 100%;
    height: 7rem;
    color: var(--accent);
  }
  :global(.dark) .t-journal {
    background: var(--color-ink-900);
    border-color: var(--color-ink-700);
    border-left-color: var(--color-lava-400);
  }
  @media (min-width: 900px) {
    .t-journal {
      grid-area: journal;
    }
  }
  @media (max-width: 550px) {
    .t-journal {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.5rem;
    }
    svg {
      display: none;
    }
  }
</style>
