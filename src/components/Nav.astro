---
import SiteBrand from './SiteBrand.astro';
import SiteControls from './SiteControls.astro';
import SiteIcon from './SiteIcon.astro';
interface Props {
  nav: {
    about: string;
    cv: string;
    skills?: string;
    projects: string;
    thesis: string;
    blog: string;
    switchLang: string;
  };
  lang: string;
  home?: boolean;
}
const { nav, lang, home = false } = Astro.props;
const anchor = (id: string) => (home ? `#${id}` : `/${lang}/#${id}`);
const links = [
  [nav.about, anchor('about')],
  [nav.cv, anchor('cv')],
  ...(nav.skills ? [[nav.skills, anchor('skills')]] : []),
  [nav.projects, anchor('projects')],
  [nav.thesis, `/${lang}/thesis`],
  [nav.blog, anchor('blog')],
];
---

<header
  class:list={['site-chrome', 'site-header', { 'site-header-home': home }]}
  data-home-header={home || undefined}
>
  <div class="site-header-inner">
    <SiteBrand lang={lang} home={home} />
    <nav
      class="site-desktop-nav"
      aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}
    >
      {
        links.map(([label, href]) => (
          <a
            href={href}
            class="site-nav-link"
            data-ui-sound
            data-spy={href.startsWith('#') ? href.slice(1) : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
    <SiteControls lang={lang} />
    <button
      type="button"
      class="site-icon-button site-menu-toggle"
      aria-expanded="false"
      aria-controls="site-mobile-menu"
      aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
      data-ui-sound
      ><SiteIcon name="menu" class="menu-open" /><SiteIcon
        name="close"
        class="menu-close"
      /></button
    >
  </div>
  <nav
    id="site-mobile-menu"
    class="site-mobile-menu"
    hidden
    aria-label={lang === 'es' ? 'Navegación móvil' : 'Mobile navigation'}
  >
    {
      links.map(([label, href]) => (
        <a href={href} class="site-nav-link" data-ui-sound>
          {label}
          <SiteIcon name="arrow" />
        </a>
      ))
    }
  </nav>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const home = header?.classList.contains('site-header-home');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let lastY = window.scrollY;
  // On the homepage the header waits off-screen while the lake hero is in view and slides
  // down once you start scrolling. Everywhere else it is always there.
  const sync = () => {
    const y = window.scrollY;
    header?.classList.toggle('is-scrolled', y > 24);
    if (home) header?.classList.toggle('is-revealed', y > Math.min(140, window.innerHeight * 0.18));
    // Tuck it away while reading downwards fast, bring it back on any scroll up.
    if (!reduce && y > window.innerHeight) header?.classList.toggle('is-tucked', y > lastY + 4);
    else header?.classList.remove('is-tucked');
    lastY = y;
  };
  window.addEventListener('scroll', sync, { passive: true });
  sync();

  // Scroll-spy: the link for the section on screen gets aria-current.
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.site-desktop-nav [data-spy]')
  );
  const sections = links
    .map((l) => document.getElementById(l.dataset.spy || ''))
    .filter((el): el is HTMLElement => Boolean(el));
  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((l) =>
            l.dataset.spy === e.target.id
              ? l.setAttribute('aria-current', 'true')
              : l.removeAttribute('aria-current')
          );
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((s) => spy.observe(s));
  }

  const button = document.querySelector<HTMLButtonElement>('.site-menu-toggle');
  const menu = document.getElementById('site-mobile-menu');
  const es = document.documentElement.lang === 'es';
  function setMenu(open: boolean) {
    if (!menu || !button) return;
    menu.hidden = !open;
    header?.classList.toggle('is-menu', open);
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute(
      'aria-label',
      open ? (es ? 'Cerrar menú' : 'Close menu') : es ? 'Abrir menú' : 'Open menu'
    );
  }
  button?.addEventListener('click', () => setMenu(Boolean(menu?.hidden)));
  menu
    ?.querySelectorAll('a')
    .forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setMenu(false);
      button?.focus();
    }
  });
  window.matchMedia('(min-width: 1051px)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });
</script>
