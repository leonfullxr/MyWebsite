---
import SiteBrand from './SiteBrand.astro';
import SiteControls from './SiteControls.astro';
import SiteIcon from './SiteIcon.astro';
interface Props {
  nav: {
    about: string;
    cv: string;
    skills?: string;
    projects: string;
    thesis: string;
    blog: string;
    switchLang: string;
  };
  lang: string;
  home?: boolean;
}
const { nav, lang, home = false } = Astro.props;
const anchor = (id: string) => (home ? `#${id}` : `/${lang}/#${id}`);
const links = [
  [nav.about, anchor('about')],
  [nav.cv, anchor('cv')],
  ...(nav.skills ? [[nav.skills, anchor('skills')]] : []),
  [nav.projects, anchor('projects')],
  [nav.thesis, `/${lang}/thesis`],
  [nav.blog, anchor('blog')],
];
---

<header
  class:list={['site-chrome', 'site-header', { 'site-header-home': home }]}
  data-home-header={home || undefined}
>
  <div class="site-header-inner">
    <SiteBrand lang={lang} home={home} />
    <nav
      class="site-desktop-nav"
      aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}
    >
      {
        links.map(([label, href]) => (
          <a href={href} class="site-nav-link" data-ui-sound>
            {label}
          </a>
        ))
      }
    </nav>
    <SiteControls lang={lang} />
    <button
      type="button"
      class="site-icon-button site-menu-toggle"
      aria-expanded="false"
      aria-controls="site-mobile-menu"
      aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
      data-ui-sound
      ><SiteIcon name="menu" class="menu-open" /><SiteIcon
        name="close"
        class="menu-close"
      /></button
    >
  </div>
  <nav
    id="site-mobile-menu"
    class="site-mobile-menu"
    hidden
    aria-label={lang === 'es' ? 'Navegación móvil' : 'Mobile navigation'}
  >
    {
      links.map(([label, href]) => (
        <a href={href} class="site-nav-link" data-ui-sound>
          {label}
          <SiteIcon name="arrow" />
        </a>
      ))
    }
  </nav>
  <svg class="site-header-wave" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true"
    ><path class="header-wave-back" d="M0 0H1440V12C1180 45 1080 2 860 21S430 51 210 21 70 15 0 26Z"
    ></path><path
      class="header-wave-front"
      d="M0 0H1440V8C1240 0 1150 36 920 16S480 2 280 21 80 20 0 8Z"></path></svg
  >
</header>
<script>
  const header = document.querySelector('.site-header');
  const syncScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 40);
  window.addEventListener('scroll', syncScrolled, { passive: true });
  syncScrolled();
  const button = document.querySelector<HTMLButtonElement>('.site-menu-toggle');
  const menu = document.getElementById('site-mobile-menu');
  const es = document.documentElement.lang === 'es';
  function setMenu(open: boolean) {
    if (!menu || !button) return;
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute(
      'aria-label',
      open ? (es ? 'Cerrar menú' : 'Close menu') : es ? 'Abrir menú' : 'Open menu'
    );
  }
  button?.addEventListener('click', () => setMenu(Boolean(menu?.hidden)));
  menu
    ?.querySelectorAll('a')
    .forEach((link) => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu && !menu.hidden) {
      setMenu(false);
      button?.focus();
    }
  });
  window.matchMedia('(min-width: 1051px)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });
</script>
