---
interface Props {
  thesis: {
    title: string;
    description: string;
    cta: string;
  };
  lang: string;
}

const { thesis, lang } = Astro.props;
---

<section id="thesis" class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="section-heading observe-fade">{thesis.title}</h2>
    <a href={`/${lang}/thesis`} class="card block group observe-fade">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-3 mb-3">
            <div
              class="w-10 h-10 rounded-xl bg-sand-100 dark:bg-ink-800 flex items-center justify-center text-sand-600 dark:text-sand-400 group-hover:bg-sand-200 dark:group-hover:bg-ink-700 transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"
                ></path></svg
              >
            </div>
            <h3
              class="text-lg font-medium group-hover:text-sand-600 dark:group-hover:text-sand-400 transition-colors"
            >
              Hopf Torus Gallery
            </h3>
          </div>
          <p class="text-ink-600 dark:text-sand-300 text-sm leading-relaxed mb-4">
            {thesis.description}
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="tag">Three.js</span>
            <span class="tag">Elliptic Curves</span>
            <span class="tag">Hopf Fibration</span>
            <span class="tag">Cryptography</span>
            <span class="tag">Interactive 3D</span>
          </div>
          <span
            class="inline-flex items-center gap-2 text-sm font-mono text-sand-500 group-hover:text-sand-700 dark:group-hover:text-sand-300 transition-colors"
          >
            {thesis.cta}
            <svg
              class="w-4 h-4 group-hover:translate-x-0.5 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
            >
          </span>
        </div>
        <div
          class="shrink-0 w-full md:w-56 lg:w-64 rounded-xl overflow-hidden border border-sand-200 dark:border-ink-700"
        >
          <img
            src="/images/hopf_torus.png"
            alt="Hopf Torus visualization"
            class="w-full h-40 md:h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </div>
      </div>
    </a>
  </div>
</section>
