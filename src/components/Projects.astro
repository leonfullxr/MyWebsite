---
interface Props {
  projects: {
    title: string;
    items: {
      name: string;
      url: string;
      period: string;
      description: string;
      tags: string[];
      image?: string;
    }[];
  };
}

const { projects } = Astro.props;
const allTags = [...new Set(projects.items.flatMap((p) => p.tags))].sort();
---

<section id="projects" class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="section-heading observe-fade">{projects.title}</h2>

    {/* Tag filters */}
    {
      allTags.length > 1 && (
        <div class="flex flex-wrap gap-2 mb-8 observe-fade" id="proj-filters">
          <button
            data-filter="all"
            class="ptag-filter tag cursor-pointer !bg-ink-900 !text-sand-50 dark:!bg-sand-200 dark:!text-ink-900"
          >
            All
          </button>
          {allTags.map((tag) => (
            <button
              data-filter={tag}
              class="ptag-filter tag cursor-pointer hover:bg-sand-300 dark:hover:bg-ink-700"
            >
              {tag}
            </button>
          ))}
        </div>
      )
    }

    {/* Horizontal scroll strip - no page jumps when browsing projects */}
    <div
      class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-4 -mx-6 px-6 scroll-smooth"
      id="proj-list"
    >
      {
        projects.items.map((project, i) => (
          <a
            href={project.url}
            target="_blank"
            rel="noopener"
            class="card group observe-fade block proj-item snap-start shrink-0 w-[82%] sm:w-[46%] lg:w-[31%]"
            data-tags={project.tags.join(',')}
            data-index={i}
          >
            {project.image && (
              <div class="-mx-6 -mt-6 md:-mx-8 md:-mt-8 mb-4 rounded-t-2xl overflow-hidden border-b border-sand-200 dark:border-ink-700">
                <img
                  src={project.image}
                  alt={project.name}
                  class="w-full h-40 object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            )}
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-lg font-medium group-hover:text-sand-600 dark:group-hover:text-sand-400 transition-colors">
                {project.name}
              </h3>
              <svg
                class="w-4 h-4 text-ink-300 dark:text-sand-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform shrink-0 mt-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M7 17L17 7M17 7H7M17 7v10"
                />
              </svg>
            </div>
            <p class="text-sm font-mono text-ink-400 dark:text-sand-500 mb-3">{project.period}</p>
            <p class="text-ink-600 dark:text-sand-300 text-sm leading-relaxed mb-4">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>

    {/* Scroll arrows */}
    <div class="flex items-center justify-center gap-4 mt-8" id="proj-nav">
      <button
        id="proj-prev"
        aria-label="Scroll projects left"
        class="text-sm font-mono px-4 py-2 rounded-full border border-sand-300 dark:border-ink-700 hover:bg-sand-200 dark:hover:bg-ink-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      >
        ←
      </button>
      <button
        id="proj-next"
        aria-label="Scroll projects right"
        class="text-sm font-mono px-4 py-2 rounded-full border border-sand-300 dark:border-ink-700 hover:bg-sand-200 dark:hover:bg-ink-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed"
      >
        →
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const list = document.getElementById('proj-list');
    const items = document.querySelectorAll('.proj-item');
    const filters = document.querySelectorAll('#proj-filters .ptag-filter');
    const nav = document.getElementById('proj-nav');
    const prevBtn = document.getElementById('proj-prev');
    const nextBtn = document.getElementById('proj-next');

    if (!list || !items.length) return;

    let activeTag = 'all';

    function updateNav() {
      const max = list.scrollWidth - list.clientWidth;
      if (nav) nav.style.display = max > 4 ? 'flex' : 'none';
      if (prevBtn) prevBtn.disabled = list.scrollLeft <= 4;
      if (nextBtn) nextBtn.disabled = list.scrollLeft >= max - 4;
    }

    function applyFilter() {
      items.forEach((item) => {
        const show = activeTag === 'all' || item.dataset.tags.split(',').includes(activeTag);
        item.style.display = show ? '' : 'none';
      });
      list.scrollLeft = 0;
      updateNav();
    }

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTag = btn.dataset.filter;
        filters.forEach((b) => {
          b.classList.remove(
            '!bg-ink-900',
            '!text-sand-50',
            'dark:!bg-sand-200',
            'dark:!text-ink-900'
          );
        });
        btn.classList.add(
          '!bg-ink-900',
          '!text-sand-50',
          'dark:!bg-sand-200',
          'dark:!text-ink-900'
        );
        applyFilter();
      });
    });

    function page(dir) {
      list.scrollBy({ left: dir * list.clientWidth * 0.9, behavior: 'smooth' });
    }
    if (prevBtn) prevBtn.addEventListener('click', () => page(-1));
    if (nextBtn) nextBtn.addEventListener('click', () => page(1));

    list.addEventListener('scroll', updateNav, { passive: true });
    window.addEventListener('resize', updateNav);
    updateNav();
  })();
</script>
