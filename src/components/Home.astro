---
// Homepage. The painted lake stays fixed behind the page and scroll position drives each stage:
// the runner comes down the trail, the lake blurs, the portrait rises, skill logos gather into a
// periodic table, badges drop in, and the projects hang on a polaroid wall.
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Tiles from './LogoTiles.astro';
import FrameworkSeals from './FrameworkSeals.astro';
import SiteFlag from './SiteFlag.astro';
import SiteIcon from './SiteIcon.astro';
import '../styles/home.css';
import type { Data, Post } from '../data/home';
import {
  skillGroups,
  awardBadges,
  awardText,
  splitAward,
  tagIcons,
  icons,
  platforms,
  clusters,
  impactIcons,
  projectStacks,
  polaroidFit,
  thesisRepositoryURL,
} from '../data/home';

interface Props {
  data: Data;
  posts: Post[];
  lang: string;
}
const { data, posts, lang } = Astro.props;
const t = data.home;

const exp = data.cv.experience.items;
const current = exp.find((j) => j.current) ?? exp[0];
const earlier = exp.filter((j) => j !== current);
const im = data.impact;
const edu = data.cv.education.items;
const awards = data.cv.awards.items.map((a, i) => {
  const t = awardText(a);
  return { ...splitAward(t.text), url: t.url, badge: awardBadges[i] };
});
const officialBadges = awards.filter(
  (a) => a.badge.kind === 'badge'
) as ((typeof awards)[number] & {
  badge: { kind: 'badge'; src: string };
})[];
const otherAwards = awards.filter((a) => a.badge.kind !== 'badge');
// Dark or black logos that need inverting on the dark theme.
const monoIcons = new Set(['Three.js', 'Wazuh', 'AWS', 'OpenSearch', 'Bash', 'NumPy', 'Pandas']);
const projects = data.projects.items;
const rots = [-6, 3, -2, 5, -4, 2, -5, 4];
const fmtDate = (d: string) => {
  const dt = new Date(d);
  return isNaN(dt.getTime())
    ? d
    : dt.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
};
const panel =
  'rounded-3xl bg-sand-50/90 dark:bg-ink-950/85 backdrop-blur-md shadow-xl shadow-black/10';
// Periodic-table seats for the homepage skill logos. Row/col follow the short table:
// two cells on top, a gap through the middle, then a wider bottom row.
const cellPlace: Record<string, { n: number; row: number; col: number }> = {
  'graphics-0': { n: 1, row: 1, col: 1 },
  'graphics-1': { n: 2, row: 1, col: 18 },
  'languages-0': { n: 3, row: 2, col: 1 },
  'languages-1': { n: 4, row: 2, col: 2 },
  'languages-2': { n: 5, row: 2, col: 13 },
  'languages-3': { n: 6, row: 2, col: 14 },
  'languages-4': { n: 7, row: 2, col: 15 },
  'languages-5': { n: 8, row: 2, col: 16 },
  'languages-6': { n: 9, row: 2, col: 17 },
  'languages-7': { n: 10, row: 2, col: 18 },
  'languages-8': { n: 11, row: 3, col: 1 },
  'languages-9': { n: 12, row: 3, col: 2 },
  'security-0': { n: 13, row: 3, col: 16 },
  'security-1': { n: 14, row: 3, col: 17 },
  'security-2': { n: 15, row: 3, col: 18 },
  'cloud-0': { n: 16, row: 4, col: 1 },
  'cloud-1': { n: 17, row: 4, col: 2 },
  'cloud-2': { n: 18, row: 4, col: 3 },
  'cloud-3': { n: 19, row: 4, col: 4 },
  'cloud-4': { n: 20, row: 4, col: 5 },
  'cloud-5': { n: 21, row: 4, col: 6 },
  'cloud-6': { n: 22, row: 4, col: 7 },
  'cloud-7': { n: 23, row: 4, col: 8 },
  'aiml-0': { n: 24, row: 4, col: 9 },
  'aiml-1': { n: 25, row: 4, col: 10 },
  'aiml-2': { n: 26, row: 4, col: 11 },
  'aiml-3': { n: 27, row: 4, col: 12 },
  'aiml-4': { n: 28, row: 4, col: 13 },
  'aiml-5': { n: 29, row: 4, col: 14 },
  'aiml-6': { n: 30, row: 4, col: 15 },
  'aiml-7': { n: 31, row: 4, col: 16 },
  'aiml-8': { n: 32, row: 4, col: 17 },
  'aiml-9': { n: 33, row: 4, col: 18 },
};
type SkillGroupId = (typeof skillGroups)[number]['id'];
const toneClass: Record<SkillGroupId, string> = {
  languages: 'bg-[#d4e2ec] text-[#163044] dark:bg-[#1b3344] dark:text-[#d7e8f4]',
  security: 'bg-[#d9e6dc] text-[#1a3326] dark:bg-[#1c3328] dark:text-[#d7eee2]',
  cloud: 'bg-[#ead9c4] text-[#3d2b16] dark:bg-[#3d2e1e] dark:text-[#f3e4d0]',
  graphics: 'bg-[#e7d6de] text-[#3d2432] dark:bg-[#3a2832] dark:text-[#f6e0ea]',
  aiml: 'bg-[#ddd6f3] text-[#2a2448] dark:bg-[#2c2848] dark:text-[#e6e0f8]',
};
const skillCells = skillGroups.flatMap((g) =>
  g.icons.flatMap((ic, i) => {
    const place = cellPlace[`${g.id}-${i}`];
    return place ? [{ ...ic, ...place, group: g.id }] : [];
  })
);
const hobbyIcons: string[] = [
  'M3 12h4l3-8 4 16 3-8h4',
  'M2 20 9 8l4 6 3-4 6 10z',
  'M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm12-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
];
---

<div data-home class="home-root relative text-ink-900 dark:text-sand-50">
  <!-- Backdrop: the painted lake, dimmed to dusk in dark mode -->
  <div data-home-backdrop class="fixed inset-0 -z-10 overflow-hidden bg-ink-950" aria-hidden="true">
    <picture>
      <source media="(max-width: 900px)" srcset="/images/scenes/lake-dawn-1280.webp" />
      <img
        src="/images/scenes/lake-dawn.webp"
        alt=""
        class="home-bg w-full h-full object-cover"
        fetchpriority="high"
      />
    </picture>
    <div class="home-stars" data-home-stars></div>
  </div>

  <!-- Progress bar -->
  <div class="fixed top-0 left-0 z-[60] h-[3px] bg-lava-400 home-progress" aria-hidden="true"></div>

  <Nav nav={data.nav} lang={lang} home />

  <!-- Hero: the lake, the runner coming down the trail, and the header still tucked away -->
  <section
    class="home-hero relative h-[100svh] min-h-[560px] overflow-hidden text-center text-white"
    data-home-hero
  >
    <div class="home-hero-shade absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="home-hero-copy relative z-[2] px-5 pt-[12vh] md:pt-[13vh]">
      <p class="mt-3 text-lg md:text-xl font-bold text-white/90">
        <span class="text-white">{data.hero.name}</span>
      </p>
      <h1
        class="home-hero-title mt-3 font-black text-[clamp(2.6rem,7.4vw,5.6rem)] leading-[0.98] tracking-[-0.025em]"
      >
        <span class="home-line-a block">{data.hero.line1}</span>
        <span class="home-line-b block text-lava-200">{data.hero.line2}</span>
      </h1>
    </div>
    <div class="home-runner" data-home-runner aria-hidden="true">
      <img src="/images/mascot/running.webp" alt="" width="640" height="640" />
    </div>
    <a
      href="#about"
      class="home-cue absolute bottom-6 left-1/2 z-[2] -translate-x-1/2 flex flex-col items-center gap-1 text-white text-sm font-bold"
      data-ui-sound
    >
      {t.scroll}
      <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5"
        ><path d="m6 9 6 6 6-6"></path></svg
      >
    </a>
  </section>

  <!-- About stage -->
  <section id="about" data-scroll="pin" data-settle="0.88" class="home-pin relative md:h-[220vh]">
    <div class="md:sticky md:top-0 md:h-screen flex items-center px-4 pt-20 pb-6">
      <div
        class="relative w-full max-w-6xl mx-auto p-6 md:p-12 grid md:grid-cols-[45fr_55fr] items-center gap-8 md:gap-14"
      >
        <div class={`home-about-bg absolute inset-0 ${panel}`} aria-hidden="true"></div>
        <img
          src="/images/profile.jpg"
          alt={t.profileAlt}
          class="home-photo relative w-full aspect-[4/3] rounded-3xl object-cover object-[50%_35%] shadow-2xl shadow-black/30"
        />
        <div class="home-about-text relative min-w-0" data-decoder>
          <div class="flex flex-wrap items-center justify-between gap-4">
            <h2 class="text-4xl md:text-5xl font-black">{data.about.title}</h2>
            <button
              type="button"
              class="decoder-switch"
              role="switch"
              aria-checked="false"
              aria-label={data.about.switchLabel}
              data-decoder-switch
              data-ui-sound
            >
              <span class="decoder-mode is-plain">{data.about.plainLabel}</span>
              <span class="decoder-track" aria-hidden="true"
                ><img src="/images/mascot/head.webp" alt="" width="64" height="64" /></span
              >
              <span class="decoder-mode is-tech">{data.about.techLabel}</span>
            </button>
          </div>
          <div class="decoder-views mt-5">
            <div class="decoder-view" data-view="plain">
              {
                data.about.plain.map((para) => (
                  <p>
                    {para.map((seg) =>
                      'tip' in seg && seg.tip ? (
                        <button type="button" class="decoder-term" data-tip={seg.tip}>
                          {seg.text}
                        </button>
                      ) : (
                        seg.text
                      )
                    )}
                  </p>
                ))
              }
            </div>
            <div class="decoder-view is-tech" data-view="tech" hidden>
              {data.about.paragraphs.map((p) => <p>{p}</p>)}
            </div>
          </div>
          <div class="home-contact decoder-foot">
            <span class="decoder-hint" data-decoder-hint
              ><i aria-hidden="true"></i>{data.about.hint}</span
            >
            <div class="flex items-center gap-2">
              <a href={`/${lang}/about`} class="link text-sm font-bold mr-2" data-ui-sound
                >{data.about.more}</a
              >
              <a
                href={`mailto:${data.contact.email}`}
                class="decoder-icon"
                style="--brand: #c92a4f"
                aria-label={t.emailMe}
                data-ui-sound
                ><svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  ><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect><path
                    d="m3 7 9 6 9-6"></path></svg
                ></a
              >
              <a
                href={data.contact.linkedin}
                target="_blank"
                rel="noopener"
                class="decoder-icon"
                style="--brand: #0a66c2"
                aria-label="LinkedIn"
                data-ui-sound
                ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                  ><path d={icons.linkedin}></path></svg
                ></a
              >
              <a
                href={data.contact.github}
                target="_blank"
                rel="noopener"
                class="decoder-icon"
                style="--brand: #181717"
                aria-label="GitHub"
                data-ui-sound
                ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                  ><path d={icons.github}></path></svg
                ></a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience: an impact board. Numbers first, one line per theme, and every card opens in place. -->
  <section id="cv" data-scroll="view" class="relative px-4 py-8">
    <div class={`${panel} relative max-w-6xl mx-auto p-6 md:p-12`}>
      <h2 class="home-title text-4xl md:text-5xl font-black" data-title>{data.cv.title}</h2>
      {
        current && (
          <article class="impact mt-8" data-impact>
            <header class="flex flex-wrap items-center gap-3.5">
              <span class="grid h-[52px] w-[52px] place-items-center rounded-2xl bg-white ring-1 ring-sand-200 dark:ring-ink-700">
                <img src="/images/icons/wazuh.png" alt="Wazuh" class="w-10" />
              </span>
              <div>
                <h3 class="text-2xl md:text-[26px] font-black leading-tight">
                  {current.role}{' '}
                  <span class="font-normal text-ink-500 dark:text-ink-300">{t.at}</span>{' '}
                  <a href={current.url} target="_blank" rel="noopener" class="link" data-ext>
                    {current.company}
                  </a>
                </h3>
                <p class="text-sm font-bold text-ink-500 dark:text-ink-300">{current.period}</p>
              </div>
            </header>
            <div class="impact-grid mt-6">
              {im.stats.map((st, i) => (
                <article class="ic ic-stat" data-ic data-reveal style={`--d:${i * 80}ms`}>
                  <div class="ic-sum" data-ic-sum>
                    <b class="ic-num" data-count={st.num}>
                      {st.num}
                    </b>
                    <h4>{st.label}</h4>
                    <p class="ic-line">{st.summary}</p>
                  </div>
                  <div class="ic-more" id={`ic-${st.k}`} hidden>
                    {st.k === 'events' && (
                      <div class="ic-pipe">
                        {im.pipeline.map((step, j) => (
                          <>
                            {j > 0 && <i aria-hidden="true">→</i>}
                            <span style={`--j:${j}`}>{step}</span>
                          </>
                        ))}
                      </div>
                    )}
                    {st.k === 'cost' && (
                      <ol class="ic-levers">
                        {im.levers.map(([b, rest]) => (
                          <li>
                            <b>{b}</b> {rest}
                          </li>
                        ))}
                      </ol>
                    )}
                    {st.k === 'platforms' && <Tiles items={platforms} />}
                    {st.k === 'frameworks' && <FrameworkSeals items={im.frameworks} />}
                    {'full' in st && typeof st.full === 'number' && (
                      <p class="ic-full">{current.description[st.full]}</p>
                    )}
                  </div>
                  <button
                    type="button"
                    class="ic-tog"
                    aria-expanded="false"
                    aria-controls={`ic-${st.k}`}
                    data-ui-sound
                  >
                    <span>{im.details}</span>
                    <i aria-hidden="true">+</i>
                  </button>
                </article>
              ))}
            </div>
            <div class="impact-grid mt-3">
              {im.themes.map((th, i) => (
                <article class="ic" data-ic data-reveal style={`--d:${(i % 4) * 70}ms`}>
                  <div class="ic-sum" data-ic-sum>
                    <div class="ic-heading">
                      <svg
                        class="ic-ico"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d={impactIcons[th.icon]} />
                      </svg>
                      <h4>{th.title}</h4>
                    </div>
                    <p class="ic-line">{th.line}</p>
                  </div>
                  <div class="ic-more" id={`ic-t-${th.k}`} hidden>
                    {th.logos === 'clusters' && <Tiles items={clusters} />}
                    {th.logos === 'platforms' && <Tiles items={platforms} />}
                    {th.logos === 'frameworks' && <FrameworkSeals items={im.frameworks} />}
                    <p class="ic-full">{current.description[th.full]}</p>
                  </div>
                  <button
                    type="button"
                    class="ic-tog"
                    aria-expanded="false"
                    aria-controls={`ic-t-${th.k}`}
                    data-ui-sound
                  >
                    <span>{im.details}</span>
                    <i aria-hidden="true">+</i>
                  </button>
                </article>
              ))}
            </div>
          </article>
        )
      }

      {
        earlier.length > 0 && (
          <>
            <h3 class="mt-10 mb-4 text-[15px] font-black text-ink-500 dark:text-ink-300">
              {im.earlier}
            </h3>
            <div class="impact-grid impact-grid-wide">
              {earlier.map((job, i) => (
                <article class="ic" data-ic data-reveal style={`--d:${i * 80}ms`}>
                  <div class="ic-sum" data-ic-sum>
                    <h4>
                      {job.role}{' '}
                      <span class="font-normal text-ink-500 dark:text-ink-300">{t.at}</span>{' '}
                      {job.company}
                    </h4>
                    <p class="text-sm font-bold text-ink-500 dark:text-ink-300">{job.period}</p>
                    <p class="ic-line">{job.description[0]}</p>
                  </div>
                  <div class="ic-more" id={`ic-job-${i}`} hidden>
                    <ul class="ic-list">
                      {job.description.slice(1).map((d) => (
                        <li>{d}</li>
                      ))}
                    </ul>
                  </div>
                  <button
                    type="button"
                    class="ic-tog"
                    aria-expanded="false"
                    aria-controls={`ic-job-${i}`}
                    data-ui-sound
                  >
                    <span>{im.details}</span>
                    <i aria-hidden="true">+</i>
                  </button>
                </article>
              ))}
            </div>
          </>
        )
      }

      <h3 class="mt-10 mb-4 text-[15px] font-black text-ink-500 dark:text-ink-300">
        {data.cv.education.title}
      </h3>
      <div class="grid md:grid-cols-2 gap-4">
        {
          edu.map((e, i) => (
            <article
              data-reveal
              style={`--d:${i * 120}ms`}
              class="ic-edu rounded-2xl border border-sand-200 dark:border-ink-800 bg-white/70 dark:bg-ink-900/70 p-5 md:p-6"
            >
              <div class="edu-heading">
                <h4 class="text-lg font-black">{e.degree}</h4>
                <span class="edu-location" role="img" title={e.location} aria-label={e.location}>
                  <SiteIcon name="pin" />
                  <SiteFlag language={e.country} />
                </span>
              </div>
              <p class="mt-1 text-sm font-bold text-lava-700 dark:text-lava-300">
                <a href={e.url} target="_blank" rel="noopener noreferrer" class="link" data-ext>
                  {e.institution}
                </a>
              </p>
              <p class="text-sm text-ink-500 dark:text-ink-300">{e.period}</p>
              <p class="mt-3 text-ink-700 dark:text-ink-200 leading-relaxed">{e.details}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Skills + certifications: logos gather into the table, badges drop in -->
  <section
    id="skills"
    data-scroll="pin"
    data-lead="0.9"
    data-settle="0.65"
    class="home-pin relative md:h-[220vh]"
  >
    <div class="md:sticky md:top-0 md:h-screen flex items-center px-4 pt-20 pb-6">
      <div class={`${panel} w-full max-w-6xl mx-auto p-6 md:p-10`}>
        <h2 class="text-4xl md:text-5xl font-black">{t.stackTitle}</h2>
        <div class="mt-8 max-md:overflow-x-auto max-md:overscroll-x-contain">
          <div
            data-home-field
            class="home-field relative grid gap-[3px] max-md:min-w-[52rem]"
            style="grid-template-columns: 1.1rem repeat(18, minmax(0, 1fr));"
          >
            <div></div>
            {
              Array.from({ length: 18 }, (_, i) => (
                <div class="pb-1 text-center text-[10px] font-bold leading-none text-ink-500 dark:text-lava-400">
                  {i + 1}
                </div>
              ))
            }
            {
              [1, 2, 3, 4].map((row) => (
                <div
                  style={`grid-column: 1; grid-row: ${row + 1}`}
                  class="flex items-center justify-end pr-1 text-[10px] font-bold text-ink-500 dark:text-lava-400"
                >
                  {row}
                </div>
              ))
            }
            {
              skillCells.map((cell) => (
                <span
                  data-home-tile
                  data-ui-sound="skill"
                  data-sound-note={cell.n}
                  tabindex="0"
                  title={cell.name}
                  class:list={[
                    'home-tile home-cell group relative flex aspect-square w-full select-none flex-col items-center justify-center border border-black/10 outline-hidden dark:border-white/10',
                    'focus-visible:z-[5] focus-visible:ring-2 focus-visible:ring-ink-950 focus-visible:ring-offset-2 focus-visible:ring-offset-sand-50 dark:focus-visible:ring-sand-100 dark:focus-visible:ring-offset-ink-950',
                    toneClass[cell.group],
                  ]}
                  style={`grid-column: ${cell.col + 1}; grid-row: ${cell.row + 1}`}
                >
                  <span class="absolute left-1 top-0.5 text-[9px] font-bold tabular-nums leading-none opacity-60">
                    {cell.n}
                  </span>
                  <img
                    src={cell.src}
                    alt={cell.name}
                    loading="lazy"
                    class:list={[
                      'home-icon h-7 w-auto max-w-[72%] object-contain',
                      monoIcons.has(cell.name) && 'home-mono',
                    ]}
                  />
                  <span class="home-tip absolute bottom-full left-1/2 z-10 mb-1.5 -translate-x-1/2 whitespace-nowrap rounded-md bg-ink-900 px-2 py-0.5 text-xs font-bold text-white pointer-events-none">
                    {cell.name}
                  </span>
                </span>
              ))
            }
          </div>
        </div>
        <ul class="home-label mt-4 flex flex-wrap gap-x-5 gap-y-2">
          {
            skillGroups.map((g) => (
              <li class="flex items-center gap-2 text-sm font-bold text-ink-700 dark:text-sand-200">
                <span
                  class:list={[
                    'h-3.5 w-3.5 border border-black/10 dark:border-white/10',
                    toneClass[g.id],
                  ]}
                />
                {t.skillGroups[g.id]}
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <div
            class="rounded-2xl bg-white/80 dark:bg-ink-900/80 ring-1 ring-black/5 dark:ring-white/10 p-5 md:flex md:items-center md:gap-8"
          >
            <div class="grid w-full max-w-3xl grid-cols-2 items-start gap-4 sm:grid-cols-4">
              {
                officialBadges.map((a) => (
                  <a
                    href={a.url}
                    target="_blank"
                    rel="noopener"
                    title={a.title}
                    data-ui-sound="certificate"
                    class="group text-center"
                  >
                    <div data-home-badge class="home-badge-img">
                      <img
                        src={a.badge.src}
                        alt={`${t.badgeAlt}: ${a.title}`}
                        loading="lazy"
                        class="w-full aspect-square object-contain drop-shadow-md transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-2"
                      />
                    </div>
                    <p class="mt-1 text-xs font-bold leading-tight text-ink-500 dark:text-ink-300">
                      {a.date || a.issuer}
                    </p>
                  </a>
                ))
              }
            </div>
            <div
