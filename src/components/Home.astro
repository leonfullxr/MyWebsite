<script is:inline>
  (function () {
    const root = document.querySelector('[data-home]');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scrollEls = Array.from(root.querySelectorAll('[data-scroll]'));
    const header = root.querySelector('[data-home-header]');
    const field = root.querySelector('[data-home-field]');
    const badgeSection = root.querySelector('#skills');
    const badges = Array.from(root.querySelectorAll('[data-home-badge]'));
    const clamp = (v) => Math.min(1, Math.max(0, v));
    const hero = root.querySelector('[data-home-hero]');

    function hash(n) {
      let x = Math.imul(n ^ 0x9e3779b9, 0x85ebca6b);
      x ^= x >>> 13;
      x = Math.imul(x, 0xc2b2ae35);
      x ^= x >>> 16;
      return (x >>> 0) / 4294967296;
    }

    // Icons keep their normal flow position; each one only animates its offset from a scattered start.
    function layoutSkills() {
      if (!field) return;
      const tiles = Array.from(field.querySelectorAll('[data-home-tile]'));
      if (window.innerWidth < 768) {
        tiles.forEach((t) => ['--dx', '--dy', '--r'].forEach((k) => t.style.removeProperty(k)));
        return;
      }
      const W = field.offsetWidth;
      const H = field.offsetHeight;
      tiles.forEach((t, i) => {
        // field is the tiles' offsetParent, and offsets ignore the transform being animated.
        const x = t.offsetLeft;
        const y = t.offsetTop;
        const sx = hash(i * 3 + 1) * (W - t.offsetWidth);
        const sy = hash(i * 3 + 2) * (H - t.offsetHeight);
        t.style.setProperty('--dx', (sx - x).toFixed(1) + 'px');
        t.style.setProperty('--dy', (sy - y).toFixed(1) + 'px');
        t.style.setProperty('--r', (hash(i * 3 + 3) * 60 - 30).toFixed(1) + 'deg');
      });
    }

    function setBadges(p) {
      badges.forEach((b, i) => {
        b.classList.toggle('is-on', p > 0.18 + (i / badges.length) * 0.52);
      });
    }

    function update() {
      const ih = window.innerHeight;
      const mobile = window.innerWidth < 768;
      const max = document.documentElement.scrollHeight - ih;
      root.style.setProperty('--page', (max > 0 ? clamp(window.scrollY / max) : 0).toFixed(4));
      if (hero) hero.style.setProperty('--hero', clamp(window.scrollY / (ih * 0.7)).toFixed(4));
      if (header) header.classList.toggle('is-scrolled', window.scrollY > 40);
      for (const el of scrollEls) {
        const r = el.getBoundingClientRect();
        // data-lead starts a pinned stage before it sticks, so skills begin
        // gathering while experience is still on screen.
        const lead = Number(el.dataset.lead || 0) * ih;
        const p =
          el.dataset.scroll === 'view' || el.classList.contains('is-flow') || mobile
            ? clamp((ih - r.top) / (ih / 2 + r.height / 2))
            : clamp((lead - r.top) / (r.height - ih + lead));
        el.style.setProperty('--p', p.toFixed(4));
        if (el === badgeSection) setBadges(p);
      }
    }

    const revealEls = Array.from(root.querySelectorAll('[data-reveal]'));

    if (reduce) {
      root.style.setProperty('--page', '0');
      scrollEls.forEach((el) => el.style.setProperty('--p', '1'));
      revealEls.forEach((el) => el.classList.add('is-in'));
      if (header) {
        const syncHeader = () => {
          header.classList.toggle('is-scrolled', window.scrollY > 40);
        };
        syncHeader();
        window.addEventListener('scroll', syncHeader, { passive: true });
      }
      setBadges(1);
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealEls.forEach((el) => io.observe(el));

    let ticking = false;
    function schedule() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    }
    function refresh() {
      layoutSkills();
      schedule();
    }
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', refresh, { passive: true });
    window.addEventListener('load', refresh);
    refresh();

    // Pinned sections animate in as you scroll through them, so their top shows the
    // unassembled start. Anchor jumps land at data-settle instead, once the stage is complete.
    function settleTarget(hash) {
      const sec = hash.length > 1 && root.querySelector(`section${hash}[data-settle]`);
      if (!sec || window.innerWidth < 768 || sec.classList.contains('is-flow')) return null;
      const top = sec.getBoundingClientRect().top + window.scrollY;
      return top + (sec.offsetHeight - window.innerHeight) * Number(sec.dataset.settle);
    }
    document.addEventListener('click', (e) => {
      const a = e.target.closest('a[href]');
      if (!a) return;
      const url = new URL(a.href, location.href);
      if (url.pathname !== location.pathname) return;
      const y = settleTarget(url.hash);
      if (y === null) return;
      e.preventDefault();
      history.pushState(null, '', url.hash);
      window.scrollTo({ top: y, behavior: 'smooth' });
    });
    function settleOnLoad() {
      const y = settleTarget(location.hash);
      if (y !== null) window.scrollTo({ top: y, behavior: 'instant' });
    }
    if (document.readyState === 'complete') settleOnLoad();
    else window.addEventListener('load', settleOnLoad);
  })();
</script>

<script is:inline>
  // Playful layer: stars, the runner on the trail, swashes under titles, counting numbers,
  // impact cards that open in place, and the polaroid wall.
  (function () {
    const root = document.querySelector('[data-home]');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const seen = (els, cb, opts) => {
      if (!('IntersectionObserver' in window) || reduce) {
        els.forEach((el) => cb(el));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              cb(e.target);
              io.unobserve(e.target);
            }
          });
        },
        opts || { threshold: 0.35 }
      );
      els.forEach((el) => io.observe(el));
    };

    // Stars over the lake at night.
    const stars = root.querySelector('[data-home-stars]');
    if (stars) {
      for (let k = 0; k < 60; k++) {
        const s = document.createElement('i');
        s.style.left = Math.random() * 100 + '%';
        s.style.top = Math.random() * 100 + '%';
        s.style.animationDelay = Math.random() * 3 + 's';
        stars.appendChild(s);
      }
    }

    // The runner: a path laid over the painted trail, recomputed for how the picture is cropped.
    const runner = root.querySelector('[data-home-runner]');
    const IW = 2400;
    const IH = 1695;
    const TRAIL = [
      [0.171, 0.852],
      [0.185, 0.897],
      [0.204, 0.944],
      [0.238, 1.015],
      [0.276, 1.1],
      [0.29, 1.16],
    ];
    function placeRunner() {
      if (!runner) return;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const s = Math.max(vw / IW, vh / IH);
      const w = IW * s;
      const h = IH * s;
      const ox = (vw - w) * (vw <= 700 ? 0.24 : 0.5);
      const oy = vh - h;
      const p = TRAIL.map(([x, y]) => [(ox + x * w).toFixed(1), (oy + y * h).toFixed(1)]);
      runner.style.offsetPath = `path("M ${p[0][0]} ${p[0][1]} C ${p[1][0]} ${p[1][1]}, ${p[2][0]} ${p[2][1]}, ${p[3][0]} ${p[3][1]} S ${p[4][0]} ${p[4][1]}, ${p[5][0]} ${p[5][1]}")`;
      runner.style.setProperty('--runner', Math.max(90, (150 * w) / 1200).toFixed(0) + 'px');
      if (!reduce) runner.classList.add('is-running');
    }
    placeRunner();
    window.addEventListener('resize', placeRunner, { passive: true });

    // Swashes draw in under section titles.
    seen(Array.from(root.querySelectorAll('[data-title]')), (el) => el.classList.add('is-in'), {
      threshold: 0.6,
    });

    // Numbers count up the first time they are seen.
    const counters = Array.from(root.querySelectorAll('[data-count]'));
    const parts = (v) => v.match(/^([^0-9]*)([0-9]+)(.*)$/);
    if (!reduce)
      counters.forEach((el) => {
        const m = parts(el.dataset.count || '');
        if (m) el.textContent = m[1] + '0' + m[3];
      });
    seen(counters, (el) => {
      const m = parts(el.dataset.count || '');
      if (!m || reduce) {
        el.textContent = el.dataset.count || '';
        return;
      }
      const end = Number(m[2]);
      const t0 = performance.now();
      el.classList.add('is-counting');
      const tick = (now) => {
        const k = Math.min(1, (now - t0) / 1300);
        const eased = 1 - Math.pow(1 - k, 3);
        el.textContent = m[1] + Math.round(end * eased) + m[3];
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });

    // Impact cards open in place, one at a time.
    const cards = Array.from(root.querySelectorAll('[data-ic]'));
    cards.forEach((c, i) => (c.style.viewTransitionName = 'ic-' + i));
    const swap = (fn) =>
      document.startViewTransition && !reduce ? document.startViewTransition(fn) : fn();
    function setOpen(c, on) {
      c.classList.toggle('is-open', on);
      const more = c.querySelector('.ic-more');
      if (more) more.hidden = !on;
      const tog = c.querySelector('.ic-tog');
      if (!tog) return;
      tog.setAttribute('aria-expanded', String(on));
      const label = tog.querySelector('span');
      if (label) label.textContent = on ? tog.dataset.close : tog.dataset.open;
    }
    cards.forEach((c) => {
      const tog = c.querySelector('.ic-tog');
      if (tog) {
        tog.dataset.open = tog.querySelector('span')?.textContent || '';
        tog.dataset.close = document.documentElement.lang === 'es' ? 'Cerrar' : 'Close';
      }
      const go = () => {
        const on = !c.classList.contains('is-open');
        const t = swap(() => {
          cards.forEach((x) => x !== c && x.classList.contains('is-open') && setOpen(x, false));
          setOpen(c, on);
        });
        const after = () => {
          const r = c.getBoundingClientRect();
          if (on && (r.top < 80 || r.top > window.innerHeight - 120))
            c.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        };
        if (t && t.finished) t.finished.then(after);
        else after();
      };
      tog?.addEventListener('click', (e) => {
        e.stopPropagation();
        go();
      });
      c.querySelector('[data-ic-sum]')?.addEventListener('click', go);
    });

    // Polaroid wall: drop in, tilt towards the cursor, pick one up to fill the drawer.
    const wall = root.querySelector('[data-polaroids]');
    if (wall) {
      seen([wall], (el) => el.classList.add('is-in'), { threshold: 0.15 });
      const pols = Array.from(wall.querySelectorAll('[data-pol]'));
      const panes = Array.from(wall.querySelectorAll('[data-pd]'));
      const empty = wall.querySelector('[data-pd-empty]');
      const drawer = wall.querySelector('.pw-drawer');
      const show = (i, fromTap) => {
        pols.forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.pol === String(i))));
        panes.forEach((p) => (p.hidden = p.dataset.pd !== String(i)));
        if (empty) empty.hidden = true;
        if (fromTap && drawer && window.innerWidth <= 960) {
          drawer.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
        }
      };
      const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      pols.forEach((p) => {
        p.addEventListener('click', () => show(p.dataset.pol, true));
        if (!fine) return;
        p.addEventListener('mouseenter', () => show(p.dataset.pol, false));
        if (reduce) return;
        p.addEventListener('mousemove', (e) => {
          const r = p.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          p.style.setProperty('--tx', (x * 14).toFixed(2) + 'deg');
          p.style.setProperty('--ty', (-y * 14).toFixed(2) + 'deg');
        });
        p.addEventListener('mouseleave', () => {
          p.style.removeProperty('--tx');
          p.style.removeProperty('--ty');
        });
      });
    }
  })();
</script>

<script is:inline>
  // About me: Plain/Technical switch, and tap-to-open term tooltips for touch screens.
  (function () {
    const box = document.querySelector('[data-decoder]');
    if (!box) return;
    const sw = box.querySelector('[data-decoder-switch]');
    const plain = box.querySelector('[data-view="plain"]');
    const tech = box.querySelector('[data-view="tech"]');
    const hint = box.querySelector('[data-decoder-hint]');
    const views = box.querySelector('.decoder-views');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let busy = false;
    // Old text fades out, the box eases to the new height, the new paragraphs rise in.
    sw?.addEventListener('click', () => {
      if (busy) return;
      const on = sw.getAttribute('aria-checked') !== 'true';
      sw.setAttribute('aria-checked', String(on));
      if (hint) hint.hidden = on;
      const from = on ? plain : tech;
      const to = on ? tech : plain;
      const swap = () => {
        const start = views.offsetHeight;
        from.hidden = true;
        from.classList.remove('is-leaving');
        to.hidden = false;
        if (reduce) return;
        const end = views.offsetHeight;
        views.style.height = start + 'px';
        void views.offsetHeight;
        views.classList.add('is-resizing');
        views.style.height = end + 'px';
        const done = () => {
          views.classList.remove('is-resizing');
          views.style.height = '';
          busy = false;
        };
        views.addEventListener('transitionend', done, { once: true });
        window.setTimeout(done, 700);
      };
      if (reduce) return swap();
      busy = true;
      from.classList.add('is-leaving');
      window.setTimeout(swap, 200);
    });
    const terms = Array.from(box.querySelectorAll('.decoder-term'));
    const closeAll = (except) =>
      terms.forEach((t) => t !== except && t.classList.remove('is-open'));
    terms.forEach((t) =>
      t.addEventListener('click', (e) => {
        e.stopPropagation();
        closeAll(t);
        t.classList.toggle('is-open');
      })
    );
    document.addEventListener('click', () => closeAll());
    document.addEventListener('keydown', (e) => e.key === 'Escape' && closeAll());
  })();
</script>
