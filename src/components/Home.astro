---
// Homepage. The Alhambra photo stays fixed behind the page and scroll position drives each stage:
// the photo blurs, the portrait rises, skill logos gather into a periodic table, badges drop in.
import type { Data, Post } from '../data/home';
import {
  skillGroups,
  awardBadges,
  awardText,
  splitAward,
  imageSize,
  tagIcons,
  icons,
} from '../data/home';

interface Props {
  data: Data;
  posts: Post[];
  lang: string;
}
const { data, posts, lang } = Astro.props;
const t = data.home;
const otherLang = lang === 'es' ? 'en' : 'es';
const fill = (s: string, n: number) => s.replace('{n}', String(n));

const exp = data.cv.experience.items;
const edu = data.cv.education.items;
const awards = data.cv.awards.items.map((a, i) => {
  const t = awardText(a);
  return { ...splitAward(t.text), url: t.url, badge: awardBadges[i] };
});
const officialBadges = awards.filter((a) => a.badge.kind === 'badge');
const otherAwards = awards.filter((a) => a.badge.kind !== 'badge');
// Dark or black logos that need inverting on the dark theme.
const monoIcons = new Set(['Three.js', 'Wazuh', 'AWS', 'OpenSearch', 'Bash', 'NumPy', 'Pandas']);
const projects = data.projects.items;
const fmtDate = (d: string) => {
  const dt = new Date(d);
  return isNaN(dt.getTime())
    ? d
    : dt.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
};
const year = new Date().getFullYear();
const nav = [
  [data.nav.about, '#about'],
  [data.nav.cv, '#cv'],
  [data.nav.skills, '#skills'],
  [data.nav.projects, '#projects'],
  [data.nav.thesis, `/${lang}/thesis`],
  [data.nav.blog, '#blog'],
];
const panel =
  'rounded-3xl bg-sand-50/90 dark:bg-ink-950/85 backdrop-blur-md shadow-xl shadow-black/10';
// Periodic-table seats for the homepage skill logos. Row/col follow the short table:
// two cells on top, a gap through the middle, then a wider bottom row.
const cellPlace: Record<string, { n: number; row: number; col: number }> = {
  'graphics-0': { n: 1, row: 1, col: 1 },
  'graphics-1': { n: 2, row: 1, col: 18 },
  'languages-0': { n: 3, row: 2, col: 1 },
  'languages-1': { n: 4, row: 2, col: 2 },
  'languages-2': { n: 5, row: 2, col: 13 },
  'languages-3': { n: 6, row: 2, col: 14 },
  'languages-4': { n: 7, row: 2, col: 15 },
  'languages-5': { n: 8, row: 2, col: 16 },
  'languages-6': { n: 9, row: 2, col: 17 },
  'languages-7': { n: 10, row: 2, col: 18 },
  'languages-8': { n: 11, row: 3, col: 1 },
  'languages-9': { n: 12, row: 3, col: 2 },
  'security-0': { n: 13, row: 3, col: 16 },
  'security-1': { n: 14, row: 3, col: 17 },
  'security-2': { n: 15, row: 3, col: 18 },
  'cloud-0': { n: 16, row: 4, col: 1 },
  'cloud-1': { n: 17, row: 4, col: 2 },
  'cloud-2': { n: 18, row: 4, col: 3 },
  'cloud-3': { n: 19, row: 4, col: 4 },
  'cloud-4': { n: 20, row: 4, col: 5 },
  'cloud-5': { n: 21, row: 4, col: 6 },
  'cloud-6': { n: 22, row: 4, col: 7 },
  'cloud-7': { n: 23, row: 4, col: 8 },
  'aiml-0': { n: 24, row: 4, col: 9 },
  'aiml-1': { n: 25, row: 4, col: 10 },
  'aiml-2': { n: 26, row: 4, col: 11 },
  'aiml-3': { n: 27, row: 4, col: 12 },
  'aiml-4': { n: 28, row: 4, col: 13 },
  'aiml-5': { n: 29, row: 4, col: 14 },
  'aiml-6': { n: 30, row: 4, col: 15 },
  'aiml-7': { n: 31, row: 4, col: 16 },
  'aiml-8': { n: 32, row: 4, col: 17 },
  'aiml-9': { n: 33, row: 4, col: 18 },
};
type SkillGroupId = (typeof skillGroups)[number]['id'];
const toneClass: Record<SkillGroupId, string> = {
  languages: 'bg-[#d4e2ec] text-[#163044] dark:bg-[#1b3344] dark:text-[#d7e8f4]',
  security: 'bg-[#d9e6dc] text-[#1a3326] dark:bg-[#1c3328] dark:text-[#d7eee2]',
  cloud: 'bg-[#ead9c4] text-[#3d2b16] dark:bg-[#3d2e1e] dark:text-[#f3e4d0]',
  graphics: 'bg-[#e7d6de] text-[#3d2432] dark:bg-[#3a2832] dark:text-[#f6e0ea]',
  aiml: 'bg-[#ddd6f3] text-[#2a2448] dark:bg-[#2c2848] dark:text-[#e6e0f8]',
};
const skillCells = skillGroups.flatMap((g) =>
  g.icons.flatMap((ic, i) => {
    const place = cellPlace[`${g.id}-${i}`];
    return place ? [{ ...ic, ...place, group: g.id }] : [];
  })
);
const hobbyIcons: string[] = [
  'M3 12h4l3-8 4 16 3-8h4',
  'M2 20 9 8l4 6 3-4 6 10z',
  'M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm12-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
];
---

<div data-home class="home-root relative text-ink-900 dark:text-sand-50">
  <!-- Backdrop -->
  <div class="fixed inset-0 -z-10 overflow-hidden bg-ink-950" aria-hidden="true">
    <img src="/images/alhambra.jpg" alt="" class="home-bg w-full h-full object-cover" />
  </div>

  <!-- Progress bar -->
  <div class="fixed top-0 left-0 z-[60] h-[3px] bg-sand-400 home-progress" aria-hidden="true"></div>

  <!-- Header -->
  <header data-home-header class="home-header fixed top-0 inset-x-0 z-50">
    <div class="max-w-6xl mx-auto px-5 h-16 flex items-center justify-between gap-6">
      <a href="#" class="text-xl font-black"
        ><span class="text-sand-400">return</span> leon<span class="text-sand-400">;</span></a
      >
      <nav class="flex items-center gap-1 text-sm font-bold">
        {
          nav.map(([label, href]) => (
            <a
              href={href}
              class="hidden md:inline-block px-3 py-2 rounded-full hover:bg-white/15 dark:hover:bg-white/10 transition-colors"
            >
              {label}
            </a>
          ))
        }
        <a
          href={`/${otherLang}/`}
          class="px-3 py-2 rounded-full hover:bg-white/15 transition-colors"
          >{data.nav.switchLang}</a
        >
        <button
          onclick="toggleTheme()"
          class="w-9 h-9 grid place-items-center rounded-full hover:bg-white/15 transition-colors"
          aria-label={t.toggleTheme}
        >
          <svg
            viewBox="0 0 24 24"
            class="w-5 h-5 dark:hidden"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg
          >
          <svg
            viewBox="0 0 24 24"
            class="w-5 h-5 hidden dark:block"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path></svg
          >
        </button>
        <button
          data-home-menu-toggle
          class="md:hidden w-9 h-9 grid place-items-center rounded-full hover:bg-white/15 transition-colors"
          aria-label={t.menu}
          aria-expanded="false"
          aria-controls="home-menu"
        >
          <svg
            viewBox="0 0 24 24"
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
          >
        </button>
      </nav>
    </div>
    <div
      id="home-menu"
      hidden
      class="md:hidden mx-4 mb-3 rounded-2xl bg-sand-50/95 dark:bg-ink-950/95 text-ink-900 dark:text-sand-50 backdrop-blur-md shadow-xl p-2"
    >
      {
        nav.map(([label, href]) => (
          <a
            href={href}
            class="block rounded-xl px-4 py-3 text-base font-bold hover:bg-sand-200/70 dark:hover:bg-white/10"
          >
            {label}
          </a>
        ))
      }
    </div>
  </header>

  <!-- Hero -->
  <section class="relative h-screen flex flex-col items-center justify-center text-center px-5">
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.32),transparent_65%)] pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div class="relative">
      <p class="text-xl md:text-2xl font-bold text-white/90 drop-shadow-lg">{data.hero.greeting}</p>
      <h1
        class="mt-2 font-black text-6xl md:text-8xl text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.45)] leading-[0.95]"
      >
        {data.hero.name}
      </h1>
      <p
        class="mt-6 max-w-2xl mx-auto text-base md:text-lg font-bold text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.6)]"
      >
        {data.hero.tagline}
      </p>
    </div>
    <a
      href="#about"
      class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-white text-sm font-bold drop-shadow-lg animate-bounce"
    >
      {t.scroll}
      <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5"
        ><path d="m6 9 6 6 6-6"></path></svg
      >
    </a>
  </section>

  <!-- About stage -->
  <section id="about" data-scroll="pin" data-settle="0.88" class="home-pin relative md:h-[220vh]">
    <div class="md:sticky md:top-0 md:h-screen flex items-center px-4 pt-20 pb-6">
      <div
        class="relative w-full max-w-6xl mx-auto p-6 md:p-10 flex flex-col md:flex-row items-center gap-8 md:gap-12"
      >
        <div class={`home-about-bg absolute inset-0 ${panel}`} aria-hidden="true"></div>
        <img
          src="/images/profile.jpg"
          alt={t.profileAlt}
          class="home-photo shrink-0 w-full md:w-[44%] aspect-[4/3] rounded-3xl object-cover object-[50%_35%] shadow-2xl shadow-black/30"
        />
        <div class="home-about-text flex-1 min-w-0">
          <h2 class="text-4xl md:text-5xl font-black">{data.about.title}</h2>
          <div class="mt-5 space-y-3 text-base leading-relaxed text-ink-700 dark:text-ink-200">
            {data.about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <div
            class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold text-sand-700 dark:text-sand-300"
          >
            <span class="inline-flex items-center gap-1.5">
              <svg
                viewBox="0 0 24 24"
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle
                  cx="12"
                  cy="10"
                  r="2.5"></circle></svg
              >
              {data.about.location}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg
                viewBox="0 0 24 24"
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><circle cx="12" cy="12" r="9"></circle><path
                  d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg
              >
              {t.languages}
            </span>
          </div>
          <div class="home-contact mt-6 flex flex-wrap gap-3">
            <a
              href={`mailto:${data.contact.email}`}
              class="inline-flex items-center gap-2 rounded-full bg-ink-900 text-white dark:bg-sand-100 dark:text-ink-950 px-5 py-2.5 text-sm font-bold hover:bg-sand-700 dark:hover:bg-sand-300 transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"
                ></path></svg
              >
              {t.emailMe}
            </a>
            <a
              href={data.contact.linkedin}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full ring-1 ring-ink-900/15 dark:ring-white/20 px-5 py-2.5 text-sm font-bold hover:bg-sand-200/70 dark:hover:bg-white/10 transition-colors"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"
                ><path d={icons.linkedin}></path></svg
              >
              LinkedIn
            </a>
            <a
              href={data.contact.github}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-full ring-1 ring-ink-900/15 dark:ring-white/20 px-5 py-2.5 text-sm font-bold hover:bg-sand-200/70 dark:hover:bg-white/10 transition-colors"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"
                ><path d={icons.github}></path></svg
              >
              GitHub
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="cv" data-scroll="view" class="relative px-4 py-8">
    <div class={`${panel} relative max-w-6xl mx-auto p-6 md:p-12`}>
      <h2 class="text-4xl md:text-5xl font-black">{data.cv.title}</h2>
      <div class="relative mt-8 pl-8 md:pl-12">
        <svg
          class="absolute left-[7px] md:left-[15px] top-0 h-full w-1 overflow-visible"
          aria-hidden="true"
        >
          <line
            x1="2"
            y1="0"
            x2="2"
            y2="100%"
            class="stroke-sand-200 dark:stroke-ink-800"
            stroke-width="3"></line>
          <line
            x1="2"
            y1="0"
            x2="2"
            y2="100%"
            pathLength="1"
            class="home-line stroke-sand-500"
            stroke-width="3"
            stroke-dasharray="1 1"></line>
        </svg>

        <h3 class="text-sm font-bold text-sand-600 dark:text-sand-400 mb-4">
          {data.cv.experience.title}
        </h3>
        <div class="space-y-5">
          {
            exp.map((job) => (
              <article
                data-reveal="left"
                class="relative rounded-2xl bg-white/80 dark:bg-ink-900/80 ring-1 ring-black/5 dark:ring-white/10 p-5 md:p-7"
              >
                <span
                  class="absolute -left-[30px] md:-left-[38px] top-8 flex h-4 w-4"
                  aria-hidden="true"
                >
                  {job.current && (
                    <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60 animate-ping" />
                  )}
                  <span
                    class={`relative inline-flex h-4 w-4 rounded-full ring-4 ring-sand-50 dark:ring-ink-950 ${job.current ? 'bg-emerald-500' : 'bg-sand-400'}`}
                  />
                </span>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h4 class="text-xl md:text-2xl font-black">
                    {job.role}
                    <span class="font-normal text-ink-500 dark:text-ink-300"> {t.at} </span>
                    {job.url && job.url !== '#' ? (
                      <a
                        href={job.url}
                        target="_blank"
                        rel="noopener"
                        class="text-sand-700 dark:text-sand-300 hover:underline"
                      >
                        {job.company}
                      </a>
                    ) : (
                      <span class="text-sand-700 dark:text-sand-300">{job.company}</span>
                    )}
                  </h4>
                  <span class="text-sm font-bold text-ink-500 dark:text-ink-300">
                    {job.period}
                    {job.current && (
                      <span class="ml-2 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200 px-2 py-0.5 text-xs">
                        {t.current}
                      </span>
                    )}
                  </span>
                </div>
                {job.company === 'Wazuh' && (
                  <div class="mt-4 flex flex-wrap gap-3">
                    <span class="rounded-xl bg-sand-100 dark:bg-ink-800 px-4 py-2">
                      <b class="text-2xl font-black">250B+</b>{' '}
                      <span class="text-sm text-ink-600 dark:text-ink-300">{t.eventsIngested}</span>
                    </span>
                    <span class="rounded-xl bg-sand-100 dark:bg-ink-800 px-4 py-2">
                      <b class="text-2xl font-black">-20%</b>{' '}
                      <span class="text-sm text-ink-600 dark:text-ink-300">{t.cloudCost}</span>
                    </span>
                  </div>
                )}
                <ul class="mt-4 space-y-2 text-ink-700 dark:text-ink-200 leading-relaxed list-disc pl-5 marker:text-sand-400">
                  {job.description.slice(0, 4).map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
                {job.description.length > 4 && (
                  <details class="mt-3 group">
                    <summary class="cursor-pointer text-sm font-bold text-sand-700 dark:text-sand-300 hover:underline">
                      {fill(t.showMore, job.description.length - 4)}
                    </summary>
                    <ul class="mt-2 space-y-2 text-ink-700 dark:text-ink-200 leading-relaxed list-disc pl-5 marker:text-sand-400">
                      {job.description.slice(4).map((d) => (
                        <li>{d}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </article>
            ))
          }
        </div>

        <h3 class="text-sm font-bold text-sand-600 dark:text-sand-400 mt-10 mb-4">
          {data.cv.education.title}
        </h3>
        <div class="grid md:grid-cols-2 gap-5">
          {
            edu.map((e, i) => (
              <article
                data-reveal="left"
                style={`--d:${i * 120}ms`}
                class="relative rounded-2xl bg-white/80 dark:bg-ink-900/80 ring-1 ring-black/5 dark:ring-white/10 p-5 md:p-6"
              >
                {i === 0 && (
                  <span
                    class="absolute -left-[30px] md:-left-[38px] top-7 h-4 w-4 rounded-full bg-sand-400 ring-4 ring-sand-50 dark:ring-ink-950"
                    aria-hidden="true"
                  />
                )}
                <h4 class="text-lg font-black">{e.degree}</h4>
                <p class="mt-1 text-sm font-bold text-sand-700 dark:text-sand-300">
                  {e.institution}
                </p>
                <p class="text-sm text-ink-500 dark:text-ink-300">{e.period}</p>
                <p class="mt-3 text-ink-700 dark:text-ink-200 leading-relaxed">{e.details}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Skills + certifications: logos gather into the table, badges drop in -->
  <section
    id="skills"
    data-scroll="pin"
    data-lead="0.9"
    data-settle="0.65"
    class="home-pin relative md:h-[220vh]"
  >
    <div class="md:sticky md:top-0 md:h-screen flex items-center px-4 pt-20 pb-6">
      <div class={`${panel} w-full max-w-6xl mx-auto p-6 md:p-10`}>
        <h2 class="text-4xl md:text-5xl font-black">{t.stackTitle}</h2>
        <div class="mt-8 max-md:overflow-x-auto max-md:overscroll-x-contain">
          <div
            data-home-field
            class="home-field relative grid gap-[3px] max-md:min-w-[52rem]"
            style="grid-template-columns: 1.1rem repeat(18, minmax(0, 1fr));"
          >
            <div></div>
            {
              Array.from({ length: 18 }, (_, i) => (
                <div class="pb-1 text-center text-[10px] font-bold leading-none text-ink-500 dark:text-sand-400">
                  {i + 1}
                </div>
              ))
            }
            {
              [1, 2, 3, 4].map((row) => (
                <div
                  style={`grid-column: 1; grid-row: ${row + 1}`}
                  class="flex items-center justify-end pr-1 text-[10px] font-bold text-ink-500 dark:text-sand-400"
                >
                  {row}
                </div>
              ))
            }
            {
              skillCells.map((cell) => (
                <span
                  data-home-tile
                  tabindex="0"
                  title={cell.name}
                  class:list={[
                    'home-tile home-cell group relative flex aspect-square w-full select-none flex-col items-center justify-center border border-black/10 outline-none dark:border-white/10',
                    'focus-visible:z-[5] focus-visible:ring-2 focus-visible:ring-ink-950 focus-visible:ring-offset-2 focus-visible:ring-offset-sand-50 dark:focus-visible:ring-sand-100 dark:focus-visible:ring-offset-ink-950',
                    toneClass[cell.group],
                  ]}
                  style={`grid-column: ${cell.col + 1}; grid-row: ${cell.row + 1}`}
                >
                  <span class="absolute left-1 top-0.5 text-[9px] font-bold tabular-nums leading-none opacity-60">
                    {cell.n}
                  </span>
                  <img
                    src={cell.src}
                    alt={cell.name}
                    loading="lazy"
                    class:list={[
                      'home-icon h-7 w-auto max-w-[72%] object-contain',
                      monoIcons.has(cell.name) && 'home-mono',
                    ]}
                  />
                  <span class="home-tip absolute bottom-full left-1/2 z-10 mb-1.5 -translate-x-1/2 whitespace-nowrap rounded-md bg-ink-900 px-2 py-0.5 text-xs font-bold text-white pointer-events-none">
                    {cell.name}
                  </span>
                </span>
              ))
            }
          </div>
        </div>
        <ul class="home-label mt-4 flex flex-wrap gap-x-5 gap-y-2">
          {
            skillGroups.map((g) => (
              <li class="flex items-center gap-2 text-sm font-bold text-ink-700 dark:text-sand-200">
                <span
                  class:list={[
                    'h-3.5 w-3.5 border border-black/10 dark:border-white/10',
                    toneClass[g.id],
                  ]}
                />
                {t.skillGroups[g.id]}
              </li>
            ))
          }
        </ul>

        <div class="mt-8">
          <p class="mb-3 text-sm font-bold text-sand-600 dark:text-sand-400">
            {t.certifications}
          </p>
          <div
            class="rounded-2xl bg-white/80 dark:bg-ink-900/80 ring-1 ring-black/5 dark:ring-white/10 p-5 md:flex md:items-center md:gap-8"
          >
            <div class="grid w-full max-w-3xl grid-cols-2 items-start gap-4 sm:grid-cols-4">
              {
                officialBadges.map((a) => (
                  <a
                    href={a.url}
                    target="_blank"
                    rel="noopener"
                    title={a.title}
                    class="group text-center"
                  >
                    <div data-home-badge class="home-badge-img">
                      <img
