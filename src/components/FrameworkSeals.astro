---
// Neutral framework labels: acronym with the full name beside it.
interface Props {
  items: string[][];
}
const { items } = Astro.props;
---

<ul class="ic-seals">
  {
    items.map(([short, full], i) => (
      <li style={`--j:${i}`}>
        <b>{short}</b>
        <span>{full}</span>
      </li>
    ))
  }
</ul>
