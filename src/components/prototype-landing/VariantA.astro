<script is:inline>
  (function () {
    const root = document.querySelector('[data-variant="A"]');
    if (!root) return;
    const grid = root.querySelector('[data-proj-grid]');
    if (!grid) return;
    const items = Array.from(grid.querySelectorAll('.a-proj'));
    const chips = Array.from(root.querySelectorAll('[data-proj-filters] .a-chip'));

    function layout() {
      if (root.hidden) return;
      items.forEach((item) => {
        if (item.style.display === 'none') return;
        const card = item.querySelector('.a-proj-card');
        const h = card.getBoundingClientRect().height;
        item.style.gridRowEnd = 'span ' + Math.ceil((h + 16) / 8);
      });
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const tag = chip.dataset.filter;
        chips.forEach((c) => c.classList.toggle('a-chip-on', c === chip));
        items.forEach((item) => {
          const show = tag === 'all' || item.dataset.tags.split(',').includes(tag);
          item.style.display = show ? '' : 'none';
        });
        layout();
      });
    });

    grid.querySelectorAll('img').forEach((img) => {
      if (!img.complete) img.addEventListener('load', layout);
    });
    if ('ResizeObserver' in window) new ResizeObserver(layout).observe(grid);
    window.addEventListener('resize', () => {
      if (root.hidden) return;
      layout();
    });
    layout();
  })();
</script>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-variant="A"]');
    if (!root) return;
    const links = Array.from(root.querySelectorAll('.a-navlink'));
    const sections = links.map((l) => root.querySelector('#' + l.dataset.nav)).filter(Boolean);

    function spy() {
      if (root.hidden) return;
      const y = window.scrollY + 120;
      let current = '';
      sections.forEach((s) => {
        if (s.offsetTop <= y) current = s.id;
      });
      links.forEach((l) => l.classList.toggle('a-nav-on', l.dataset.nav === current));
    }

    window.addEventListener('scroll', spy, { passive: true });
    spy();
  })();
</script>
