---
// PROTOTYPE variant A: "Scroll story". An interactive landing page where one small scroll engine drives every effect: a shrinking hero, word-by-word statement, progress tracks and stackable project cards.
import type { Data, Post } from "./data";
import { icons, awardText } from "./data";

interface Props {
  data: Data;
  posts: Post[];
  lang: string;
}

const { data, posts, lang } = Astro.props;

const nameWords = data.hero.name.split(" ");
const statementParagraphs = [data.hero.description, data.about.paragraphs[0]];
const projectTotal = String(data.projects.items.length).padStart(2, "0");
const navLinks: Array<[string, string]> = [
  [data.nav.about, "#a-about"],
  [data.nav.cv, "#a-exp"],
  [data.nav.projects, "#a-projects"],
  [data.nav.thesis, "#a-thesis"],
  [data.nav.blog, "#a-blog"],
];
---

<div class="relative">
  <!-- 0. Reading progress bar + fixed header -->
  <div data-progress class="fixed left-0 top-0 z-50 h-[3px] w-0 bg-sand-500"></div>

  <header
    data-header
    class="a-header fixed inset-x-0 top-[3px] z-40 transition-colors duration-300"
  >
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 px-4 sm:h-16 sm:px-6">
      <a href="#a-top" class="shrink-0 font-mono text-lg font-bold tracking-tight sm:text-xl">
        <span class="text-sand-400">return</span> leon<span class="text-sand-400">;</span>
      </a>
      <nav class="hidden items-center gap-4 text-xs font-black uppercase tracking-widest md:flex lg:gap-6 lg:text-sm" aria-label="Sections">
        {navLinks.map(([label, href]) => (
          <a href={href} class="transition-colors hover:text-sand-400">{label}</a>
        ))}
      </nav>
      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <a
          href="/es/"
          class="rounded-full border border-current px-3 py-1 text-xs font-black uppercase tracking-widest"
        >
          {data.nav.switchLang}
        </a>
        <button
          type="button"
          onclick="toggleTheme()"
          aria-label="Toggle theme"
          class="rounded-full border border-current p-1.5 transition-opacity hover:opacity-70"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4 sm:h-5 sm:w-5"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- 1. Hero: full-bleed image pulls back into a rounded frame as you scroll -->
  <section id="a-top" data-hero data-scroll class="relative h-[250vh]">
    <div class="sticky top-0 h-screen overflow-hidden">
      <div class="a-hero-img absolute overflow-hidden bg-ink-900">
        <img
          src="/images/alhambra.jpg"
          alt="The Alhambra above Granada"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/10 to-black/55"></div>
      </div>

      <div class="relative z-10 flex h-full flex-col items-center justify-center px-5 text-center">
        <p class="text-xs font-black uppercase tracking-[0.35em] text-white/90 sm:text-sm">
          {data.hero.greeting}
        </p>
        <h1 class="a-name mt-3 font-black leading-[0.85] tracking-tight text-[13vw] text-white md:text-[10vw]">
          {nameWords.map((w, i) => (
            <span class="block" style={`--wi:${i}`}>{w}</span>
          ))}
        </h1>
        <p class="mt-4 max-w-2xl text-xs font-bold uppercase tracking-[0.2em] text-white/90 sm:text-sm md:text-base">
          {data.hero.tagline}
        </p>

        <div data-late class="a-hero-late mt-6 flex max-w-2xl flex-col items-center gap-4">
          <p class="text-sm leading-relaxed text-white/90 sm:text-base">{data.hero.description}</p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              href={`mailto:${data.contact.email}`}
              class="rounded-full bg-white px-6 py-3 text-xs font-black uppercase tracking-wider text-ink-950 transition-transform hover:-translate-y-0.5 sm:text-sm"
            >
              Get in touch
            </a>
            <a
              href="#a-projects"
              class="rounded-full border border-white/70 px-6 py-3 text-xs font-black uppercase tracking-wider text-white transition-colors hover:bg-white/15 sm:text-sm"
            >
              See projects
            </a>
          </div>
        </div>
      </div>

      <div class="a-hero-hint absolute bottom-5 left-1/2 z-10 -translate-x-1/2 text-white">
        <span class="block text-[10px] font-black uppercase tracking-[0.3em]">Scroll</span>
        <svg
          class="a-hint-arrow mx-auto mt-1 h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </div>
    </div>
  </section>

  <!-- 2. Statement: words light up one by one with scroll -->
  <section id="a-about" data-statement data-scroll class="relative h-[200vh]">
    <div class="sticky top-0 flex h-screen items-center overflow-hidden">
      <div class="mx-auto grid w-full max-w-6xl gap-8 px-5 sm:px-6 md:grid-cols-[1fr_auto] md:items-center">
        <div class="max-w-5xl">
          {statementParagraphs.map((para, pi) => (
            <p
              class:list={[
                "text-2xl font-light leading-tight text-ink-900 dark:text-sand-100 sm:text-3xl md:text-5xl",
                pi > 0 && "mt-6",
              ]}
            >
              {para.split(" ").map((w) => (
                <span data-word class="a-lit">{w}{" "}</span>
              ))}
            </p>
          ))}
        </div>
        <figure class="relative hidden md:block">
          <img
            src="/images/profile.jpg"
            alt="Leon running a trail race"
            class="h-72 w-56 rounded-3xl object-cover object-top"
          />
          <figcaption
            class="absolute -bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-2 whitespace-nowrap rounded-full border border-sand-200 bg-white px-4 py-2 text-xs font-black uppercase tracking-wider text-ink-800 shadow-lg dark:border-ink-700 dark:bg-ink-900 dark:text-sand-200"
          >
            <span class="h-2 w-2 rounded-full bg-sand-500"></span>
            {data.about.location}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 3. Experience: sticky title with a scroll-driven track -->
  <section id="a-exp" data-scroll class="relative py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 sm:px-6 md:grid-cols-[280px_1fr] md:gap-14">
      <div class="self-start md:sticky md:top-24">
        <h2 class="font-black text-5xl leading-none">{data.cv.title}</h2>
        <div class="mt-6 h-64 w-1 bg-sand-200 dark:bg-ink-800">
          <div class="a-track-fill w-full bg-sand-500"></div>
        </div>
      </div>

      <div>
        <p class="text-xs font-black uppercase tracking-[0.25em] text-sand-600 dark:text-sand-400">
          {data.cv.experience.title}
        </p>
        <div class="mt-4">
          {data.cv.experience.items.map((job) => {
            const visible = job.current ? job.description.slice(0, 4) : job.description;
            const extra = job.current ? job.description.slice(4) : [];
            return (
              <article
                data-reveal
                class="a-reveal border-t border-sand-300 pb-8 pt-6 dark:border-ink-800"
              >
                <div class="flex flex-wrap items-center gap-3">
                  <p class="text-xs font-black uppercase tracking-[0.2em] text-sand-600 dark:text-sand-400">
                    {job.period}
                  </p>
                  {job.current && (
                    <span class="rounded-full bg-sand-500 px-2.5 py-0.5 text-[10px] font-black uppercase tracking-widest text-white">
                      Current
                    </span>
                  )}
                </div>
                <h3 class="mt-3 font-black text-2xl leading-tight md:text-3xl">{job.role}</h3>
                {job.url && job.url !== "#" ? (
                  <a
                    href={job.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-1 inline-block font-bold text-sand-600 underline-offset-4 hover:underline dark:text-sand-400"
                  >
                    {job.company}
                  </a>
                ) : (
                  <p class="mt-1 font-bold text-sand-600 dark:text-sand-400">{job.company}</p>
                )}
                <ul
                  class="mt-4 list-disc space-y-2 break-words pl-5 text-sm leading-relaxed text-ink-700 dark:text-sand-300 md:text-base"
                >
                  {visible.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                {extra.length > 0 && (
                  <details class="mt-4 rounded-2xl border border-sand-200 bg-white/70 p-4 dark:border-ink-800 dark:bg-ink-900/70">
                    <summary class="cursor-pointer select-none text-xs font-black uppercase tracking-[0.2em] text-sand-600 dark:text-sand-400">
                      Show {extra.length} more
                    </summary>
                    <ul class="mt-3 list-disc space-y-2 break-words pl-5 text-sm leading-relaxed text-ink-700 dark:text-sand-300">
                      {extra.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </article>
            );
          })}
        </div>

        <p class="mt-12 text-xs font-black uppercase tracking-[0.25em] text-sand-600 dark:text-sand-400">
          {data.cv.education.title}
        </p>
        <div class="mt-4">
          {data.cv.education.items.map((ed) => (
            <article
              data-reveal
              class="a-reveal border-t border-sand-300 pb-8 pt-6 dark:border-ink-800"
            >
              <p class="text-xs font-black uppercase tracking-[0.2em] text-sand-600 dark:text-sand-400">
                {ed.period}
              </p>
              <h3 class="mt-3 font-black text-2xl leading-tight md:text-3xl">{ed.degree}</h3>
              <p class="mt-1 font-bold text-sand-600 dark:text-sand-400">{ed.institution}</p>
              <p class="mt-4 break-words text-sm leading-relaxed text-ink-700 dark:text-sand-300 md:text-base">
                {ed.details}
              </p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Skills: rows slide in from alternating sides -->
  <section class="relative border-t border-sand-200 py-20 dark:border-ink-800 md:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-ink-900 pb-4 dark:border-sand-100">
        <h2 class="font-black text-5xl leading-none md:text-6xl">{data.cv.skills.title}</h2>
        <p class="text-xs font-black uppercase tracking-[0.25em] text-sand-600 dark:text-sand-400">
          {data.about.location}
        </p>
      </div>
      <div>
        {data.cv.skills.categories.map((cat, i) => (
          <div
            data-reveal
            class={`a-reveal ${i % 2 ? "a-from-right" : "a-from-left"} flex flex-col gap-4 border-b border-sand-200 py-6 dark:border-ink-800 md:flex-row md:items-center md:justify-between md:gap-10`}
          >
            <h3 class="font-black text-2xl md:w-56 md:shrink-0">{cat.name}</h3>
            <div class="flex flex-wrap gap-2">
              {cat.items.map((skill) => (
                <span
                  class="rounded-full border border-sand-300 bg-sand-100 px-3 py-1.5 text-xs font-bold text-ink-700 dark:border-ink-700 dark:bg-ink-900 dark:text-sand-300 sm:text-sm"
                >
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Projects: sticky stacking cards -->
  <section id="a-projects" class="relative py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-ink-900 pb-4 dark:border-sand-100">
        <h2 class="font-black text-5xl leading-none md:text-6xl">{data.projects.title}</h2>
        <p class="text-xs font-black uppercase tracking-[0.25em] text-sand-600 dark:text-sand-400">
          {projectTotal} projects
        </p>
      </div>

      <div class="pt-8 md:pb-[20vh]">
        {data.projects.items.map((project, i) => (
          <article
            data-card
            class="a-pcard relative mb-4 overflow-hidden rounded-3xl border border-sand-200 bg-white shadow-xl shadow-sand-300/40 dark:border-ink-800 dark:bg-ink-900 dark:shadow-black/40 md:sticky md:mb-6"
            style={`top: calc(96px + ${i} * 28px); z-index: ${i + 1};`}
          >
            <div class="grid md:min-h-[70vh] md:grid-cols-[1.2fr_1fr]">
              <div class="relative h-48 overflow-hidden md:h-auto">
                {project.image ? (
                  <img
                    src={project.image}
                    alt={project.name}
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center bg-sand-100 dark:bg-ink-800">
                    <span class="font-black text-8xl text-sand-300">{project.name.charAt(0)}</span>
                  </div>
                )}
              </div>
              <div class="flex flex-col gap-4 p-6 md:p-8">
                <div class="flex items-center justify-between gap-3 text-xs font-black uppercase tracking-[0.2em] text-sand-500">
                  <span>{String(i + 1).padStart(2, "0")} / {projectTotal}</span>
                  <span>{project.period}</span>
                </div>
                <h3 class="font-black text-3xl leading-tight md:text-4xl">{project.name}</h3>
                <p class="break-words text-sm leading-relaxed text-ink-700 dark:text-sand-300 md:text-base">
                  {project.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span
                      class="rounded-full border border-sand-300 bg-sand-100 px-3 py-1 text-xs font-bold text-ink-700 dark:border-ink-700 dark:bg-ink-800 dark:text-sand-300"
                    >
                      {tag}
                    </span>
                  ))}
                </div>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-auto inline-flex items-center gap-2 pt-2 text-sm font-black uppercase tracking-widest text-sand-600 transition-all hover:gap-3 dark:text-sand-400"
                >
                  Open project
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Thesis: dark stage, torus rotates with scroll -->
  <section id="a-thesis" data-scroll class="relative h-[180vh] bg-ink-950 text-sand-100">
    <div class="sticky top-0 flex h-screen items-center overflow-hidden">
      <div class="mx-auto grid w-full max-w-6xl gap-6 px-5 sm:px-6 md:grid-cols-2 md:items-center md:gap-10">
        <div class="flex justify-center">
          <div class="a-thesis-img aspect-square w-56 overflow-hidden rounded-full bg-white shadow-[0_0_80px_rgba(255,255,255,0.15)] sm:w-72 md:w-96">
            <img
              src="/images/hopf_torus.png"
              alt="Hopf fibration torus render"
              class="h-full w-full scale-[1.6] object-cover"
            />
          </div>
        </div>
        <div class="a-thesis-copy">
          <p class="text-xs font-black uppercase tracking-[0.35em] text-sand-400">
            {data.thesis.title}
          </p>
          <h2 class="mt-3 font-black text-4xl leading-none md:text-5xl">Hopf Torus Gallery</h2>
          <p class="mt-4 max-w-xl break-words text-sm leading-relaxed text-sand-300 sm:text-base">
            {data.thesis.description}
          </p>
          <a
            href={`/${lang}/thesis`}
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-sand-400 px-6 py-3 text-xs font-black uppercase tracking-wider text-ink-950 transition-transform hover:-translate-y-0.5 sm:text-sm"
          >
            {data.thesis.cta}
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Certifications and hobbies -->
  <section class="relative py-20 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 sm:px-6 md:grid-cols-2">
      <div>
        <h2 class="font-black text-3xl leading-tight md:text-4xl">{data.cv.awards.title}</h2>
        <ul class="mt-6 space-y-3">
          {data.cv.awards.items.map((item) => {
            const award = awardText(item);
            return (
              <li data-reveal class="a-reveal flex items-start gap-3">
                <svg
                  class="mt-1 h-4 w-4 shrink-0 text-sand-500"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                {award.url ? (
                  <a
                    href={award.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="break-words text-sm text-ink-700 underline-offset-4 hover:text-sand-600 hover:underline dark:text-sand-300 md:text-base"
                  >
                    {award.text}
                  </a>
                ) : (
                  <span class="break-words text-sm text-ink-700 dark:text-sand-300 md:text-base">
                    {award.text}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
      <div>
        <h2 class="font-black text-3xl leading-tight md:text-4xl">{data.hobbies.title}</h2>
        <div class="mt-6 space-y-4">
          {data.hobbies.items.map((hobby) => (
            <div
              data-reveal
              class="a-reveal rounded-2xl border border-sand-200 bg-white/70 p-5 dark:border-ink-800 dark:bg-ink-900/70"
            >
              <h3 class="font-black text-xl">{hobby.title}</h3>
              <p class="mt-1 break-words text-sm leading-relaxed text-ink-700 dark:text-sand-300">
                {hobby.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Blog -->
  <section id="a-blog" class="relative border-t border-sand-200 py-20 dark:border-ink-800 md:py-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-ink-900 pb-4 dark:border-sand-100">
        <h2 class="font-black text-5xl leading-none md:text-6xl">{data.blog.title}</h2>
        <p class="text-xs font-black uppercase tracking-[0.25em] text-sand-600 dark:text-sand-400">
          {posts.length} posts
        </p>
      </div>

      {posts.length > 0 ? (
        <div class="mt-2">
          {posts.map((post) => (
            <a
              href={`/${lang}/blog/${post.slug}/`}
              data-reveal
              class="a-reveal a-post flex items-start gap-4 border-b border-sand-200 py-6 pl-0 dark:border-ink-800 md:gap-8"
            >
              <time class="w-20 shrink-0 pt-1 text-xs font-black uppercase tracking-widest text-sand-500 md:w-28">
                {post.date}
              </time>
              <div class="min-w-0 flex-1">
                <h3 class="font-bold text-xl transition-colors hover:text-sand-600 dark:hover:text-sand-400">
                  {post.title}
                </h3>
                <p class="a-clamp2 mt-1 text-sm text-ink-600 dark:text-sand-400">
                  {post.description}
                </p>
                <div class="mt-2 flex flex-wrap gap-2">
                  {post.tags.map((tag) => (
                    <span
                      class="rounded-full bg-sand-200/80 px-2.5 py-1 text-xs font-bold text-sand-700 dark:bg-ink-800 dark:text-sand-300"
                    >
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <svg
                class="a-arrow mt-1 h-5 w-5 shrink-0 text-sand-500"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-6 text-ink-600 dark:text-sand-400">{data.blog.empty}</p>
      )}
    </div>
  </section>

  <!-- 9. Footer -->
  <footer
    class="relative border-t border-sand-200 px-5 pb-24 pt-16 dark:border-ink-800 sm:px-6"
  >
    <div class="mx-auto max-w-6xl">
      <a
        href={`mailto:${data.contact.email}`}
        class="block font-black leading-[0.9] tracking-tight transition-colors hover:text-sand-600 dark:hover:text-sand-400 text-[9vw]"
      >
        Let's talk.
      </a>
      <p class="mt-4 break-all text-lg font-bold md:text-xl">{data.contact.email}</p>
      <div class="mt-8 flex items-center gap-4">
        <a
          href={data.contact.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="rounded-full border border-sand-300 p-3 text-ink-700 transition-colors hover:border-sand-500 hover:text-sand-600 dark:border-ink-700 dark:text-sand-300 dark:hover:text-sand-400"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d={icons.github}></path>
          </svg>
        </a>
        <a
          href={data.contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="rounded-full border border-sand-300 p-3 text-ink-700 transition-colors hover:border-sand-500 hover:text-sand-600 dark:border-ink-700 dark:text-sand-300 dark:hover:text-sand-400"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d={icons.linkedin}></path>
          </svg>
        </a>
      </div>
      <p class="mt-10 text-sm text-sand-600 dark:text-sand-400">
        &copy; {data.footer.copyright}
      </p>
    </div>
  </footer>
</div>

<style>
  /* Header: white while transparent over the hero, readable ink once it sticks. */
  .a-header {
    color: #ffffff;
  }
  .a-header.is-stuck {
    color: #2d241e;
  }
  :global(.dark) .a-header.is-stuck {
    color: #f2ede6;
  }

  /* Hero stage: image wrapper shrinks, image relaxes from 1.15 to 1. */
  .a-hero-img {
    inset: calc(var(--p, 0) * 10vh) calc(var(--p, 0) * 12vw);
    border-radius: calc(var(--p, 0) * 32px);
  }
  .a-hero-img img {
    transform: scale(calc(1.15 - var(--p, 0) * 0.15));
  }
  .a-name span {
    transform: translateX(calc((1 - var(--p, 0)) * (var(--wi) - 1) * 8vw));
    text-shadow: 0 4px 30px rgb(0 0 0 / calc(0.5 * (1 - var(--p, 0))));
  }
  .a-hero-hint {
    opacity: clamp(0, calc(1 - var(--p, 0) * 3), 1);
  }
  @keyframes a-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }
  .a-hint-arrow {
    animation: a-bob 1.6s ease-in-out infinite;
  }

  /* Hero copy that only appears past p = 0.6 (without JS it just stays visible). */
  :global(.a-js) .a-hero-late {
    opacity: clamp(0, calc((var(--p, 0) - 0.6) * 4), 1);
    pointer-events: none;
  }
  :global(.a-js) .a-hero-late.is-live {
    pointer-events: auto;
  }

  /* clip, not hidden: hidden would break the sticky stages. */
  :global([data-variant='A']) {
    overflow-x: clip;
  }

  /* Statement: words dim until the scroll lights them. */
  :global(.a-js) .a-lit {
    opacity: 0.12;
    transition: opacity 300ms ease;
  }
  :global(.a-js) .a-lit.is-on {
    opacity: 1;
  }

  /* Reveal-on-scroll blocks, gated on JS so the page still reads without it. */
  :global(.a-js) .a-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 600ms ease, transform 600ms ease;
  }
  :global(.a-js) .a-reveal.a-from-left {
    transform: translateX(-40px);
  }
  :global(.a-js) .a-reveal.a-from-right {
    transform: translateX(40px);
  }
  :global(.a-js) .a-reveal.is-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* Experience track fill. */
  .a-track-fill {
    height: calc(var(--p, 0) * 100%);
  }

  /* Thesis: torus rotates with scroll, copy slides in from the side. */
  .a-thesis-img {
    transform: rotate(calc(var(--p, 0) * 120deg)) scale(calc(0.8 + var(--p, 0) * 0.4));
  }
  :global(.a-js) .a-thesis-copy {
    opacity: clamp(0, calc((var(--p, 0) - 0.2) * 3), 1);
    transform: translateX(calc((1 - var(--p, 0)) * 48px));
  }

  /* Blog rows: shift right and show the arrow on hover. */
  .a-post {
    transition: padding-left 200ms ease;
  }
  :global(.a-js) .a-reveal.a-post {
    transition: opacity 600ms ease, transform 600ms ease, padding-left 200ms ease;
  }
  .a-post:hover,
  .a-post:focus-visible {
    padding-left: 8px;
  }
  .a-post .a-arrow {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 200ms ease, transform 200ms ease;
  }
  .a-post:hover .a-arrow,
  .a-post:focus-visible .a-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .a-clamp2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Reduced motion: everything is already static, so drop the transitions too. */
  :global(.a-nomo) .a-reveal,
  :global(.a-nomo) .a-lit,
  :global(.a-nomo) .a-post {
    transition: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.a-js) .a-reveal,
    :global(.a-js) .a-lit,
    .a-post {
      transition: none !important;
    }
    .a-hint-arrow {
      animation: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-variant="A"]');
    if (!root) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scrollEls = Array.prototype.slice.call(root.querySelectorAll('[data-scroll]'));
    const cardEls = Array.prototype.slice.call(root.querySelectorAll('[data-card]'));
    const lateEls = Array.prototype.slice.call(root.querySelectorAll('[data-late]'));
    const wordEls = Array.prototype.slice.call(root.querySelectorAll('[data-word]'));
    const revealEls = Array.prototype.slice.call(root.querySelectorAll('[data-reveal]'));
    const bar = root.querySelector('[data-progress]');
    const header = root.querySelector('[data-header]');
    const heroEl = root.querySelector('[data-hero]');
    const stmtEl = root.querySelector('[data-statement]');

    function clamp01(v) {
      return v < 0 ? 0 : v > 1 ? 1 : v;
    }

    // p runs from 0 to 1 across the element's own scroll range.
    function progressOf(el) {
      const rect = el.getBoundingClientRect();
      let range = rect.height - window.innerHeight;
      if (!(range > 0)) range = rect.height > 0 ? rect.height : 1;
      return clamp01(-rect.top / range);
    }

    function setStuck(on) {
      if (!header) return;
      header.classList.toggle('is-stuck', on);
      header.classList.toggle('backdrop-blur', on);
      header.classList.toggle('bg-sand-50/80', on);
      header.classList.toggle('dark:bg-ink-950/80', on);
    }

    function update() {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      if (bar) bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      if (reduced) return; // no scroll-driven motion in reduced mode
      setStuck(window.scrollY > 40);

      let heroP = 0;
      let stmtP = 0;
      for (let i = 0; i < scrollEls.length; i++) {
        const p = progressOf(scrollEls[i]);
        scrollEls[i].style.setProperty('--p', p.toFixed(4));
        if (scrollEls[i] === heroEl) heroP = p;
        if (scrollEls[i] === stmtEl) stmtP = p;
      }

      // Statement: word k lights up once p * N > k.
      const n = wordEls.length;
      for (let i = 0; i < n; i++) {
        const on = stmtP * n > i;
        if (wordEls[i].classList.contains('is-on') !== on) {
          wordEls[i].classList.toggle('is-on', on);
        }
      }

      const live = heroP > 0.6;
      for (let i = 0; i < lateEls.length; i++) {
        if (lateEls[i].classList.contains('is-live') !== live) {
          lateEls[i].classList.toggle('is-live', live);
        }
      }

      // Stacking cards: dim and shrink each card as the next one rides over it.
      for (let i = 0; i < cardEls.length - 1; i++) {
        const a = cardEls[i].getBoundingClientRect();
        const b = cardEls[i + 1].getBoundingClientRect();
        const cover = clamp01((a.top + a.height - b.top) / (a.height || 1));
        cardEls[i].style.transform = 'scale(' + (1 - 0.05 * cover).toFixed(4) + ')';
        cardEls[i].style.filter = 'brightness(' + (1 - 0.25 * cover).toFixed(4) + ')';
      }
    }

    let queued = false;
    function onViewportChange() {
      const wrap = root.closest('[data-variant]');
      if (wrap && wrap.hidden) return;
      if (queued) return;
      queued = true;
      window.requestAnimationFrame(function () {
        queued = false;
        update();
      });
    }

    if (reduced) {
      // Static state: full progress, every word lit, every block shown.
      for (let i = 0; i < scrollEls.length; i++) scrollEls[i].style.setProperty('--p', '1');
      for (let i = 0; i < wordEls.length; i++) wordEls[i].classList.add('is-on');
      for (let i = 0; i < lateEls.length; i++) lateEls[i].classList.add('is-live');
      for (let i = 0; i < revealEls.length; i++) revealEls[i].classList.add('is-in');
      setStuck(true);
      root.classList.add('a-js', 'a-nomo');
    } else {
      root.classList.add('a-js');
      const io = new IntersectionObserver(
        function (entries) {
          for (let i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) {
              entries[i].target.classList.add('is-in');
              io.unobserve(entries[i].target);
            }
          }
        },
        { threshold: 0.2 }
      );
      for (let i = 0; i < revealEls.length; i++) io.observe(revealEls[i]);
    }

    update();
    window.addEventListener('scroll', onViewportChange, { passive: true });
    window.addEventListener('resize', onViewportChange, { passive: true });
  })();
</script>
