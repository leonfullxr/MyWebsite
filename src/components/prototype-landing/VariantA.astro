---
// PROTOTYPE variant A: "Current, refined". The live site's structure and sand palette, tightened into clear sections with logo skills, a badge shelf and a content-sized project masonry.
import type { Data, Post } from './data';
import {
  skillGroups,
  awardBadges,
  awardText,
  splitAward,
  imageSize,
  tagIcons,
  icons,
} from './data';

interface Props {
  data: Data;
  posts: Post[];
  lang: string;
}

const { data, posts, lang } = Astro.props;
const { hero, about, cv, projects, thesis, hobbies, blog, contact, footer } = data;
const year = new Date().getFullYear();

const navLinks = [
  { href: '#a-about', label: 'About' },
  { href: '#a-exp', label: 'Experience' },
  { href: '#a-certs', label: 'Certifications' },
  { href: '#a-projects', label: 'Projects' },
  { href: '#a-blog', label: 'Blog' },
];

const SHOWN_BULLETS = 4;
const allTags = [...new Set(projects.items.flatMap((p) => p.tags))].sort();

const awards = cv.awards.items.map((item, i) => {
  const { text, url } = awardText(item);
  return { ...splitAward(text), url, badge: awardBadges[i] };
});

const projectCards = projects.items.map((p, i) => {
  const size = p.image ? imageSize[p.image] : undefined;
  const ratio = size ? size.w / size.h : 4 / 3;
  return { ...p, size, featured: i === 0, wide: i === 0 || ratio >= 1.6 };
});

const stats = [
  { value: '250B+', label: 'events through log pipelines' },
  { value: '-20%', label: 'client cloud cost' },
  { value: String(cv.awards.items.length), label: 'certifications and awards' },
  { value: String(projects.items.length), label: 'projects, from games to AI' },
];

const hobbyIcons: Record<string, string> = {
  running: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3ZM7.5 14.5l3-3 2 2 3-3.5 2.5 3M5.5 20l2-5 3 2"/></svg>`,
  nature: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2 22l10-10m0 0l10-10M12 12l4 8m-4-8l-2 8m6-14l-4 6m-4-2l4 6"/></svg>`,
  music: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"/></svg>`,
};

const mailPath =
  'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z';
const sunPath =
  'M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z';
const moonPath = 'M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z';
const arrowPath = 'M7 17L17 7M17 7H7M17 7v10';
---

<div class="a-root">
  <!-- Nav -->
  <nav class="fixed top-0 inset-x-0 z-40 nav-blur">
    <div class="max-w-6xl mx-auto px-4 md:px-6 h-16 flex items-center justify-between gap-4">
      <a href="#a-top" class="text-lg font-bold shrink-0">
        <span class="text-sand-400">return</span> leon<span class="text-sand-400">;</span>
      </a>
      <div class="hidden md:flex items-center gap-1">
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              data-nav={l.href.slice(1)}
              class="a-navlink text-sm px-3 py-1.5 rounded-full text-ink-600 dark:text-sand-300 hover:text-ink-900 dark:hover:text-sand-50 hover:bg-sand-200/60 dark:hover:bg-ink-800 transition-colors"
            >
              {l.label}
            </a>
          ))
        }
      </div>
      <div class="flex items-center gap-2">
        <a
          href="/es/"
          class="text-xs font-bold px-2.5 py-1 rounded-full border border-sand-300 dark:border-ink-700 hover:bg-sand-200 dark:hover:bg-ink-800 transition-colors"
        >
          ES
        </a>
        <button
          onclick="toggleTheme()"
          class="p-2 rounded-full hover:bg-sand-200 dark:hover:bg-ink-800 transition-colors"
          aria-label="Toggle theme"
        >
          <svg class="w-4 h-4 hidden dark:block" fill="currentColor" viewBox="0 0 20 20"
            ><path d={sunPath}></path></svg
          >
          <svg class="w-4 h-4 block dark:hidden" fill="currentColor" viewBox="0 0 20 20"
            ><path d={moonPath}></path></svg
          >
        </button>
        <details class="md:hidden relative a-menu">
          <summary
            class="list-none cursor-pointer p-2 rounded-full hover:bg-sand-200 dark:hover:bg-ink-800"
            aria-label="Menu"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4 6h16M4 12h16M4 18h16"></path></svg
            >
          </summary>
          <div
            class="absolute right-0 top-full mt-2 w-48 rounded-2xl border border-sand-200 dark:border-ink-800 bg-sand-50 dark:bg-ink-900 shadow-lg p-2"
          >
            {
              navLinks.map((l) => (
                <a
                  href={l.href}
                  class="block text-sm px-3 py-2 rounded-xl hover:bg-sand-200/70 dark:hover:bg-ink-800"
                >
                  {l.label}
                </a>
              ))
            }
          </div>
        </details>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <header id="a-top" class="relative w-full h-[62vh] md:h-[62vh] min-h-[480px] overflow-hidden">
    <img
      src="/images/alhambra.jpg"
      alt="The Alhambra in Granada"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-[50%_40%]"
    />
    <div class="a-hero-fade absolute inset-0"></div>
    <div class="relative z-10 h-full flex items-end">
      <div class="max-w-6xl mx-auto px-4 md:px-6 pb-14 md:pb-16 w-full a-hero-text">
        <p class="text-base md:text-lg text-sand-100 mb-1">{hero.greeting}</p>
        <h1 class="font-black italic text-5xl md:text-7xl text-white mb-3 leading-none">
          {hero.name}
        </h1>
        <p class="text-base md:text-lg font-bold text-sand-200 mb-3">{hero.tagline}</p>
        <p class="max-w-2xl text-sand-100 leading-relaxed mb-6">{hero.description}</p>
        <div class="flex flex-wrap gap-3">
          <a
            href="#a-about"
            class="inline-flex items-center gap-2 text-sm font-bold px-5 py-2.5 rounded-full bg-white text-ink-900 hover:bg-sand-100 transition-colors"
          >
            Get to know me
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path></svg
            >
          </a>
          <a
            href={`mailto:${contact.email}`}
            class="inline-flex items-center gap-2 text-sm font-bold px-5 py-2.5 rounded-full border border-white/80 text-white bg-black/20 hover:bg-white hover:text-ink-900 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={mailPath}
              ></path></svg
            >
            Email me
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- About -->
  <section id="a-about" class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 items-start">
        <div>
          <div class="relative">
            <img
              src="/images/profile.jpg"
              alt="Leon Elliott Fuller running under a red arch"
              loading="lazy"
              class="aspect-[4/3] w-full rounded-2xl object-cover object-[50%_35%] border border-sand-200 dark:border-ink-800 shadow-lg shadow-sand-200/60 dark:shadow-black/30"
            />
            <span
              class="absolute left-3 bottom-3 inline-flex items-center gap-1.5 text-sm font-bold px-3 py-1.5 rounded-full bg-white/90 text-ink-800 dark:bg-ink-950/85 dark:text-sand-100 backdrop-blur-sm"
            >
              <svg
                class="w-4 h-4 text-sand-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M12 21s-7-6.2-7-11.5a7 7 0 1114 0C19 14.8 12 21 12 21z"></path><circle
                  cx="12"
                  cy="9.5"
                  r="2.5"
                  stroke-width="1.5"></circle></svg
              >
              {about.location}
            </span>
          </div>
          <div class="grid grid-cols-3 gap-2 mt-3">
            <a
              href={contact.github}
              target="_blank"
              rel="noopener"
              class="a-social"
              aria-label="GitHub"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                ><path d={icons.github}></path></svg
              >
              GitHub
            </a>
            <a
              href={contact.linkedin}
              target="_blank"
              rel="noopener"
              class="a-social"
              aria-label="LinkedIn"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
                ><path d={icons.linkedin}></path></svg
              >
              LinkedIn
            </a>
            <a href={`mailto:${contact.email}`} class="a-social" aria-label="Email">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d={mailPath}></path></svg
              >
              Email
            </a>
          </div>
        </div>

        <div>
          <h2 class="section-heading">{about.title}</h2>
          <div class="space-y-3 text-ink-700 dark:text-sand-200 leading-relaxed">
            {about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <p class="mt-4 inline-flex items-center gap-2 text-sm text-ink-600 dark:text-sand-300">
            <span class="font-bold text-sand-600 dark:text-sand-400">Languages</span>
            English and Spanish, both native
          </p>
        </div>
      </div>

      <div
        class="mt-8 rounded-2xl border border-sand-200 dark:border-ink-800 bg-white/60 dark:bg-ink-900/60 p-4 md:p-6"
      >
        <h3 class="font-bold text-lg mb-4">Tech I work with</h3>
        <div class="flex flex-wrap gap-x-10 gap-y-5">
          {
            skillGroups.map((g) => (
              <div class="min-w-0">
                <p class="text-sm font-bold text-sand-600 dark:text-sand-400 mb-2">{g.name}</p>
                <ul class="flex flex-wrap gap-2">
                  {g.icons.map((ic) => (
                    <li
                      class="group relative h-14 w-14 rounded-xl bg-white dark:bg-sand-50 border border-sand-200 dark:border-ink-700 flex items-center justify-center px-1.5 transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:border-sand-400 focus:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-sand-400"
                      title={ic.name}
                      tabindex="0"
                    >
                      <img
                        src={ic.src}
                        alt={ic.name}
                        loading="lazy"
                        class="h-8 w-auto max-w-full object-contain"
                      />
                      <span class="a-tip" aria-hidden="true">
                        {ic.name}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="a-exp" class="py-12 md:py-16 bg-sand-100/50 dark:bg-ink-900/30">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <h2 class="section-heading">{cv.experience.title}</h2>
      <div class="grid lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-8 items-start">
        <div class="relative border-l border-sand-300 dark:border-ink-700 ml-1.5 space-y-8">
          {
            cv.experience.items.map((job) => {
              const shown = job.description.slice(0, SHOWN_BULLETS);
              const rest = job.description.slice(SHOWN_BULLETS);
              const bullet = (d: string) => (
                <li class="text-ink-600 dark:text-sand-300 leading-relaxed text-sm flex gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-sand-400 mt-2 shrink-0" />
                  <span>{d}</span>
                </li>
              );
              return (
                <div class="pl-7 relative">
                  <div class="timeline-dot" />
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
                    <h3 class="text-lg font-bold flex flex-wrap items-center gap-x-2 gap-y-1">
                      <span>{job.role}</span>
                      <span class="text-ink-300 dark:text-ink-600">at</span>
                      {job.url && job.url !== '#' ? (
                        <a
                          href={job.url}
                          target="_blank"
                          rel="noopener"
                          class="text-sand-600 dark:text-sand-400 hover:underline"
                        >
                          {job.company}
                        </a>
                      ) : (
                        <span class="text-sand-600 dark:text-sand-400">{job.company}</span>
                      )}
                      {job.current && (
                        <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
                          Current
                        </span>
                      )}
                    </h3>
                    <span class="text-sm text-ink-400 dark:text-sand-500 shrink-0">
                      {job.period}
                    </span>
                  </div>
                  <ul class="space-y-2">{shown.map(bullet)}</ul>
                  {rest.length > 0 && (
                    <details class="a-more mt-2">
                      <summary class="cursor-pointer list-none inline-flex items-center gap-1.5 text-sm font-bold text-sand-600 dark:text-sand-400 hover:text-sand-800 dark:hover:text-sand-200">
                        <svg
                          class="a-chev w-3.5 h-3.5 transition-transform"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"
                          />
                        </svg>
                        <span class="a-more-label">Show {rest.length} more</span>
                        <span class="a-less-label">Show less</span>
                      </summary>
                      <ul class="space-y-2 mt-2">{rest.map(bullet)}</ul>
                    </details>
                  )}
                </div>
              );
            })
          }
        </div>

        <aside class="grid grid-cols-2 gap-3 lg:sticky lg:top-24">
          {
            stats.map((s) => (
              <div class="rounded-2xl border border-sand-200 dark:border-ink-800 bg-white/70 dark:bg-ink-900/60 p-4">
                <p class="text-3xl font-black italic text-ink-900 dark:text-sand-50">{s.value}</p>
                <p class="text-sm text-ink-500 dark:text-sand-400 leading-snug mt-1">{s.label}</p>
              </div>
            ))
          }
          <div
            class="col-span-2 rounded-2xl overflow-hidden border border-sand-200 dark:border-ink-800 relative h-36"
          >
            <img
              src="/images/alhambra.jpg"
              alt=""
              loading="lazy"
              class="w-full h-full object-cover object-[50%_60%]"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"
            >
            </div>
            <p class="absolute left-4 bottom-3 right-4 text-white leading-snug">
              <span class="block text-sm text-sand-200">Home base</span>
              <span class="font-bold text-lg">{about.location}</span>
            </p>
          </div>
        </aside>
      </div>

      <h2 class="section-heading mt-12">{cv.education.title}</h2>
      <div class="grid md:grid-cols-2 gap-5">
        {
          cv.education.items.map((edu) => (
            <div class="card !p-5 md:!p-6 flex gap-4">
              <div class="w-11 h-11 shrink-0 rounded-xl bg-sand-100 dark:bg-ink-800 text-sand-600 dark:text-sand-400 flex items-center justify-center">
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 4l9 5-9 5-9-5 9-5zm-6 7.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5M21 9v5"
                  />
                </svg>
              </div>
              <div class="min-w-0">
                <h3 class="font-bold text-lg leading-snug">{edu.degree}</h3>
                <p class="text-sm text-sand-600 dark:text-sand-400 font-bold">{edu.institution}</p>
                <p class="text-sm text-ink-400 dark:text-sand-500 mb-2">{edu.period}</p>
                <p class="text-sm text-ink-600 dark:text-sand-300 leading-relaxed">{edu.details}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section id="a-certs" class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <h2 class="section-heading">{cv.awards.title}</h2>
      <div class="flex flex-wrap justify-center gap-4">
        {
          awards.map((a) => {
            const inner = (
              <Fragment>
                <div class="h-28 w-full flex items-center justify-center mb-3">
                  {a.badge.kind === 'badge' ? (
                    <img
                      src={a.badge.src}
                      alt={a.title}
                      loading="lazy"
                      class="max-h-full w-auto object-contain drop-shadow-md"
                    />
                  ) : (
                    <div class="w-[88px] h-[88px] rounded-full bg-white ring-4 ring-sand-200 dark:ring-ink-700 shadow-md flex items-center justify-center">
                      {a.badge.kind === 'logo' ? (
                        <img
                          src={a.badge.src}
                          alt={a.issuer || a.title}
                          loading="lazy"
                          class="h-11 w-auto max-w-[56px] object-contain"
                        />
                      ) : (
                        <span class="font-black text-2xl text-sand-700">{a.badge.letters}</span>
                      )}
                    </div>
                  )}
                </div>
                <p class="font-bold text-sm leading-snug line-clamp-2">{a.title}</p>
                {a.issuer && (
                  <p class="text-xs text-ink-500 dark:text-sand-400 mt-1 line-clamp-2">
                    {a.issuer}
                  </p>
                )}
                {a.date && <p class="text-xs text-ink-400 dark:text-sand-500 mt-0.5">{a.date}</p>}
                {a.url && (
                  <span class="mt-auto pt-2 inline-flex items-center gap-1 text-xs font-bold text-sand-600 dark:text-sand-400">
                    Verify on Credly
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d={arrowPath}
                      />
                    </svg>
                  </span>
                )}
              </Fragment>
            );
            const cls =
              'card !p-4 flex flex-col items-center text-center hover:-translate-y-1 w-[calc(50%-0.5rem)] sm:w-[calc((100%-2rem)/3)] lg:w-[calc((100%-4rem)/5)]';
            return a.url ? (
              <a href={a.url} target="_blank" rel="noopener" class={cls}>
                {inner}
              </a>
            ) : (
              <div class={cls}>{inner}</div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Thesis -->
  <section class="py-12 md:py-16 bg-sand-100/50 dark:bg-ink-900/30">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <a
        href={`/${lang}/thesis`}
        class="group flex flex-col md:flex-row rounded-2xl overflow-hidden border border-sand-200 dark:border-ink-800 bg-white/70 dark:bg-ink-900/60 hover:border-sand-400 dark:hover:border-ink-600 hover:shadow-lg transition-all duration-300"
      >
        <div
          class="md:w-2/5 bg-white aspect-[1920/721] md:aspect-auto md:min-h-[240px] shrink-0 overflow-hidden"
        >
          <img
            src="/images/hopf_torus.png"
            alt="Hopf torus rendered in the gallery"
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="p-6 md:p-8 flex flex-col justify-center">
          <p class="text-sm font-bold text-sand-600 dark:text-sand-400 mb-1">{thesis.title}</p>
          <h2 class="text-2xl md:text-3xl font-black italic mb-3">Hopf Torus Gallery</h2>
          <p class="text-ink-600 dark:text-sand-300 leading-relaxed mb-5">{thesis.description}</p>
          <span
            class="self-start inline-flex items-center gap-2 text-sm font-bold px-5 py-2.5 rounded-full bg-ink-900 text-sand-50 dark:bg-sand-100 dark:text-ink-900 group-hover:bg-sand-700 dark:group-hover:bg-white transition-colors"
          >
            {thesis.cta}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={arrowPath}
              ></path>
            </svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- Projects -->
  <section id="a-projects" class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <h2 class="section-heading">{projects.title}</h2>
      <div class="flex flex-wrap gap-2 mb-6" data-proj-filters>
