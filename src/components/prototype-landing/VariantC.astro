---
// PROTOTYPE variant C: "Resume sheet". A printed-CV layout: compact profile header card, main column plus sticky side rail, static with hover states and one small filter script.
import type { Data, Post } from './data';
import { awardText, icons } from './data';

interface Props {
  data: Data;
  posts: Post[];
  lang: string;
}

const { data, posts, lang } = Astro.props;
const { hero, about, cv, projects, thesis, hobbies, blog, contact, footer } = data;

const uniqueTags: string[] = [];
projects.items.forEach((p) => {
  p.tags.forEach((t) => {
    if (uniqueTags.indexOf(t) === -1) uniqueTags.push(t);
  });
});
const projectCount = projects.items.length;
const awardCount = cv.awards.items.length;
const awards = cv.awards.items.map((a) => awardText(a));
const mailto = 'mailto:' + contact.email;

const fmtDate = (d: string): string => {
  const t = new Date(d);
  if (isNaN(t.getTime())) return d;
  return t.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
};

const blockCard = 'rounded-2xl border border-sand-200 dark:border-ink-800 bg-white dark:bg-ink-900 px-4 md:px-6 py-6 md:py-8';
const chipBase = 'rounded-full px-3 py-1 text-xs font-bold transition-colors';
const chipOff = 'bg-sand-100 text-ink-600 dark:bg-ink-800 dark:text-sand-300 hover:bg-sand-200 dark:hover:bg-ink-700';
const chipOn = 'bg-ink-900 text-sand-50 dark:bg-sand-300 dark:text-ink-900';
const iconBtn =
  'inline-flex items-center justify-center w-9 h-9 rounded-lg border border-sand-200 dark:border-ink-800 text-ink-600 dark:text-sand-300 hover:border-sand-400 hover:text-sand-600 dark:hover:text-sand-400 transition-colors';
const filledBtn =
  'inline-flex items-center justify-center rounded-lg bg-ink-900 text-sand-50 dark:bg-sand-300 dark:text-ink-900 font-black hover:opacity-90 transition-opacity whitespace-nowrap';
const bulletList = 'list-disc pl-5 space-y-1 text-sm leading-relaxed text-ink-700 dark:text-sand-200 break-words';
---

<header class="sticky top-0 z-40 h-14 backdrop-blur bg-sand-50/85 dark:bg-ink-950/85 border-b border-sand-200 dark:border-ink-800">
  <div class="max-w-6xl mx-auto px-4 md:px-6 h-full flex items-center gap-3 md:gap-6">
    <span class="font-mono text-lg font-bold tracking-tight whitespace-nowrap text-ink-900 dark:text-sand-50">
      <span class="text-sand-400">return</span> leon<span class="text-sand-400">;</span>
    </span>
    <nav class="hidden md:flex items-center gap-5 text-sm font-bold text-ink-600 dark:text-sand-300">
      <a href="#c-about" class="hover:text-sand-600 dark:hover:text-sand-400 transition-colors">{about.title}</a>
      <a href="#c-exp" class="hover:text-sand-600 dark:hover:text-sand-400 transition-colors">{cv.title}</a>
      <a href="#c-projects" class="hover:text-sand-600 dark:hover:text-sand-400 transition-colors">{projects.title}</a>
      <a href="#c-blog" class="hover:text-sand-600 dark:hover:text-sand-400 transition-colors">{blog.title}</a>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <a href="/es/" class="text-xs font-black px-2 py-1 rounded-md border border-sand-200 dark:border-ink-800 text-ink-600 dark:text-sand-300 hover:border-sand-400 hover:text-sand-600 dark:hover:text-sand-400 transition-colors">
        {data.nav.switchLang}
      </a>
      <button
        type="button"
        onclick="toggleTheme()"
        aria-label="Toggle theme"
        class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-sand-200 dark:border-ink-800 text-ink-600 dark:text-sand-300 hover:border-sand-400 hover:text-sand-600 dark:hover:text-sand-400 transition-colors"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <a href={mailto} class={`${filledBtn} text-xs md:text-sm px-3 py-1.5`}>Email me</a>
    </div>
  </div>
</header>

<main class="max-w-6xl mx-auto px-4 md:px-6">
  <!-- Profile card -->
  <section class="mt-6 rounded-3xl overflow-hidden border border-sand-200 dark:border-ink-800 bg-white dark:bg-ink-900">
    <div class="h-40 md:h-52 overflow-hidden bg-sand-200 dark:bg-ink-800">
      <img src="/images/alhambra.jpg" alt="View over Granada" class="w-full h-full object-cover object-[center_40%]" />
    </div>
    <div class="px-4 md:px-8 pb-6 md:pb-8">
      <div class="flex flex-col md:flex-row md:items-start gap-4 md:gap-6">
        <img
          src="/images/profile.jpg"
          alt={hero.name}
          class="w-28 h-28 md:w-36 md:h-36 rounded-2xl ring-4 ring-white dark:ring-ink-900 object-cover object-top -mt-14 md:-mt-20 shrink-0"
        />
        <div class="flex-1 min-w-0">
          <p class="text-xs uppercase tracking-wider font-bold text-sand-600 dark:text-sand-400">{hero.greeting}</p>
          <h1 class="font-black text-3xl md:text-5xl tracking-tight text-ink-900 dark:text-sand-50 break-words">{hero.name}</h1>
          <p class="mt-1 text-xs md:text-sm leading-relaxed text-ink-500 dark:text-sand-400">{hero.tagline}</p>
          <p class="mt-2 flex items-center gap-1.5 text-xs font-bold text-ink-600 dark:text-sand-300">
            <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
            {about.location}
          </p>
        </div>
        <div class="flex items-center gap-2 md:pt-1">
          <a href={contact.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class={iconBtn}>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icons.github}></path></svg>
          </a>
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class={iconBtn}>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icons.linkedin}></path></svg>
          </a>
          <a href={mailto} class={`${filledBtn} text-sm px-4 py-2`}>Contact</a>
        </div>
      </div>

      <p class="mt-5 text-sm md:text-base leading-relaxed text-ink-700 dark:text-sand-200">{hero.description}</p>

      <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="rounded-2xl border border-sand-200 dark:border-ink-800 bg-sand-100/70 dark:bg-ink-800/60 px-4 py-3">
          <p class="font-black text-2xl text-sand-600 dark:text-sand-400">250B+</p>
          <p class="text-xs text-ink-500 dark:text-sand-400">events ingested</p>
        </div>
        <div class="rounded-2xl border border-sand-200 dark:border-ink-800 bg-sand-100/70 dark:bg-ink-800/60 px-4 py-3">
          <p class="font-black text-2xl text-sand-600 dark:text-sand-400">-20%</p>
          <p class="text-xs text-ink-500 dark:text-sand-400">cloud cost</p>
        </div>
        <div class="rounded-2xl border border-sand-200 dark:border-ink-800 bg-sand-100/70 dark:bg-ink-800/60 px-4 py-3">
          <p class="font-black text-2xl text-sand-600 dark:text-sand-400">{awardCount}</p>
          <p class="text-xs text-ink-500 dark:text-sand-400">certifications &amp; awards</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Two-column body -->
  <div class="grid lg:grid-cols-[1fr_340px] gap-6 mt-6 items-start">
    <!-- MAIN -->
    <div class="flex flex-col gap-6 min-w-0">
      <section id="c-about" class={blockCard}>
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-xs font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 whitespace-nowrap">{about.title}</h2>
          <span class="h-px flex-1 bg-sand-200 dark:bg-ink-800" aria-hidden="true"></span>
        </div>
        <div class="space-y-3 text-sm leading-relaxed text-ink-700 dark:text-sand-200">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <section id="c-exp" class={blockCard}>
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-xs font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 whitespace-nowrap">{cv.title}</h2>
          <span class="h-px flex-1 bg-sand-200 dark:bg-ink-800" aria-hidden="true"></span>
        </div>
        <ol class="relative border-l-2 border-sand-200 dark:border-ink-800 space-y-6">
          {
            cv.experience.items.map((job) => (
              <li class="relative pl-5 md:pl-7">
                <span
                  class:list={[
                    'absolute -left-[7px] top-2 w-3 h-3 rounded-full border-2 border-white dark:border-ink-900',
                    job.current ? 'bg-emerald-500' : 'bg-sand-400 dark:bg-sand-500',
                  ]}
                ></span>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="font-bold text-lg text-ink-900 dark:text-sand-50">{job.role}</h3>
                  {job.current && (
                    <span class="text-[10px] uppercase font-black px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-400">
                      Current
                    </span>
                  )}
                  <span class="ml-auto text-xs font-bold text-ink-500 dark:text-sand-400">{job.period}</span>
                </div>
                <a
                  href={job.url}
                  class="inline-block mt-0.5 text-sm font-bold text-sand-600 dark:text-sand-400 hover:text-sand-800 dark:hover:text-sand-200 hover:underline"
                >
                  {job.company}
                </a>
                <ul class:list={['mt-2', bulletList]}>
                  {job.description.slice(0, 4).map((b) => <li>{b}</li>)}
                </ul>
                {job.description.length > 4 && (
                  <details class="mt-2">
                    <summary class="inline-block cursor-pointer list-none select-none text-xs font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 hover:text-sand-800 dark:hover:text-sand-200 [&::-webkit-details-marker]:hidden">
                      Show {job.description.length - 4} more
                    </summary>
                    <ul class:list={['mt-2', bulletList]}>
                      {job.description.slice(4).map((b) => <li>{b}</li>)}
                    </ul>
                  </details>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      <section id="c-projects" class={blockCard}>
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-xs font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 whitespace-nowrap">{projects.title}</h2>
          <span class="h-px flex-1 bg-sand-200 dark:bg-ink-800" aria-hidden="true"></span>
        </div>

        <div class="flex flex-wrap gap-2 mb-4">
          <button type="button" data-c-tag="All" aria-pressed="true" class:list={[chipBase, chipOn]}>All</button>
          {uniqueTags.map((t) => (
            <button type="button" data-c-tag={t} aria-pressed="false" class:list={[chipBase, chipOff]}>
              {t}
            </button>
          ))}
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          {
            projects.items.map((p, i) => (
              <article
                data-c-project
                data-tags={p.tags.join('|')}
                class:list={[
                  'flex flex-col h-full rounded-xl border border-sand-200 dark:border-ink-800 bg-white dark:bg-ink-900 overflow-hidden shadow-sm hover:border-sand-400 dark:hover:border-ink-600 transition-colors',
                  i >= 4 && 'hidden',
                ]}
              >
                {p.image ? (
                  <img
                    src={p.image}
                    alt={p.name}
                    loading="lazy"
                    class="w-full aspect-video object-cover bg-sand-100 dark:bg-ink-800"
                  />
                ) : (
                  <div class="w-full aspect-video flex items-center justify-center bg-sand-100 dark:bg-ink-800 text-4xl font-black text-sand-400 dark:text-sand-500">
                    {p.name.charAt(0)}
                  </div>
                )}
                <div class="p-4 flex flex-col flex-1">
                  <div class="flex items-baseline justify-between gap-2">
                    <h3 class="font-bold text-ink-900 dark:text-sand-50 min-w-0">
                      <a href={p.url} class="hover:text-sand-600 dark:hover:text-sand-400 transition-colors">{p.name}</a>
                    </h3>
                    <span class="text-xs font-black text-sand-600 dark:text-sand-400 shrink-0">{p.period}</span>
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-700 dark:text-sand-200 line-clamp-3">{p.description}</p>
                  <div class="mt-auto pt-3 flex flex-wrap gap-1.5">
                    {p.tags.map((t) => (
                      <span class="text-xs px-2 py-0.5 rounded-md bg-sand-100 dark:bg-ink-800 text-ink-600 dark:text-sand-300">{t}</span>
                    ))}
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <button
          type="button"
          data-c-more
          class="mt-4 w-full rounded-xl border border-sand-300 dark:border-ink-700 bg-sand-100 dark:bg-ink-800 py-2.5 text-sm font-black text-ink-700 dark:text-sand-200 hover:bg-sand-200 dark:hover:bg-ink-700 transition-colors"
        >
          Show all {projectCount} projects
        </button>
      </section>

      <section class={blockCard}>
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-xs font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 whitespace-nowrap">{data.nav.thesis}</h2>
          <span class="h-px flex-1 bg-sand-200 dark:bg-ink-800" aria-hidden="true"></span>
        </div>
        <div class="flex flex-col sm:flex-row gap-4 md:gap-6 items-start">
          <div class="w-40 shrink-0 aspect-square self-center sm:self-start rounded-xl overflow-hidden bg-white border border-sand-200 dark:border-ink-800">
            <img src="/images/hopf_torus.png" alt="Hopf Torus Gallery" class="w-full h-full object-cover scale-150" />
          </div>
          <div class="min-w-0">
            <h3 class="font-black text-xl md:text-2xl tracking-tight text-ink-900 dark:text-sand-50">Hopf Torus Gallery</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700 dark:text-sand-200">{thesis.description}</p>
            <a
              href={`/${lang}/thesis`}
              class="mt-3 inline-flex items-center gap-1.5 text-sm font-black text-sand-600 dark:text-sand-400 hover:text-sand-800 dark:hover:text-sand-200 hover:underline"
            >
              {thesis.cta}
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 6 6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>
      </section>
    </div>

    <!-- SIDE -->
    <aside class="flex flex-col gap-6 lg:sticky lg:top-20">
      <section class="rounded-2xl border border-sand-200 dark:border-ink-800 bg-white dark:bg-ink-900 px-4 py-5">
        <div class="flex items-center gap-3 mb-3">
          <h2 class="text-[11px] font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 whitespace-nowrap">{cv.skills.title}</h2>
          <span class="h-px flex-1 bg-sand-200 dark:bg-ink-800" aria-hidden="true"></span>
        </div>
        <div class="space-y-3">
          {
            cv.skills.categories.map((cat) => (
              <div>
                <p class="text-xs uppercase tracking-wider font-bold text-ink-500 dark:text-sand-400">{cat.name}</p>
                <div class="mt-1.5 flex flex-wrap gap-1.5">
                  {cat.items.map((s) => (
                    <span class="text-xs px-2 py-0.5 rounded-md bg-sand-100 dark:bg-ink-800 text-ink-700 dark:text-sand-200">{s}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="rounded-2xl border border-sand-200 dark:border-ink-800 bg-white dark:bg-ink-900 px-4 py-5">
        <div class="flex items-center gap-3 mb-3">
          <h2 class="text-[11px] font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 whitespace-nowrap">{cv.education.title}</h2>
          <span class="h-px flex-1 bg-sand-200 dark:bg-ink-800" aria-hidden="true"></span>
        </div>
        <div class="space-y-3">
          {
            cv.education.items.map((e) => (
              <div>
                <p class="text-sm font-bold text-ink-900 dark:text-sand-100">{e.degree}</p>
                <p class="text-xs text-ink-500 dark:text-sand-400">{e.institution}</p>
                <p class="text-xs font-black text-sand-600 dark:text-sand-400">{e.period}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="rounded-2xl border border-sand-200 dark:border-ink-800 bg-white dark:bg-ink-900 px-4 py-5">
        <div class="flex items-center gap-3 mb-3">
          <h2 class="text-[11px] font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 whitespace-nowrap">{cv.awards.title}</h2>
          <span class="h-px flex-1 bg-sand-200 dark:bg-ink-800" aria-hidden="true"></span>
        </div>
        <ul class="space-y-2">
          {
            awards.map((a) => (
              <li class="flex gap-2 text-xs leading-relaxed text-ink-700 dark:text-sand-200">
                <svg
                  class="w-3.5 h-3.5 shrink-0 mt-0.5 text-emerald-600 dark:text-emerald-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
                {a.url ? (
                  <a href={a.url} target="_blank" rel="noopener noreferrer" class="hover:text-sand-600 dark:hover:text-sand-400 hover:underline">
                    {a.text}
                  </a>
                ) : (
                  <span>{a.text}</span>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="rounded-2xl border border-sand-200 dark:border-ink-800 bg-white dark:bg-ink-900 px-4 py-5">
        <div class="flex items-center gap-3 mb-3">
          <h2 class="text-[11px] font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 whitespace-nowrap">{hobbies.title}</h2>
          <span class="h-px flex-1 bg-sand-200 dark:bg-ink-800" aria-hidden="true"></span>
        </div>
        <div class="space-y-2">
          {
            hobbies.items.map((h) => (
              <p class="text-xs leading-relaxed text-ink-700 dark:text-sand-200">
                <span class="font-bold text-ink-900 dark:text-sand-100">{h.title}.</span> {h.description}
              </p>
            ))
          }
        </div>
      </section>
    </aside>
  </div>

  <!-- Blog -->
  <section id="c-blog" class:list={[blockCard, 'mt-6']}>
    <div class="flex items-center gap-3 mb-4">
      <h2 class="text-xs font-black uppercase tracking-wider text-sand-600 dark:text-sand-400 whitespace-nowrap">{blog.title}</h2>
      <span class="h-px flex-1 bg-sand-200 dark:bg-ink-800" aria-hidden="true"></span>
    </div>
    {
      posts.length > 0 ? (
        <div class="grid md:grid-cols-3 gap-4">
          {posts.map((post) => (
            <a
              href={`/${lang}/blog/${post.slug}/`}
              class="group flex flex-col h-full rounded-xl border border-sand-200 dark:border-ink-800 bg-white dark:bg-ink-900 overflow-hidden hover:border-sand-400 dark:hover:border-ink-600 transition-colors"
            >
              {post.image ? (
                <img src={post.image} alt={post.title} loading="lazy" class="w-full aspect-[16/10] object-contain bg-white dark:bg-white/95 p-2" />
              ) : (
                <div class="w-full aspect-[16/10] flex items-center justify-center bg-sand-100 dark:bg-ink-800 text-3xl font-black text-sand-400 dark:text-sand-500">
                  {post.title.charAt(0)}
                </div>
              )}
              <div class="p-4 flex flex-col flex-1">
                <p class="text-xs font-black text-sand-600 dark:text-sand-400">{fmtDate(post.date)}</p>
                <p class="mt-1 font-bold text-ink-900 dark:text-sand-100 group-hover:text-sand-600 dark:group-hover:text-sand-400 transition-colors">
                  {post.title}
                </p>
                <p class="mt-1.5 text-xs leading-relaxed text-ink-600 dark:text-sand-300 line-clamp-2">{post.description}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-ink-500 dark:text-sand-400">{blog.empty}</p>
      )
    }
  </section>
</main>

<footer class="mt-6 border-t border-sand-200 dark:border-ink-800">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-6 pb-20 flex items-center justify-between gap-4">
    <p class="text-xs text-ink-500 dark:text-sand-400">&copy; {footer.copyright}</p>
    <div class="flex items-center gap-3">
      <a href={contact.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-ink-500 dark:text-sand-400 hover:text-sand-600 dark:hover:text-sand-400 transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icons.github}></path></svg>
      </a>
      <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-ink-500 dark:text-sand-400 hover:text-sand-600 dark:hover:text-sand-400 transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={icons.linkedin}></path></svg>
      </a>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-variant="C"]');
    if (!root) return;

    const ON = ['bg-ink-900', 'text-sand-50', 'dark:bg-sand-300', 'dark:text-ink-900'];
    const OFF = [
      'bg-sand-100',
      'text-ink-600',
      'dark:bg-ink-800',
      'dark:text-sand-300',
      'hover:bg-sand-200',
      'dark:hover:bg-ink-700',
    ];
    const chips = Array.prototype.slice.call(root.querySelectorAll('[data-c-tag]'));
    const cards = Array.prototype.slice.call(root.querySelectorAll('[data-c-project]'));
    const more = root.querySelector('[data-c-more]');
    if (!chips.length || !cards.length || !more) return;

    let active = 'All';
    let expanded = false;

    function apply() {
      const match = cards.filter(function (card) {
        if (active === 'All') return true;
        const tags = (card.getAttribute('data-tags') || '').split('|');
        return tags.indexOf(active) !== -1;
      });
      const limit = expanded ? match.length : Math.min(4, match.length);
      cards.forEach(function (card) {
        card.classList.add('hidden');
      });
      match.slice(0, limit).forEach(function (card) {
        card.classList.remove('hidden');
      });
      chips.forEach(function (chip) {
        const on = chip.getAttribute('data-c-tag') === active;
        ON.forEach(function (c) {
          chip.classList.toggle(c, on);
        });
        OFF.forEach(function (c) {
          chip.classList.toggle(c, !on);
        });
        chip.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (!expanded && match.length > 4) {
        more.classList.remove('hidden');
        more.textContent = 'Show all ' + match.length + ' projects';
      } else {
        more.classList.add('hidden');
      }
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        active = chip.getAttribute('data-c-tag') || 'All';
        expanded = false;
        apply();
      });
    });
    more.addEventListener('click', function () {
      expanded = true;
      apply();
    });
    apply();
  })();
</script>

