---
// PROTOTYPE variant B: "Scroll journey". The Alhambra photo stays fixed behind the page and the scroll position drives every stage: the photo blurs, the portrait rises, skill logos fly from a scatter into a grid, badges drop in like collected achievements.
import type { Data, Post } from './data';
import {
  skillGroups,
  awardBadges,
  awardText,
  splitAward,
  imageSize,
  tagIcons,
  icons,
} from './data';

interface Props {
  data: Data;
  posts: Post[];
  lang: string;
}
const { data, posts, lang } = Astro.props;

const exp = data.cv.experience.items;
const edu = data.cv.education.items;
const awards = data.cv.awards.items.map((a, i) => {
  const t = awardText(a);
  return { ...splitAward(t.text), url: t.url, badge: awardBadges[i] };
});
const officialBadges = awards.filter((a) => a.badge.kind === 'badge') as (typeof awards[number] & { badge: { kind: 'badge'; src: string } })[];
const otherAwards = awards.filter((a) => a.badge.kind !== 'badge');
// Dark or black logos that need inverting on the dark theme.
const monoIcons = new Set(['Three.js', 'Wazuh', 'AWS', 'OpenSearch', 'Bash']);
const projects = data.projects.items;
const fmtDate = (d: string) => {
  const dt = new Date(d);
  return isNaN(dt.getTime())
    ? d
    : dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
};
const year = new Date().getFullYear();
const nav = [
  ['About', 'b-about'],
  ['Experience', 'b-exp'],
  ['Skills', 'b-stack'],
  ['Projects', 'b-projects'],
  ['Blog', 'b-blog'],
];
const panel = 'rounded-3xl bg-sand-50/90 dark:bg-ink-950/85 backdrop-blur-md shadow-xl shadow-black/10';
const hobbyIcons: string[] = [
  'M3 12h4l3-8 4 16 3-8h4',
  'M2 20 9 8l4 6 3-4 6 10z',
  'M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm12-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0z',
];
---

<div class="b-root relative text-ink-900 dark:text-sand-50">
  <!-- Backdrop -->
  <div class="fixed inset-0 -z-10 overflow-hidden bg-ink-950" aria-hidden="true">
    <img src="/images/alhambra.jpg" alt="" class="b-bg w-full h-full object-cover" />
  </div>

  <!-- Progress bar -->
  <div class="fixed top-0 left-0 z-[60] h-[3px] bg-sand-400 b-progress" aria-hidden="true"></div>

  <!-- Header -->
  <header data-b-header class="b-header fixed top-0 inset-x-0 z-50">
    <div class="max-w-6xl mx-auto px-5 h-16 flex items-center justify-between gap-6">
      <a href="#" class="text-xl font-black"><span class="text-sand-400">return</span> leon<span class="text-sand-400">;</span></a>
      <nav class="flex items-center gap-1 text-sm font-bold">
        {nav.map(([label, id]) => (
          <a href={`#${id}`} class="hidden md:inline-block px-3 py-2 rounded-full hover:bg-white/15 dark:hover:bg-white/10 transition-colors">{label}</a>
        ))}
        <a href="/es/" class="px-3 py-2 rounded-full hover:bg-white/15 transition-colors">ES</a>
        <button onclick="toggleTheme()" class="w-9 h-9 grid place-items-center rounded-full hover:bg-white/15 transition-colors" aria-label="Toggle theme">
          <svg viewBox="0 0 24 24" class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg viewBox="0 0 24 24" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </nav>
    </div>
  </header>

  <!-- Hero -->
  <section class="relative h-screen flex flex-col items-center justify-center text-center px-5">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.32),transparent_65%)] pointer-events-none" aria-hidden="true"></div>
    <div class="relative">
      <p class="text-xl md:text-2xl font-bold text-white/90 drop-shadow-lg">{data.hero.greeting}</p>
      <h1 class="mt-2 font-black text-6xl md:text-8xl text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.45)] leading-[0.95]">{data.hero.name}</h1>
      <p class="mt-6 max-w-2xl mx-auto text-base md:text-lg font-bold text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.6)]">{data.hero.tagline}</p>
    </div>
    <a href="#b-about" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-white text-sm font-bold drop-shadow-lg animate-bounce">
      Scroll
      <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6" /></svg>
    </a>
  </section>

  <!-- About stage -->
  <section id="b-about" data-scroll="pin" class="b-pin relative md:h-[220vh]">
    <div class="md:sticky md:top-0 md:h-screen flex items-center px-4 pt-20 pb-6">
      <div class="relative w-full max-w-6xl mx-auto p-6 md:p-10 flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <div class={`b-about-bg absolute inset-0 ${panel}`} aria-hidden="true"></div>
        <img src="/images/profile.jpg" alt="Leon running under a red arch" class="b-photo shrink-0 w-full md:w-[44%] aspect-[4/3] rounded-3xl object-cover object-[50%_35%] shadow-2xl shadow-black/30" />
        <div class="b-about-text flex-1 min-w-0">
          <h2 class="text-4xl md:text-5xl font-black">{data.about.title}</h2>
          <div class="mt-5 space-y-3 text-base leading-relaxed text-ink-700 dark:text-ink-200">
            {data.about.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold text-sand-700 dark:text-sand-300">
            <span class="inline-flex items-center gap-1.5">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>
              {data.about.location}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
              English and Spanish, both native
            </span>
          </div>
          <div class="b-contact mt-6 flex flex-wrap gap-3">
            <a href={`mailto:${data.contact.email}`} class="inline-flex items-center gap-2 rounded-full bg-ink-900 text-white dark:bg-sand-100 dark:text-ink-950 px-5 py-2.5 text-sm font-bold hover:bg-sand-700 dark:hover:bg-sand-300 transition-colors">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
              Email me
            </a>
            <a href={data.contact.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full ring-1 ring-ink-900/15 dark:ring-white/20 px-5 py-2.5 text-sm font-bold hover:bg-sand-200/70 dark:hover:bg-white/10 transition-colors">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d={icons.linkedin} /></svg>
              LinkedIn
            </a>
            <a href={data.contact.github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full ring-1 ring-ink-900/15 dark:ring-white/20 px-5 py-2.5 text-sm font-bold hover:bg-sand-200/70 dark:hover:bg-white/10 transition-colors">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d={icons.github} /></svg>
              GitHub
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="b-exp" data-scroll="view" class="relative px-4 py-8">
    <div class={`${panel} relative max-w-6xl mx-auto p-6 md:p-12`}>
      <h2 class="text-4xl md:text-5xl font-black">Experience</h2>
      <div class="relative mt-8 pl-8 md:pl-12">
        <svg class="absolute left-[7px] md:left-[15px] top-0 h-full w-1 overflow-visible" aria-hidden="true">
          <line x1="2" y1="0" x2="2" y2="100%" class="stroke-sand-200 dark:stroke-ink-800" stroke-width="3" />
          <line x1="2" y1="0" x2="2" y2="100%" pathLength="1" class="b-line stroke-sand-500" stroke-width="3" stroke-dasharray="1 1" />
        </svg>

        <h3 class="text-sm font-bold text-sand-600 dark:text-sand-400 mb-4">{data.cv.experience.title}</h3>
        <div class="space-y-5">
          {exp.map((job) => (
            <article data-reveal="left" class="relative rounded-2xl bg-white/80 dark:bg-ink-900/80 ring-1 ring-black/5 dark:ring-white/10 p-5 md:p-7">
              <span class="absolute -left-[30px] md:-left-[38px] top-8 flex h-4 w-4" aria-hidden="true">
                {job.current && <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60 animate-ping"></span>}
                <span class={`relative inline-flex h-4 w-4 rounded-full ring-4 ring-sand-50 dark:ring-ink-950 ${job.current ? 'bg-emerald-500' : 'bg-sand-400'}`}></span>
              </span>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h4 class="text-xl md:text-2xl font-black">
                  {job.role}
                  <span class="font-normal text-ink-500 dark:text-ink-300"> at </span>
                  {job.url && job.url !== '#' ? (
                    <a href={job.url} target="_blank" rel="noopener" class="text-sand-700 dark:text-sand-300 hover:underline">{job.company}</a>
                  ) : (
                    <span class="text-sand-700 dark:text-sand-300">{job.company}</span>
                  )}
                </h4>
                <span class="text-sm font-bold text-ink-500 dark:text-ink-300">
                  {job.period}
                  {job.current && <span class="ml-2 rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200 px-2 py-0.5 text-xs">Current</span>}
                </span>
              </div>
              {job.company === 'Wazuh' && (
                <div class="mt-4 flex flex-wrap gap-3">
                  <span class="rounded-xl bg-sand-100 dark:bg-ink-800 px-4 py-2"><b class="text-2xl font-black">250B+</b> <span class="text-sm text-ink-600 dark:text-ink-300">events ingested</span></span>
                  <span class="rounded-xl bg-sand-100 dark:bg-ink-800 px-4 py-2"><b class="text-2xl font-black">-20%</b> <span class="text-sm text-ink-600 dark:text-ink-300">cloud cost</span></span>
                </div>
              )}
              <ul class="mt-4 space-y-2 text-ink-700 dark:text-ink-200 leading-relaxed list-disc pl-5 marker:text-sand-400">
                {job.description.slice(0, 4).map((d) => <li>{d}</li>)}
              </ul>
              {job.description.length > 4 && (
                <details class="mt-3 group">
                  <summary class="cursor-pointer text-sm font-bold text-sand-700 dark:text-sand-300 hover:underline">Show {job.description.length - 4} more</summary>
                  <ul class="mt-2 space-y-2 text-ink-700 dark:text-ink-200 leading-relaxed list-disc pl-5 marker:text-sand-400">
                    {job.description.slice(4).map((d) => <li>{d}</li>)}
                  </ul>
                </details>
              )}
            </article>
          ))}
        </div>

        <h3 class="text-sm font-bold text-sand-600 dark:text-sand-400 mt-10 mb-4">{data.cv.education.title}</h3>
        <div class="grid md:grid-cols-2 gap-5">
          {edu.map((e, i) => (
            <article data-reveal="left" style={`--d:${i * 120}ms`} class="relative rounded-2xl bg-white/80 dark:bg-ink-900/80 ring-1 ring-black/5 dark:ring-white/10 p-5 md:p-6">
              {i === 0 && (
                <span class="absolute -left-[30px] md:-left-[38px] top-7 h-4 w-4 rounded-full bg-sand-400 ring-4 ring-sand-50 dark:ring-ink-950" aria-hidden="true"></span>
              )}
              <h4 class="text-lg font-black">{e.degree}</h4>
              <p class="mt-1 text-sm font-bold text-sand-700 dark:text-sand-300">{e.institution}</p>
              <p class="text-sm text-ink-500 dark:text-ink-300">{e.period}</p>
              <p class="mt-3 text-ink-700 dark:text-ink-200 leading-relaxed">{e.details}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Skills + certifications: icons gather into their groups, badges drop in -->
  <section id="b-stack" data-scroll="pin" class="b-pin relative md:h-[240vh]">
    <div class="md:sticky md:top-0 md:h-screen flex items-center px-4 pt-20 pb-6">
      <div class={`${panel} w-full max-w-6xl mx-auto p-6 md:p-10`}>
        <h2 class="text-4xl md:text-5xl font-black">Skills and certifications</h2>
        <div class="mt-8 grid lg:grid-cols-5 gap-8 lg:gap-10">
          <div data-b-field class="b-field relative lg:col-span-3">
            {skillGroups.map((g) => (
              <div class="mb-7 last:mb-0">
                <p class="b-label mb-3 text-sm font-bold text-sand-600 dark:text-sand-400">{g.name}</p>
                <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
                  {g.icons.map((ic) => (
                    <span data-b-tile tabindex="0" title={ic.name} class="b-tile group relative flex h-10 items-center outline-none">
                      <img
                        src={ic.src}
                        alt={ic.name}
                        loading="lazy"
                        class:list={['b-icon h-9 w-auto max-w-[96px] object-contain', monoIcons.has(ic.name) && 'b-mono']}
                      />
                      <span class="b-tip absolute left-1/2 top-full mt-1.5 -translate-x-1/2 whitespace-nowrap rounded-md bg-ink-900 text-white text-xs font-bold px-2 py-0.5 pointer-events-none">{ic.name}</span>
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div class="lg:col-span-2">
            <p class="mb-3 text-sm font-bold text-sand-600 dark:text-sand-400">
              Certifications <span class="font-normal text-ink-500 dark:text-ink-300">(<span data-b-count>0</span> of {awards.length})</span>
            </p>
            <div class="rounded-2xl bg-white/80 dark:bg-ink-900/80 ring-1 ring-black/5 dark:ring-white/10 p-5">
              <div class="grid grid-cols-3 gap-3 items-start">
                {officialBadges.map((a) => (
                  <a href={a.url} target="_blank" rel="noopener" title={a.title} class="group text-center">
                    <div data-b-badge class="b-badge-img">
                      <img src={a.badge.src} alt={`${a.title} badge`} loading="lazy" class="w-full aspect-square object-contain drop-shadow-md transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-2" />
                    </div>
                    <p class="mt-1 text-xs font-bold leading-tight text-ink-500 dark:text-ink-300">{a.date || a.issuer}</p>
                  </a>
                ))}
              </div>
              <div class="mt-4 pt-4 border-t border-sand-200 dark:border-ink-700 flex flex-wrap gap-2">
                {otherAwards.map((a) => (
                  <span data-b-badge title={[a.issuer, a.date].filter(Boolean).join(', ')} class="b-badge-img inline-flex items-center gap-2 rounded-full bg-sand-100 dark:bg-ink-800 pl-1.5 pr-3 py-1 text-xs font-bold">
                    {a.badge.kind === 'logo' ? (
                      <img src={a.badge.src} alt="" class="w-5 h-5 rounded-full object-contain bg-white p-0.5" />
                    ) : (
                      <span class="w-5 h-5 rounded-full bg-sand-300 dark:bg-sand-600 grid place-items-center text-[9px] font-black text-sand-900">{a.badge.kind === 'monogram' ? a.badge.letters.slice(0, 2) : ''}</span>
                    )}
                    {a.title}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Projects -->
  <section id="b-projects" class="relative px-4 py-8">
    <div class={`${panel} max-w-6xl mx-auto p-6 md:p-12`}>
      <div class="flex flex-wrap items-end justify-between gap-2">
        <h2 class="text-4xl md:text-5xl font-black">{data.projects.title}</h2>
        <p class="text-sm font-bold text-sand-600 dark:text-sand-400">{projects.length} projects, newest first</p>
      </div>
      <div class="mt-10 space-y-14 md:space-y-16">
        {projects.map((p, i) => {
          const img = 'image' in p ? (p.image as string) : undefined;
          const size = img ? imageSize[img] : { w: 16, h: 10 };
          const ratio = size.w / size.h;
          const featured = i === 0;
          // Square and tall images would tower over their text; logos get the smallest cap.
          const capVh = p.name.startsWith('Cypher') ? 30 : ratio < 1.25 ? 46 : 70;
          return (
            <article data-scroll="view" class="b-prow grid md:grid-cols-2 gap-6 md:gap-10 items-center">
              <a href={p.url} target="_blank" rel="noopener" class={`block ${i % 2 ? 'md:order-2' : ''}`} aria-label={p.name}>
                <div class="b-shot relative mx-auto overflow-hidden rounded-3xl bg-white shadow-xl shadow-black/10" style={`aspect-ratio:${size.w}/${size.h};width:min(100%, calc(${capVh}vh * ${ratio.toFixed(4)}))`}>
                  {img ? (
                    <img src={img} alt={p.name} class="w-full h-full object-cover" loading="lazy" />
                  ) : (
                    <div class="w-full h-full relative bg-gradient-to-br from-ink-900 via-ink-800 to-sand-800 grid place-items-center">
                      <svg viewBox="0 0 160 100" class="absolute inset-0 w-full h-full" fill="none" aria-hidden="true">
                        <circle cx="80" cy="50" r="22" class="stroke-white/20" stroke-width="0.5" />
                        <circle cx="80" cy="50" r="34" class="stroke-white/15" stroke-width="0.5" />
                        <circle cx="80" cy="50" r="46" class="stroke-white/10" stroke-width="0.5" />
                        <circle cx="102" cy="50" r="2.5" class="fill-sand-300" />
                        <circle cx="56" cy="27" r="3.5" class="fill-sand-400" />
                        <circle cx="120" cy="78" r="2" class="fill-white/70" />
                      </svg>
                      <span class="relative text-8xl font-black text-sand-200">{p.name[0]}</span>
                    </div>
                  )}
                </div>
              </a>
              <div class="b-ptext">
                {featured && <p class="text-sm font-bold text-sand-600 dark:text-sand-400 mb-2">Featured project</p>}
                <h3 class={`${featured ? 'text-3xl md:text-4xl' : 'text-2xl md:text-3xl'} font-black`}>{p.name}</h3>
                <p class="mt-1 text-sm font-bold text-ink-500 dark:text-ink-300">{p.period}</p>
                <p class={`mt-3 text-ink-700 dark:text-ink-200 leading-relaxed ${featured ? '' : 'line-clamp-3'}`}>{p.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {p.tags.map((t) => <span class="rounded-full bg-sand-100 dark:bg-ink-800 px-3 py-1 text-xs font-bold text-sand-800 dark:text-sand-200">{t}</span>)}
                </div>
                <a href={p.url} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-sand-700 dark:text-sand-300 hover:underline">
                  View project
                  <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17 17 7M8 7h9v9" /></svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Thesis -->
  <section class="relative px-4 py-8">
    <div data-reveal class={`${panel} max-w-6xl mx-auto p-6 md:p-10 grid md:grid-cols-[1.5fr_1fr] gap-6 md:gap-10 items-center`}>
      <div class="rounded-2xl bg-white p-3 shadow-lg shadow-black/10">
        <img src="/images/hopf_torus.png" alt="Hopf torus rendering" class="w-full aspect-[1920/721] object-contain" loading="lazy" />
      </div>
      <div>
        <p class="text-sm font-bold text-sand-600 dark:text-sand-400">{data.thesis.title}</p>
        <h2 class="mt-1 text-3xl md:text-4xl font-black">Hopf Torus Gallery</h2>
        <p class="mt-3 text-ink-700 dark:text-ink-200 leading-relaxed">{data.thesis.description}</p>
        <a href={`/${lang}/thesis`} class="mt-5 inline-flex items-center gap-2 rounded-full bg-ink-900 text-white dark:bg-sand-100 dark:text-ink-950 px-5 py-2.5 text-sm font-bold hover:bg-sand-700 dark:hover:bg-sand-300 transition-colors">
          {data.thesis.cta}
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Blog -->
  <section id="b-blog" class="relative px-4 py-8">
    <div class={`${panel} max-w-6xl mx-auto p-6 md:p-12`}>
      <h2 class="text-4xl md:text-5xl font-black">{data.blog.title}</h2>
      {posts.length === 0 ? (
        <p class="mt-6 text-ink-600 dark:text-ink-300">{data.blog.empty}</p>
      ) : (
        <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {posts.map((post, i) => {
            const logos = post.tags.filter((t) => tagIcons[t]).map((t) => ({ t, src: tagIcons[t] }));
            return (
              <a data-reveal style={`--d:${(i % 3) * 110}ms`} href={`/${lang}/blog/${post.slug}/`} class="group flex flex-col rounded-2xl overflow-hidden bg-white dark:bg-ink-900 ring-1 ring-black/5 dark:ring-white/10 shadow-md hover:shadow-xl hover:-translate-y-1 transition-[box-shadow,translate]">
                <div class="relative aspect-[16/9] overflow-hidden bg-white">
                  {post.image ? (
                    <img src={post.image} alt="" class="w-full h-full object-contain bg-white p-3" loading="lazy" />
                  ) : (
                    <>
                      <img src="/images/alhambra.jpg" alt="" class="absolute inset-0 w-full h-full object-cover blur-sm brightness-50 scale-110" loading="lazy" />
                      <div class="absolute inset-0 flex items-center justify-center gap-3">
                        {logos.map((l) => (
                          <span class="w-14 h-14 p-2.5 rounded-xl bg-white shadow-lg flex items-center justify-center" title={l.t}>
                            <img src={l.src} alt={l.t} class="h-8 w-auto max-w-full object-contain" />
                          </span>
                        ))}
                      </div>
                    </>
                  )}
                </div>
                <div class="p-5 flex-1 flex flex-col">
                  <p class="text-sm font-bold text-sand-600 dark:text-sand-400">{fmtDate(post.date)}</p>
                  <h3 class="mt-1 text-lg font-black leading-snug line-clamp-2 group-hover:text-sand-700 dark:group-hover:text-sand-300">{post.title}</h3>
                  <p class="mt-2 text-sm text-ink-600 dark:text-ink-300 line-clamp-2">{post.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- Hobbies -->
  <section class="relative px-4 py-8">
    <div class={`${panel} max-w-6xl mx-auto p-6 md:p-10`}>
      <h2 class="text-3xl md:text-4xl font-black">{data.hobbies.title}</h2>
      <div class="mt-6 grid md:grid-cols-3 gap-5">
        {data.hobbies.items.map((h, i) => (
          <div data-reveal style={`--d:${i * 110}ms`} class="flex gap-4 rounded-2xl bg-white/80 dark:bg-ink-900/80 ring-1 ring-black/5 dark:ring-white/10 p-5">
            <span class="shrink-0 w-12 h-12 rounded-xl bg-sand-200 dark:bg-ink-800 text-sand-800 dark:text-sand-200 grid place-items-center">
              <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><path d={hobbyIcons[i % hobbyIcons.length]} /></svg>
            </span>
            <div>
              <h3 class="font-black">{h.title}</h3>
              <p class="mt-1 text-sm text-ink-600 dark:text-ink-300 leading-relaxed">{h.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="relative px-4 pt-8 pb-24">
    <div class={`${panel} max-w-6xl mx-auto p-8 md:p-14 text-center`}>
      <p class="text-sm font-bold text-sand-600 dark:text-sand-400">{data.contact.title}</p>
      <a href={`mailto:${data.contact.email}`} class="mt-2 inline-block text-4xl md:text-7xl font-black hover:text-sand-700 dark:hover:text-sand-300 transition-colors">Let's build something.</a>
      <p class="mt-3 text-ink-600 dark:text-ink-300">{data.contact.email}</p>
      <div class="mt-6 flex justify-center gap-3">
        <a href={data.contact.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub" class="w-12 h-12 rounded-full bg-ink-900 text-white dark:bg-sand-100 dark:text-ink-950 grid place-items-center hover:bg-sand-700 transition-colors">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d={icons.github} /></svg>
        </a>
        <a href={data.contact.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn" class="w-12 h-12 rounded-full bg-ink-900 text-white dark:bg-sand-100 dark:text-ink-950 grid place-items-center hover:bg-sand-700 transition-colors">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d={icons.linkedin} /></svg>
        </a>
      </div>
      <p class="mt-8 text-sm text-ink-500 dark:text-ink-400">&copy; {year} {data.footer.copyright}</p>
    </div>
  </footer>
</div>

<style>
  .b-root {
    overflow-x: clip;
  }
  .b-bg {
    filter: blur(calc(var(--page, 0) * 14px)) brightness(calc(1 - var(--page, 0) * 0.45));
    transform: scale(calc(1.05 + var(--page, 0) * 0.1));
  }
  .b-progress {
    width: calc(var(--page, 0) * 100%);
  }

  .b-header {
    color: #fff;
    transition: background-color 0.3s, color 0.3s, box-shadow 0.3s;
  }
  .b-header.is-scrolled {
    color: #1a1a1a;
    background: rgb(250 248 245 / 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.06);
  }
  :global(.dark) .b-header.is-scrolled {
    color: #faf8f5;
    background: rgb(26 26 26 / 0.7);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.06);
  }

  /* About */
  .b-about-bg {
    opacity: clamp(0, var(--p, 0) * 3, 1);
  }
  .b-photo {
    --a: min(var(--p, 0) * 2, 1);
    transform: translateY(calc((1 - var(--a)) * 40vh)) scale(calc(0.85 + var(--a) * 0.15));
  }
  .b-about-text {
    --t: clamp(0, (var(--p, 0) - 0.3) * 2.5, 1);
    opacity: var(--t);
    transform: translateX(calc((1 - var(--t)) * 160px));
  }
  .b-contact {
    --c: clamp(0, (var(--p, 0) - 0.7) * 8, 1);
    opacity: var(--c);
    transform: translateY(calc((1 - var(--c)) * 16px));
  }

  /* Skills: icons look like the live site (grey until hovered), no tiles */
  .b-icon {
    filter: grayscale(1);
    opacity: 0.65;
    transition: filter 0.25s, opacity 0.25s, transform 0.25s;
  }
  .b-tile:hover .b-icon,
  .b-tile:focus-visible .b-icon {
    filter: none;
    opacity: 1;
    transform: translateY(-3px);
  }
  :global(.dark) .b-mono {
    filter: grayscale(1) invert(1);
  }
  :global(.dark) .b-tile:hover .b-mono,
  :global(.dark) .b-tile:focus-visible .b-mono {
    filter: invert(1) hue-rotate(180deg);
  }
  .b-tip {
    opacity: 0;
    transition: opacity 0.15s;
  }
  .b-tile:hover .b-tip,
  .b-tile:focus-visible .b-tip {
    opacity: 1;
  }
  .b-tile:hover,
  .b-tile:focus-visible {
    z-index: 5;
  }
  @media (min-width: 768px) {
    .b-field {
      --q: min(var(--p, 0) / 0.6, 1);
    }
    .b-tile {
      transform: translate(calc(var(--dx, 0px) * (1 - var(--q))), calc(var(--dy, 0px) * (1 - var(--q))))
        rotate(calc(var(--r, 0deg) * (1 - var(--q)))) scale(calc(0.7 + 0.3 * var(--q)));
      will-change: transform;
    }
    .b-label {
      opacity: clamp(0, (var(--p, 0) - 0.45) * 6, 1);
    }
  }
  @media (max-width: 767px) {
    .b-pin {
      --p: 1 !important;
    }
  }

  /* Experience */
  .b-line {
    stroke-dashoffset: calc(1 - var(--p, 0) * var(--p, 0));
  }

  /* Badges */
  .b-hex {
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  }
  .b-badge-img {
    opacity: 0;
    transform: translateY(-48px) scale(1.6);
    transition:
      transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.3s ease;
  }
  .b-badge-img.is-on {
    opacity: 1;
    transform: none;
  }
  .b-ghost {
    transition: opacity 0.4s;
  }
  .is-got .b-ghost {
    opacity: 0;
  }

  /* Projects */
  .b-shot {
    clip-path: inset(calc((1 - var(--p, 0)) * 18%) round 24px);
  }
  .b-shot img {
    transform: scale(calc(1.25 - var(--p, 0) * 0.25));
  }
  .b-ptext {
    opacity: clamp(0, var(--p, 0) * 1.6 - 0.3, 1);
    transform: translateY(calc((1 - var(--p, 0)) * 48px));
  }

  /* Reveal */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: var(--d, 0ms);
  }
  [data-reveal='left'] {
    transform: translateX(-40px);
  }
  [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    .b-badge-img {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-variant="B"]');
    if (!root) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const scrollEls = Array.from(root.querySelectorAll('[data-scroll]'));
    const header = root.querySelector('[data-b-header]');
    const field = root.querySelector('[data-b-field]');
    const badgeSection = root.querySelector('#b-stack');
    const badges = Array.from(root.querySelectorAll('[data-b-badge]'));
    const counter = root.querySelector('[data-b-count]');
    const clamp = (v) => Math.min(1, Math.max(0, v));

    function hash(n) {
      let x = Math.imul(n ^ 0x9e3779b9, 0x85ebca6b);
      x ^= x >>> 13;
      x = Math.imul(x, 0xc2b2ae35);
      x ^= x >>> 16;
      return (x >>> 0) / 4294967296;
    }

    // Icons keep their normal flow position; each one only animates its offset from a scattered start.
    function layoutSkills() {
      if (!field || root.hidden) return;
      const tiles = Array.from(field.querySelectorAll('[data-b-tile]'));
      if (window.innerWidth < 768) {
        tiles.forEach((t) => ['--dx', '--dy', '--r'].forEach((k) => t.style.removeProperty(k)));
        return;
      }
      const W = field.offsetWidth;
      const H = field.offsetHeight;
      const fr = field.getBoundingClientRect();
      tiles.forEach((t, i) => {
        let x = 0, y = 0;
        for (let el = t; el && el !== field; el = el.offsetParent) {
          x += el.offsetLeft;
          y += el.offsetTop;
        }
        if (t.offsetParent !== field && !field.contains(t.offsetParent)) {
          const r = t.getBoundingClientRect();
          x = r.left - fr.left;
          y = r.top - fr.top;
        }
        const sx = hash(i * 3 + 1) * (W - t.offsetWidth);
        const sy = hash(i * 3 + 2) * (H - t.offsetHeight);
        t.style.setProperty('--dx', (sx - x).toFixed(1) + 'px');
        t.style.setProperty('--dy', (sy - y).toFixed(1) + 'px');
        t.style.setProperty('--r', (hash(i * 3 + 3) * 60 - 30).toFixed(1) + 'deg');
      });
    }

    function setBadges(p) {
      let got = 0;
      badges.forEach((b, i) => {
        const on = p > 0.35 + (i / badges.length) * 0.5;
        b.classList.toggle('is-on', on);
        b.parentElement.classList.toggle('is-got', on);
        if (on) got++;
      });
      if (counter) counter.textContent = String(got);
    }

    function update() {
      if (root.hidden) return;
      const ih = window.innerHeight;
      const mobile = window.innerWidth < 768;
      const max = document.documentElement.scrollHeight - ih;
      root.style.setProperty('--page', (max > 0 ? clamp(window.scrollY / max) : 0).toFixed(4));
      if (header) header.classList.toggle('is-scrolled', window.scrollY > 40);
      for (const el of scrollEls) {
        const r = el.getBoundingClientRect();
        const p =
          el.dataset.scroll === 'view' || mobile
            ? clamp((ih - r.top) / (ih / 2 + r.height / 2))
            : clamp(-r.top / (r.height - ih));
        el.style.setProperty('--p', p.toFixed(4));
        if (el === badgeSection) setBadges(p);
      }
    }

    const revealEls = Array.from(root.querySelectorAll('[data-reveal]'));

    if (reduce) {
      root.style.setProperty('--page', '1');
      scrollEls.forEach((el) => el.style.setProperty('--p', '1'));
      revealEls.forEach((el) => el.classList.add('is-in'));
      if (header) header.classList.add('is-scrolled');
      setBadges(1);
      const relayout = () => layoutSkills();
      new MutationObserver(relayout).observe(root, { attributes: true, attributeFilter: ['hidden'] });
      window.addEventListener('load', relayout);
      relayout();
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealEls.forEach((el) => io.observe(el));

    let ticking = false;
    function schedule() {
      if (root.hidden || ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    }
    function refresh() {
      if (root.hidden) return;
      layoutSkills();
      schedule();
    }
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', refresh, { passive: true });
    window.addEventListener('load', refresh);
    new MutationObserver(refresh).observe(root, { attributes: true, attributeFilter: ['hidden'] });
    refresh();
  })();
</script>
